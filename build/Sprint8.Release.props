<Project>
  <PropertyGroup>
    <Product>Edge Retails</Product>
    <AssemblyTitle>Edge Retails</AssemblyTitle>
    <Company>Edge Retails</Company>
    <Description>Edge Retails Electronics Point of Sale</Description>
    <ApplicationIcon Condition="Exists('Assets\EdgeRetails.ico')">Assets\EdgeRetails.ico</ApplicationIcon>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Version)</FileVersion>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Version)</AssemblyVersion>
  </PropertyGroup>
</Project>

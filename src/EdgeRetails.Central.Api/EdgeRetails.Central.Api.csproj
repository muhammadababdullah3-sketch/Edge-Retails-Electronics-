<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Edge Retails Cloud Server (Central)</Product>
    <Description>Hosted control plane: license, activation, admin portal, signing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <Content Include="..\EdgeRetails.Central.Portal\**\*"
             Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EdgeRetails.Central.Domain\EdgeRetails.Central.Domain.csproj" />
    <ProjectReference Include="..\EdgeRetails.Central.Application\EdgeRetails.Central.Application.csproj" />
    <ProjectReference Include="..\EdgeRetails.Central.Infrastructure\EdgeRetails.Central.Infrastructure.csproj" />
    <ProjectReference Include="..\EdgeRetails.ProtectedSigner\EdgeRetails.ProtectedSigner.csproj" />
  </ItemGroup>

</Project>

            <DataTemplate DataType="{x:Type viewModels:ExpenseEditViewModel}">
                <dialogs:ExpenseEditDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:CustomerEditViewModel}">
                <dialogs:CustomerEditDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SupplierEditViewModel}">
                <dialogs:SupplierEditDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PurchaseDetailViewModel}">
                <views:PurchaseDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PurchaseReturnViewModel}">
                <dialogs:PurchaseReturnDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ExactUnitPickerViewModel}">

<Application
    x:Class="EdgeRetails.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:EdgeRetails.Desktop.Converters"
    xmlns:views="clr-namespace:EdgeRetails.Desktop.Views"
    xmlns:dialogs="clr-namespace:EdgeRetails.Desktop.Views.Dialogs"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Brushes.xaml" />
                <ResourceDictionary Source="Resources/Gradients.xaml" />
                <ResourceDictionary Source="Resources/Spacing.xaml" />
                <ResourceDictionary Source="Resources/Radii.xaml" />
                <ResourceDictionary Source="Resources/Shadows.xaml" />
                <ResourceDictionary Source="Resources/Typography.xaml" />
                <ResourceDictionary Source="Resources/NavigationIcons.xaml" />
                <ResourceDictionary Source="Resources/Themes/Light.xaml" />
                <ResourceDictionary Source="Resources/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Inputs.xaml" />
                <ResourceDictionary Source="Resources/Tables.xaml" />
                <ResourceDictionary Source="Resources/Cards.xaml" />
                <ResourceDictionary Source="Resources/Tabs.xaml" />
                <ResourceDictionary Source="Resources/Badges.xaml" />
                <ResourceDictionary Source="Resources/Tooltips.xaml" />
                <ResourceDictionary Source="Resources/ScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

            <DataTemplate DataType="{x:Type viewModels:FirstSetupViewModel}">
                <views:FirstSetupView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ShellViewModel}">
                <views:ShellView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PosViewModel}">
                <views:PosView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SalesHistoryViewModel}">
                <views:SalesHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SaleDetailViewModel}">
                <views:SaleDetailView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ThakaProjectsViewModel}">
                <views:ThakaProjectsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ThakaWorkspaceViewModel}">
                <views:ThakaWorkspaceView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PurchaseHistoryViewModel}">
                <views:PurchaseHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:NewPurchaseViewModel}">
                <views:NewPurchaseView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ProductManagementViewModel}">
                <views:ProductManagementView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:InventoryViewModel}">
                <views:InventoryView />

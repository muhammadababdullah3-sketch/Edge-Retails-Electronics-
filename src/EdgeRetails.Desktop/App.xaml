            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:CatalogReferenceManagerViewModel}">
                <dialogs:CatalogReferenceManagerDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SettingsEditorViewModel}">
                <dialogs:SettingsEditorDialog />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SettingsConfirmViewModel}">
                <dialogs:SettingsConfirmDialog />

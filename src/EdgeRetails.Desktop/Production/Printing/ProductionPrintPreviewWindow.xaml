<Window x:Class="EdgeRetails.Desktop.Production.Printing.ProductionPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Width="980"
        Height="760"
        MinWidth="800"
        MinHeight="600"
        Background="{DynamicResource Brush.App.Background}"
        FontFamily="{StaticResource Font.Primary}"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="16"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                Effect="{StaticResource Shadow.Card}">
            <DocumentViewer x:Name="PreviewViewer" />
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="110"
                        Margin="0,0,10,0"
                        IsCancel="True"
                        Content="Cancel"
                        Style="{StaticResource Button.Neutral}" />
                <Button Width="110"
                        IsDefault="True"
                        Click="Print_Click"
                        Content="Print"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

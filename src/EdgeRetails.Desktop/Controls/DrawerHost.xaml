<UserControl
    x:Class="EdgeRetails.Desktop.Controls.DrawerHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
    Focusable="False">
    <Grid>
        <Border Background="{DynamicResource Brush.Overlay.Scrim}" />
        <Border Width="{StaticResource Dimension.Drawer.Width}"
                HorizontalAlignment="Right"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1,0,0,0"
                Effect="{StaticResource Shadow.Card}">
            <ContentControl Content="{Binding Content}" />
        </Border>
    </Grid>
</UserControl>

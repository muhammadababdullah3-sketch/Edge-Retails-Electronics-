<UserControl
    x:Class="EdgeRetails.Desktop.Controls.AppTopBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="{StaticResource Dimension.TopBar.Height}"
    Focusable="False">
    <Border Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="0,0,0,1"
            Effect="{StaticResource Shadow.TopBar}">
        <Grid Margin="{StaticResource Padding.TopBar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10.5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    FocusVisualStyle="{x:Null}"
                    ToolTip="Collapse or expand sidebar"
                    AutomationProperties.Name="Toggle sidebar"
                    Command="{Binding ToggleSidebarCommand}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Compact}">
                            <Path Width="16"
                                  Height="16"
                                  Data="M 1 3 L 15 3 M 1 8 L 15 8 M 1 13 L 15 13"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource Brush.Text.Secondary}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock Grid.Column="2"
                       Text="{Binding PageTitle}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding DateText}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
                <TextBlock Margin="7,0"
                           Text="&#183;"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Divider}" />
                <TextBlock Text="{Binding TimeText}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
            </StackPanel>

            <Border Grid.Column="5"
                    Padding="10.5,0,0,0"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1,0,0,0">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="28"
                            Height="28"
                            Background="{StaticResource Gradient.Brand.Primary}"
                            CornerRadius="{StaticResource Radius.Circle}"
                            Effect="{StaticResource Shadow.BrandIcon}">
                        <TextBlock Text="{Binding UserInitials}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.White}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="7,0,0,0"
                                MinWidth="62"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding UserRole}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Subtle}" />
                    </StackPanel>

                    <Ellipse Width="5.25"
                             Height="5.25"
                             Margin="3.5,0,0,0"
                             Fill="{StaticResource Brush.Function.Success}"
                             Visibility="{Binding IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

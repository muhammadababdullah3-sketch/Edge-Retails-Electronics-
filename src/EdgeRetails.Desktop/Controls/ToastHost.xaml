<UserControl
    x:Class="EdgeRetails.Desktop.Controls.ToastHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="clr-namespace:EdgeRetails.Desktop.Services"
    IsHitTestVisible="False"
    Focusable="False">
    <ItemsControl Margin="0,70,21,0"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  ItemsSource="{Binding Messages}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Margin" Value="0,0,0,7" />
            </Style>
        </ItemsControl.ItemContainerStyle>

        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type services:ToastMessage}">
                <Border MaxWidth="360"
                        Padding="14,10.5"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Control}"
                        Effect="{StaticResource Shadow.Card}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static services:ToastTone.Success}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Success.Background}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Success.Border}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static services:ToastTone.Info}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Info.Background}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Info.Border}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static services:ToastTone.Warning}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Background}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Warning.Border}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static services:ToastTone.Danger}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Message}"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

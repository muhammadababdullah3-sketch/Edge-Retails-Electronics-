<UserControl
    x:Class="EdgeRetails.Desktop.Controls.EmptyState"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">
    <StackPanel MaxWidth="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
        <Border Width="42"
                Height="42"
                Margin="0,0,0,14"
                Background="{DynamicResource Brush.Surface.Subtle}"
                CornerRadius="{StaticResource Radius.IconWell}"
                HorizontalAlignment="Center">
            <Path Width="18"
                  Height="18"
                  Data="{Binding IconGeometry, ElementName=Root}"
                  Fill="Transparent"
                  Stroke="{DynamicResource Brush.Text.Muted}"
                  StrokeThickness="1.5"
                  Stretch="Uniform" />
        </Border>

        <TextBlock Text="{Binding Title, ElementName=Root}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text.Primary}"
                   TextAlignment="Center" />
        <TextBlock Margin="0,5.25,0,0"
                   Text="{Binding Message, ElementName=Root}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
    </StackPanel>
</UserControl>

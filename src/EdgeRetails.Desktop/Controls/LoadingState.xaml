<UserControl
    x:Class="EdgeRetails.Desktop.Controls.LoadingState"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Width="112"
                     Height="3"
                     IsIndeterminate="True"
                     Foreground="{StaticResource Brush.Brand.Primary}"
                     Background="{DynamicResource Brush.Border.Default}" />
        <TextBlock Margin="0,10.5,0,0"
                   Text="{Binding Message, ElementName=Root}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontSize="13"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>

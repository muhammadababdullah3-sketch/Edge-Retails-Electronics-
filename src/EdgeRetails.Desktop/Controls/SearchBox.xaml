<UserControl
    x:Class="EdgeRetails.Desktop.Controls.SearchBox"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="180"
    Focusable="False">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Height" Value="44" />
        </Style>
    </UserControl.Style>
    <Border BorderThickness="1"
            CornerRadius="{StaticResource Radius.Control}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=Input}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="10.5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Width="18"
                  Height="18"
                  Data="{StaticResource Icon.Search}"
                  Fill="Transparent"
                  Stroke="{DynamicResource Brush.Text.Muted}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Stretch="None"
                  VerticalAlignment="Center" />

            <Grid Grid.Column="2">
                <TextBox x:Name="Input"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         BorderThickness="0"
                         FontFamily="{StaticResource Font.Primary}"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         CaretBrush="{StaticResource Brush.Brand.Primary}"
                         IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                         FocusVisualStyle="{x:Null}" />

                <TextBlock IsHitTestVisible="False"
                           Text="{Binding Placeholder, ElementName=Root}"
                           Foreground="{DynamicResource Brush.Text.Subtle}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="14"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Button.Base" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.Standard}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="{StaticResource Padding.Control.Standard}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Standard brand CTA: 35px, radius 8, visible directional gradient and restrained elevation. -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource Gradient.Brand.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource Gradient.Brand.Pressed}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Standard neutral control: white layer + 1px border + faint lift. -->
    <Style x:Key="Button.Neutral" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Neutral}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" /></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact semantic action family, 31.5px in current Figma. -->
    <Style x:Key="Button.Info.Compact" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.CompactAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Info}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Info}" />
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Info.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Info.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <Style x:Key="Button.Payment.Compact" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.CompactAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Payment}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Payment}" />
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Payment.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Payment.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <Style x:Key="Button.Warning.Compact" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.CompactAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Warning}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Warning}" />
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Warning.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Warning.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <!-- Standard 35px expense CTA with the shared semantic orange gradient. -->
    <Style x:Key="Button.Expense" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Expense}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.Expense}" />
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Expense.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Expense.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <!-- Large financial/transaction actions use their own geometry and elevation. -->
    <Style x:Key="Button.Success.PrimaryAction" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.PrimaryAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.SuccessStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.PrimaryAction}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.White}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Success.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Success.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <Style x:Key="Button.Info.PrimaryAction" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="{StaticResource Dimension.Button.PrimaryPurchaseAction}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
        <Setter Property="Background" Value="{StaticResource Gradient.Info}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Button.InfoStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.PrimaryAction}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.White}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
            <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Info.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Gradient.Info.Pressed}" />
            </Trigger>
        </Style.Triggers>    </Style>

    <!-- Text actions seen in Settings/Inventory: no container texture, just semantic text. -->
    <Style x:Key="Button.Text.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Height" Value="20" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Button.Text.Neutral" TargetType="Button" BasedOn="{StaticResource Button.Text.Primary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    </Style>
</ResourceDictionary>

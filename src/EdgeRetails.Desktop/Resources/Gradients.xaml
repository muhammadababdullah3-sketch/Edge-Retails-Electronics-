    <!-- Strong semantic gradients. These are intentionally visible, but kept restrained enough for a desktop POS. -->
    <LinearGradientBrush x:Key="Gradient.Brand.Primary" StartPoint="0,0" EndPoint="1,0.85">
        <GradientStop Offset="0" Color="#8C7BFF" />
        <GradientStop Offset="0.52" Color="#6C5CFF" />
        <GradientStop Offset="1" Color="#5142DE" />

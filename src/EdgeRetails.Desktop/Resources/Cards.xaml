<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- All standalone surfaces start rounded; dividers and full-window scrims opt out explicitly. -->
    <Style x:Key="Surface.Box" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
    </Style>
    <Style TargetType="Border" BasedOn="{StaticResource Surface.Box}" />

    <Style x:Key="Card.Base" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card.Standard}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 1. Default standard card container (alias of Card.Base) -->
    <Style x:Key="Card.Default" TargetType="Border" BasedOn="{StaticResource Card.Base}" />

    <!-- 2. CARD.ELEVATED: Raised Analytical & Action Surface -->
    <Style x:Key="Card.Elevated" TargetType="Border" BasedOn="{StaticResource Card.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Soft}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
    </Style>

    <Style x:Key="Card.Raised" TargetType="Border" BasedOn="{StaticResource Card.Elevated}" />

    <!-- 3. CARD.STAT: KPI Card Surface -->
    <Style x:Key="Card.Stat" TargetType="Border" BasedOn="{StaticResource Card.Base}">
        <Setter Property="Background" Value="{DynamicResource Gradient.Surface.Card}" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Surface}" />
    </Style>

    <Style x:Key="Card.Textured" TargetType="Border" BasedOn="{StaticResource Card.Stat}" />

    <!-- 4. CARD.INTERACTIVE: Clickable Selection Target -->
    <Style x:Key="Card.Interactive" TargetType="Border" BasedOn="{StaticResource Card.Base}">
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Hover}" />
                <Setter Property="Effect" Value="{StaticResource Shadow.Surface}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 5. CARD.SELECTED: Active Operational Focus -->
    <Style x:Key="Card.Selected" TargetType="Border" BasedOn="{StaticResource Card.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection.Border}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
</ResourceDictionary>

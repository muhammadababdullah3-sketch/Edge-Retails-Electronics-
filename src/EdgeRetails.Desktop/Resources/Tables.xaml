<ResourceDictionary

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls">



    <Style x:Key="Table.ColumnHeader" TargetType="DataGridColumnHeader">

        <Setter Property="Height" Value="{StaticResource Dimension.Table.Header}" />

        <Setter Property="Padding" Value="14,0" />

        <Setter Property="Background" Value="{DynamicResource Brush.Table.Header}" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />

        <Setter Property="BorderThickness" Value="0,0,0,1" />

        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />

        <Setter Property="FontSize" Value="12" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

    </Style>



    <Style x:Key="Table.Row" TargetType="DataGridRow">

        <Setter Property="Height" Value="{StaticResource Dimension.Table.Row}" />

        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />

        <Setter Property="BorderThickness" Value="0,0,0,1" />

        <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />

        <Setter Property="FontSize" Value="13.5" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">

                <Setter Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />

            </Trigger>

            <Trigger Property="IsSelected" Value="True">

                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />

                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

            </Trigger>

            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Selection.Border}" />

            </Trigger>

        </Style.Triggers>

    </Style>



    <Style x:Key="Table.TextCell" TargetType="TextBlock">

        <Setter Property="VerticalAlignment" Value="Center" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

        <Setter Property="TextTrimming" Value="CharacterEllipsis" />

    </Style>

    <Style x:Key="Table.Cell" TargetType="DataGridCell">

        <Setter Property="Padding" Value="14,0" />

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

        <Setter Property="BorderBrush" Value="Transparent" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="DataGridCell">

                    <Grid Background="{TemplateBinding Background}">

                        <Border x:Name="CellFocusIndicator"

                                BorderBrush="Transparent"

                                BorderThickness="1.5"

                                CornerRadius="4"

                                Margin="2"

                                IsHitTestVisible="False"

                                SnapsToDevicePixels="True" />

                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">

                            <Setter TargetName="CellFocusIndicator" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}" />

                            <Setter TargetName="CellFocusIndicator" Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />

                        </Trigger>

                        <Trigger Property="IsSelected" Value="True">

                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>



    <Style x:Key="Table.DataGrid" TargetType="DataGrid">
        <Setter Property="controls:RoundedViewport.Radius" Value="8" />

        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="GridLinesVisibility" Value="None" />

        <Setter Property="HeadersVisibility" Value="Column" />

        <Setter Property="AutoGenerateColumns" Value="False" />

        <Setter Property="CanUserAddRows" Value="False" />

        <Setter Property="CanUserDeleteRows" Value="False" />

        <Setter Property="CanUserResizeRows" Value="False" />

        <Setter Property="CanUserReorderColumns" Value="False" />

        <Setter Property="SelectionMode" Value="Single" />

        <Setter Property="SelectionUnit" Value="FullRow" />

        <Setter Property="RowHeaderWidth" Value="0" />

        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Table.ColumnHeader}" />

        <Setter Property="RowStyle" Value="{StaticResource Table.Row}" />

        <Setter Property="CellStyle" Value="{StaticResource Table.Cell}" />

        <Setter Property="EnableRowVirtualization" Value="True" />

        <Setter Property="EnableColumnVirtualization" Value="True" />

        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />

        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />

        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />

        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />

        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

    </Style>



    <!-- Numeric Table Styles -->

    <Style x:Key="Table.ColumnHeader.Numeric" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Table.ColumnHeader}">

        <Setter Property="HorizontalContentAlignment" Value="Right" />

    </Style>



    <Style x:Key="Table.Cell.Numeric" TargetType="DataGridCell" BasedOn="{StaticResource Table.Cell}">

        <Setter Property="HorizontalContentAlignment" Value="Right" />

    </Style>



    <Style x:Key="Table.TextCell.Numeric" TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">

        <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />

        <Setter Property="HorizontalAlignment" Value="Right" />

        <Setter Property="TextAlignment" Value="Right" />

    </Style>



    <Style x:Key="Table.TextCell.Numeric.Bold" TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell.Numeric}">

        <Setter Property="FontWeight" Value="Bold" />

    </Style>



    <!-- Implicit DataGrid Styles -->

    <Style TargetType="DataGrid" BasedOn="{StaticResource Table.DataGrid}" />

    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Table.ColumnHeader}" />

    <Style TargetType="DataGridRow" BasedOn="{StaticResource Table.Row}" />

    <Style TargetType="DataGridCell" BasedOn="{StaticResource Table.Cell}" />

</ResourceDictionary>


<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Brand.Primary" Color="{StaticResource Color.Brand.Primary}" />
    <SolidColorBrush x:Key="Brush.Brand.Hover" Color="{StaticResource Color.Brand.Hover}" />
    <SolidColorBrush x:Key="Brush.Brand.Pressed" Color="{StaticResource Color.Brand.Pressed}" />
    <SolidColorBrush x:Key="Brush.Brand.Tint" Color="{StaticResource Color.Brand.Tint}" />
    <SolidColorBrush x:Key="Brush.Thaka" Color="{StaticResource Color.Thaka}" />

    <SolidColorBrush x:Key="Brush.Function.Success" Color="{StaticResource Color.Success.End}" />
    <SolidColorBrush x:Key="Brush.Function.Info" Color="{StaticResource Color.Info.End}" />
    <SolidColorBrush x:Key="Brush.Function.Payment" Color="{StaticResource Color.Payment.End}" />
    <SolidColorBrush x:Key="Brush.Function.Warning" Color="{StaticResource Color.Warning.End}" />
    <SolidColorBrush x:Key="Brush.Function.Expense" Color="{StaticResource Color.Expense.End}" />
    <SolidColorBrush x:Key="Brush.Function.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Status.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />
</ResourceDictionary>

<Window
    x:Class="EdgeRetails.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:EdgeRetails.Desktop.Views"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    Title="Edge Retails"
    Icon="Assets/EdgeAppIcon.png"
    Width="1440"
    Height="900"
    MinWidth="1024"
    MinHeight="640"
    Background="{DynamicResource Brush.App.Background}"
    WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Print"
                        Executed="PrintCommand_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="B"
                    Modifiers="Control"
                    Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="P"
                    Modifiers="Control"
                    Command="ApplicationCommands.Print" />
    </Window.InputBindings>
    <Grid>
        <ContentControl Content="{Binding CurrentContent}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Focusable="False" />
        <controls:ToastHost Panel.ZIndex="100"
                            DataContext="{Binding ToastService}" />
    </Grid>
</Window>

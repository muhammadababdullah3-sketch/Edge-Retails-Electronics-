<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EdgeRetails.Application\EdgeRetails.Application.csproj" />
    <ProjectReference Include="..\EdgeRetails.Infrastructure\EdgeRetails.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\EdgeRetails.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\EdgeLogo.png" />
    <Resource Include="Assets\EdgeAppIcon.png" />
    <Resource Include="Assets\EdgeRetails.ico" />
  </ItemGroup>

</Project>

<UserControl x:Class="EdgeRetails.Desktop.Views.SupplierDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface.Raised}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Padding="21,14" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Supplier information" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
                <Button Content="✕" Command="{Binding CloseCommand}" Style="{StaticResource Button.Text.Neutral}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Padding="21,16">
            <StackPanel>
                <Grid Margin="0,0,0,12"><TextBlock Text="Phone" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Supplier.Phone}" Margin="140,0,0,0" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,0,0,12"><TextBlock Text="City" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Supplier.City}" Margin="140,0,0,0" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,0,0,12"><TextBlock Text="Address" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Supplier.Address}" Margin="140,0,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,0,0,12"><TextBlock Text="Total Purchases" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Supplier.TotalPurchasesDisplay}" Margin="140,0,0,0" FontWeight="SemiBold"/></Grid>
                <Grid Margin="0,0,0,18"><TextBlock Text="Last Purchase" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/><TextBlock Text="{Binding Supplier.LastPurchaseDisplay}" Margin="140,0,0,0" FontWeight="SemiBold"/></Grid>
                <TextBlock Text="Notes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" />
                <TextBlock Text="{Binding NotesDisplay}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0">
            <Button Content="Edit Supplier" Command="{Binding EditCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>
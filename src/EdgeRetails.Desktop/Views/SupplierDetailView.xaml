<UserControl x:Class="EdgeRetails.Desktop.Views.SupplierDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    Background="{DynamicResource Brush.Surface.Raised}" Foreground="{DynamicResource Brush.Text.Primary}">
    <Grid Width="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="21,14" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1" CornerRadius="0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.DrawerTitle}"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Style="{StaticResource Text.FormLabel}" Text="Supplier profile, Khata, settlements and warranty context"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Command="{Binding RefreshAccountCommand}"
                            Style="{StaticResource Button.Text.Neutral}" Margin="0,0,8,0"/>
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Style="{StaticResource Button.Text.Neutral}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Margin="20,14,20,0" Padding="12,8"
                    Background="{DynamicResource Brush.Surface.Sunken}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1">
                <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}"/>
            </Border>

            <controls:LoadingState Grid.Row="1" Margin="20,24" Message="Loading supplier account and ledger..."
                                   Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TabControl Grid.Row="1" Margin="20,12,20,16">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Outstanding Payable" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Workspace.Summary.OutstandingPayable, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Supplier Credit / Advance" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Workspace.Summary.SupplierCreditOrAdvance, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Net Purchased" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Workspace.Summary.NetPurchased, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="12"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Net Paid" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Workspace.Summary.NetPaidToSupplier, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Gross Purchased" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Workspace.Summary.GrossPurchased, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Return Credits" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Workspace.Summary.PurchaseReturnCredits, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Warranty Credits" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Workspace.Summary.WarrantyCredits, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="10"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Supplier Refunds" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Workspace.Summary.NetSupplierRefundsReceived, StringFormat=Rs. {0:N2}}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding FinancialOperationStatus}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Post Supplier Financial Event" Style="{StaticResource Text.Body}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.35*"/>
                                    <ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Amount" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox IsEnabled="{Binding CanEditFinancialFields}" Text="{Binding TransactionAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Method" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <ComboBox IsEnabled="{Binding CanEditFinancialFields}" ItemsSource="{Binding SettlementMethods}" SelectedItem="{Binding SelectedMethod}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="External Reference" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox IsEnabled="{Binding CanEditFinancialFields}" Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Note / Advance Reason" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox IsEnabled="{Binding CanEditFinancialFields}" Text="{Binding TransactionNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Post Payment" Command="{Binding PostSettlementCommand}"
                                        Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button Content="Post Advance" Command="{Binding PostAdvanceCommand}"
                                        Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button Content="Receive Supplier Refund" Command="{Binding ReceiveRefundCommand}"
                                        Style="{StaticResource Button.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="Reversal reason" Margin="0,18,0,0" Style="{StaticResource Text.PosMeta}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBox IsEnabled="{Binding CanEditFinancialFields}" Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Khata">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Workspace.Statement}" AutoGenerateColumns="False"
                                  Style="{StaticResource Table.DataGrid}"
                                  IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                                <DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="125"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="170"/>
                                <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceType}" Width="120"/>
                                <DataGridTextColumn Header="Effect" Binding="{Binding SignedAmount, StringFormat={}{0:N2}}" Width="100"
                                                    HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                    ElementStyle="{StaticResource Table.TextCell.Numeric}"/>
                                <DataGridTextColumn Header="Running Balance" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="130"
                                                    HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                    ElementStyle="{StaticResource Table.TextCell.Numeric.Bold}"/>
                                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Latest entries" Command="{Binding ReloadStatementCommand}" Style="{StaticResource Button.Text.Neutral}"/>
                            <Button Content="Load older entries" Command="{Binding LoadMoreStatementCommand}" Style="{StaticResource Button.Text.Neutral}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Payments / Advances">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Reload first page" Command="{Binding ReloadPaymentsCommand}" Style="{StaticResource Button.Text.Neutral}"/>
                            <Button Content="Load more" Command="{Binding LoadMorePaymentsCommand}" IsEnabled="{Binding HasMorePayments}" Style="{StaticResource Button.Text.Neutral}"/>
                        </StackPanel>
                    <DataGrid ItemsSource="{Binding Workspace.Payments}" AutoGenerateColumns="False"
                              Style="{StaticResource Table.DataGrid}"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNumber}" Width="125"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="95"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="Action" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reverse"
                                                Command="{Binding DataContext.ReversePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Text.Neutral}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Refunds">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Reload first page" Command="{Binding ReloadRefundsCommand}" Style="{StaticResource Button.Text.Neutral}"/>
                            <Button Content="Load more" Command="{Binding LoadMoreRefundsCommand}" IsEnabled="{Binding HasMoreRefunds}" Style="{StaticResource Button.Text.Neutral}"/>
                        </StackPanel>
                    <DataGrid ItemsSource="{Binding Workspace.Refunds}" AutoGenerateColumns="False"
                              Style="{StaticResource Table.DataGrid}"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Refund" Binding="{Binding RefundNumber}" Width="125"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ReceivedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ExternalReference}" Width="*"/>
                            <DataGridTemplateColumn Header="Action" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reverse"
                                                Command="{Binding DataContext.ReverseRefundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Text.Neutral}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Products Supplied">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Reload first page" Command="{Binding ReloadProductsCommand}" Style="{StaticResource Button.Text.Neutral}"/>
                            <Button Content="Load more" Command="{Binding LoadMoreProductsCommand}" IsEnabled="{Binding HasMoreProducts}" Style="{StaticResource Button.Text.Neutral}"/>
                        </StackPanel>
                    <DataGrid ItemsSource="{Binding Workspace.SuppliedProducts}" AutoGenerateColumns="False"
                              Style="{StaticResource Table.DataGrid}"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Warranty">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Customer Claims" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.CustomerClaimCount}" Style="{StaticResource Text.AmountLarge}"/>
                            <TextBlock Text="Tracked Units" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.TrackedUnitCount}" Style="{StaticResource Text.DetailTitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Shop Stock Cases" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ShopStockCaseCount}" Style="{StaticResource Text.AmountLarge}"/>
                            <TextBlock Text="With Supplier" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.CurrentlyWithSupplier}" Style="{StaticResource Text.DetailTitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ready / Returned" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ReadyOrReturned}" Style="{StaticResource Text.AmountLarge}"/>
                            <TextBlock Text="Closed" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ClosedCount}" Style="{StaticResource Text.DetailTitle}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile">
                    <StackPanel Margin="14">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Phone" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Supplier.Phone}" Margin="140,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="City" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Supplier.City}" Margin="140,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Address" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Supplier.Address}" Margin="140,0,0,0" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="Notes" Style="{StaticResource Text.PosBadge}" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBlock Text="{Binding NotesDisplay}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" CornerRadius="0">
            <Button Content="Edit Supplier" Command="{Binding EditCommand}"
                    Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>

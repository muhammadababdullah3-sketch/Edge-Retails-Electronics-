<UserControl x:Class="EdgeRetails.Desktop.Views.SupplierDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface.Raised}">
    <Grid MinWidth="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="21,14" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <TextBlock Text="Supplier profile, Khata, settlements and warranty context"
                               Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Command="{Binding RefreshAccountCommand}"
                            Style="{StaticResource Button.Text.Neutral}" Margin="0,0,8,0"/>
                    <Button Content="Close" Command="{Binding CloseCommand}"
                            Style="{StaticResource Button.Text.Neutral}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Margin="20,14,20,0" Padding="12,8"
                    Background="{DynamicResource Brush.Surface.Sunken}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12"/>
            </Border>

            <TabControl Grid.Row="1" Margin="20,12,20,16">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Outstanding Payable" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.OutstandingPayable, StringFormat=Rs. {0:N2}}"
                                                   FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Supplier Credit / Advance" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.SupplierCreditOrAdvance, StringFormat=Rs. {0:N2}}"
                                                   FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="12" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Net Purchased" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.NetPurchased, StringFormat=Rs. {0:N2}}"
                                                   FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="12"
                                        BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Net Paid" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.NetPaidToSupplier, StringFormat=Rs. {0:N2}}"
                                                   FontSize="18" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Gross Purchased" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.GrossPurchased, StringFormat=Rs. {0:N2}}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Return Credits" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.PurchaseReturnCredits, StringFormat=Rs. {0:N2}}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Padding="10" Margin="0,0,8,0"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Warranty Credits" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.WarrantyCredits, StringFormat=Rs. {0:N2}}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Padding="10"
                                        Background="{DynamicResource Brush.Surface.Sunken}">
                                    <StackPanel>
                                        <TextBlock Text="Supplier Refunds" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        <TextBlock Text="{Binding Workspace.Summary.NetSupplierRefundsReceived, StringFormat=Rs. {0:N2}}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="Post Supplier Financial Event" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.35*"/>
                                    <ColumnDefinition Width="1.7*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Amount" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox Text="{Binding TransactionAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="Method" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <ComboBox ItemsSource="{Binding SettlementMethods}" SelectedItem="{Binding SelectedMethod}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="External Reference" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox Text="{Binding ExternalReference, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="Note / Advance Reason" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    <TextBox Text="{Binding TransactionNote, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Post Payment" Command="{Binding PostSettlementCommand}"
                                        Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button Content="Post Advance" Command="{Binding PostAdvanceCommand}"
                                        Style="{StaticResource Button.Primary}" Margin="0,0,8,0"/>
                                <Button Content="Receive Supplier Refund" Command="{Binding ReceiveRefundCommand}"
                                        Style="{StaticResource Button.Primary}"/>
                            </StackPanel>
                            <TextBlock Text="Reversal reason" Margin="0,18,0,0" FontSize="11"
                                       Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBox Text="{Binding ReversalReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Khata">
                    <DataGrid ItemsSource="{Binding Workspace.Statement}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Entry" Binding="{Binding EntryNumber}" Width="125"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="170"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ReferenceType}" Width="120"/>
                            <DataGridTextColumn Header="Effect" Binding="{Binding SignedAmount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Running Balance" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Payments / Advances">
                    <DataGrid ItemsSource="{Binding Workspace.Payments}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Payment" Binding="{Binding PaymentNumber}" Width="125"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding PaidAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="95"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="Action" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reverse"
                                                Command="{Binding DataContext.ReversePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Text.Neutral}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Refunds">
                    <DataGrid ItemsSource="{Binding Workspace.Refunds}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Refund" Binding="{Binding RefundNumber}" Width="125"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ReceivedAt, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="145"/>
                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="105"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTextColumn Header="Reference" Binding="{Binding ExternalReference}" Width="*"/>
                            <DataGridTemplateColumn Header="Action" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Reverse"
                                                Command="{Binding DataContext.ReverseRefundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Text.Neutral}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Products Supplied">
                    <DataGrid ItemsSource="{Binding Workspace.SuppliedProducts}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="160"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Warranty">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Customer Claims" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.CustomerClaimCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Tracked Units" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.TrackedUnitCount}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="Shop Stock Cases" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ShopStockCaseCount}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="With Supplier" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.CurrentlyWithSupplier}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ready / Returned" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ReadyOrReturned}" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Closed" Margin="0,10,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Workspace.Warranty.ClosedCount}" FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile">
                    <StackPanel Margin="14">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Phone" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Supplier.Phone}" Margin="140,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="City" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Supplier.City}" Margin="140,0,0,0" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Address" Width="126" Foreground="{DynamicResource Brush.Text.Muted}"/>
                            <TextBlock Text="{Binding Supplier.Address}" Margin="140,0,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Notes" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBlock Text="{Binding NotesDisplay}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0">
            <Button Content="Edit Supplier" Command="{Binding EditCommand}"
                    Style="{StaticResource Button.Primary}" HorizontalAlignment="Stretch"/>
        </Border>
    </Grid>
</UserControl>

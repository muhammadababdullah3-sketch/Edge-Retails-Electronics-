<UserControl x:Class="EdgeRetails.Desktop.Views.FirstSetupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource Brush.App.Background}" Foreground="{DynamicResource Brush.Text.Primary}">
 <Grid>
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
   <Grid MinHeight="720" Margin="24">
    <Border Width="760"
            MaxWidth="760"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Card.Raised}">
     <StackPanel>
      <StackPanel HorizontalAlignment="Center">
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource Brand.Mark}" Width="40" Height="40"/><TextBlock Text="Edge Retails" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.PageTitle}" Foreground="{DynamicResource Brush.Text.Primary}"/></StackPanel>
       <TextBlock Style="{StaticResource Text.SectionTitle}" Text="EdgeRetails POS" Margin="0,7,0,0"
                  Foreground="{DynamicResource Brush.Text.Primary}"
                  HorizontalAlignment="Center"/>
       <TextBlock Style="{StaticResource Text.Secondary}" Text="First Setup / License"
                  Margin="0,4,0,0"
                  Foreground="{DynamicResource Brush.Text.Muted}"
                  HorizontalAlignment="Center"/>
      </StackPanel>

      <Grid Margin="0,24,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" HorizontalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="15"
                Background="{StaticResource Brush.Brand.Primary}">
         <TextBlock Style="{StaticResource Text.Body}" Text="1" Foreground="{StaticResource Brush.White}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="License" Margin="0,5,0,0" Style="{StaticResource Text.FormLabel}"/>
       </StackPanel>
       <StackPanel Grid.Column="1" HorizontalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="15"
                Background="{DynamicResource Brush.Selection.Subtle}">
         <TextBlock Style="{StaticResource Text.Body}" Text="2" Foreground="{DynamicResource Brush.Badge.Brand.Text}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Shop Setup" Margin="0,5,0,0" Style="{StaticResource Text.FormLabel}"/>
       </StackPanel>
       <StackPanel Grid.Column="2" HorizontalAlignment="Center">
        <Border Width="30" Height="30" CornerRadius="15"
                Background="{DynamicResource Brush.Selection.Subtle}">
         <TextBlock Style="{StaticResource Text.Body}" Text="3" Foreground="{DynamicResource Brush.Badge.Brand.Text}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Ready" Margin="0,5,0,0" Style="{StaticResource Text.FormLabel}"/>
       </StackPanel>
      </Grid>

      <Border Margin="0,22,0,0"
              Padding="18"
              Background="{DynamicResource Brush.Surface.Subtle}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="{Binding IsLicenseStep, Converter={StaticResource BooleanToVisibilityConverter}}">
       <StackPanel>
        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="Import License File"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock Style="{StaticResource Text.FormLabel}" Text="Select the signed Edge Retails license package for this installation."
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <Border Padding="12"
                 Background="{DynamicResource Brush.Surface.Default}"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 CornerRadius="8">
          <StackPanel>
           <TextBlock Style="{StaticResource Text.Body}" Text="{Binding LicenseFileName}"
                      TextTrimming="CharacterEllipsis"/>
           <TextBlock Style="{StaticResource Text.PosMeta}" Text="{Binding LicenseStatus}"
                      Margin="0,4,0,0"
                      Foreground="{DynamicResource Brush.Text.Muted}"/>
          </StackPanel>
         </Border>
         <Button Grid.Column="2"
                 Content="Browse License"
                 Command="{Binding BrowseLicenseCommand}"
                 Style="{StaticResource Button.Neutral}"
                 Padding="16,0"/>
        </Grid>
        <Border Margin="0,14,0,0"
                Padding="12"
                Background="{DynamicResource Brush.Selection.Subtle}"
                CornerRadius="8">
         <TextBlock Style="{StaticResource Text.PosMeta}" Text="Frontend preview validates file selection only. Signature verification remains a backend licensing responsibility."
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource Brush.Text.Secondary}"/>
        </Border>
        <Border Margin="0,14,0,0"
                Padding="12"
                Background="{DynamicResource Brush.Badge.Success.Background}"
                BorderBrush="{DynamicResource Brush.Badge.Danger.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasLicenseError, Converter={StaticResource BooleanToVisibilityConverter}}">
         <TextBlock Style="{StaticResource Text.TableHeader}" Text="{Binding LicenseErrorMessage}"
                    Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                    TextWrapping="Wrap"/>
        </Border>
       </StackPanel>
      </Border>

      <Border Margin="0,22,0,0"
              Padding="18"
              Background="{DynamicResource Brush.Surface.Subtle}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="{Binding IsShopStep, Converter={StaticResource BooleanToVisibilityConverter}}">
       <StackPanel>
        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="Shop Setup"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>
        <Grid Margin="0,16,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Shop Name" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}"/>
          <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource Input.TextBox}"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="Owner Name" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}"/>
          <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource Input.TextBox}"/>
         </StackPanel>
        </Grid>
        <Grid Margin="0,14,0,0">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Phone" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}"/>
          <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource Input.TextBox}"/>
         </StackPanel>
         <StackPanel Grid.Column="2">
          <TextBlock Text="Address" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}"/>
          <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                   Style="{StaticResource Input.TextBox}"/>
         </StackPanel>
        </Grid>
        <TextBlock Text="Owner PIN" Margin="0,14,0,5" Style="{StaticResource Text.FormLabel}"/>
        <PasswordBox x:Name="OwnerPinInput"
                     PasswordChanged="OnOwnerPinChanged"
                     Style="{StaticResource Input.PasswordBox}"
                     MaxLength="4"/>
        <TextBlock Style="{StaticResource Text.PosMeta}" Text="4 numeric digits. The demo identity layer hashes this PIN in memory and never stores it as plaintext."
                   Margin="0,5,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Muted}"/>
       </StackPanel>
      </Border>

      <Border Margin="0,22,0,0"
              Padding="18"
              Background="{DynamicResource Brush.Surface.Subtle}"
              BorderBrush="{DynamicResource Brush.Border.Default}"
              BorderThickness="1"
              CornerRadius="10"
              Visibility="{Binding IsReadyStep, Converter={StaticResource BooleanToVisibilityConverter}}">
       <StackPanel>
        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="Ready"
                   Foreground="{DynamicResource Brush.Text.Primary}"/>
        <TextBlock Style="{StaticResource Text.FormLabel}" Text="Frontend setup flow is complete for this session. Backend activation and database initialization remain pending."
                   Margin="0,6,0,16"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="34"/><RowDefinition Height="34"/>
          <RowDefinition Height="34"/><RowDefinition Height="34"/>
         </Grid.RowDefinitions>
         <TextBlock Text="License" Grid.Row="0" Foreground="{DynamicResource Brush.Text.Muted}"/>
         <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ReadyLicenseStatus}" Grid.Row="0" Grid.Column="1"/>
         <TextBlock Text="Database" Grid.Row="1" Foreground="{DynamicResource Brush.Text.Muted}"/>
         <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DatabaseStatus}" Grid.Row="1" Grid.Column="1"/>
         <TextBlock Text="Module" Grid.Row="2" Foreground="{DynamicResource Brush.Text.Muted}"/>
         <TextBlock Text="{Binding ModuleName}" Grid.Row="2" Grid.Column="1"/>
         <TextBlock Text="Shop" Grid.Row="3" Foreground="{DynamicResource Brush.Text.Muted}"/>
         <TextBlock Text="{Binding ShopName}" Grid.Row="3" Grid.Column="1"/>
        </Grid>
       </StackPanel>
      </Border>

      <Grid Margin="0,22,0,0">
       <Button Content="Back"
               Command="{Binding BackCommand}"
               Style="{StaticResource Button.Neutral}"
               HorizontalAlignment="Left"/>
       <Button Content="Continue"
               Command="{Binding ContinueCommand}"
               Style="{StaticResource Button.Primary}"
               HorizontalAlignment="Right"
               Padding="18,0"
               Visibility="{Binding IsReadyStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
       <Button Content="Start Edge Retails"
               Command="{Binding StartCommand}"
               Style="{StaticResource Button.Primary}"
               HorizontalAlignment="Right"
               Padding="18,0"
               Visibility="{Binding IsReadyStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>
  </ScrollViewer>
 </Grid>
</UserControl>

<UserControl x:Class="EdgeRetails.Desktop.Views.PurchaseDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface.Raised}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="21,14"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Font.Primary}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding Supplier}" Margin="0,2,0,0"
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
                <Button Content="✕" Command="{Binding CloseCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="21,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PURCHASE ID" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding PurchaseId}" Margin="0,3,0,0"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Brand.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SUPPLIER INVOICE" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding SupplierInvoice}" Margin="0,3,0,0"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DATE" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding DateDisplay}" Margin="0,3,0,0"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ENTERED BY" FontSize="10.5" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding EnteredBy}" Margin="0,3,0,0"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="NOTE" FontSize="10.5" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Text="{Binding NoteDisplay}" Margin="0,3,0,0"
                               FontSize="13.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <TextBlock Text="ITEMS RECEIVED" Margin="0,0,0,7"
                           FontSize="10.5" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Brand.Primary}" />
                <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource Table.DataGrid}"
                              IsReadOnly="True" BorderThickness="0" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding PurchasedQuantity}" Width="70"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                            <DataGridTextColumn Header="COST" Binding="{Binding Cost}" Width="90"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal}" Width="100"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric.Bold}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource Card.Default}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Subtotal" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding SubtotalDisplay}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Other Charges" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding OtherChargesDisplay}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,2,0,10" />
                        <Grid>
                            <TextBlock Text="TOTAL" FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalDisplay}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource Font.Numeric}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Brand.Primary}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,1,0,0">
            <Button Content="Return Purchase" Command="{Binding ReturnPurchaseCommand}"
                    Style="{StaticResource Button.Warning.Compact}" Height="38"
                    HorizontalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
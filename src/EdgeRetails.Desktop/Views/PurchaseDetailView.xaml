<UserControl x:Class="EdgeRetails.Desktop.Views.PurchaseDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource Brush.Surface.Raised}" Foreground="{DynamicResource Brush.Text.Primary}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="21,14"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,0,0,1" CornerRadius="0">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.DetailTitle}" Text="{Binding Title}" FontFamily="{StaticResource Font.Primary}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding Supplier}" Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
                <Button Command="{Binding CloseCommand}"
                        Style="{StaticResource Button.Close}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="21,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.MonoHint}" Text="PURCHASE ID"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.PosLineTitle}" Text="{Binding PurchaseId}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Badge.Brand.Text}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.MonoHint}" Text="SUPPLIER INVOICE"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.PosLineTitle}" Text="{Binding SupplierInvoice}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Text.MonoHint}" Text="DATE"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.PosLineTitle}" Text="{Binding DateDisplay}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Text.MonoHint}" Text="ENTERED BY"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.PosLineTitle}" Text="{Binding EnteredBy}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource Text.MonoHint}" Text="NOTE"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Style="{StaticResource Text.PosLineTitle}" Text="{Binding NoteDisplay}" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>

                <TextBlock Style="{StaticResource Text.MonoHint}" Text="ITEMS RECEIVED" Margin="0,0,0,7"
                           Foreground="{DynamicResource Brush.Badge.Brand.Text}" />
                <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              Style="{StaticResource Table.DataGrid}"
                              IsReadOnly="True" BorderThickness="0" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" />
                            <DataGridTextColumn Header="QTY" Binding="{Binding PurchasedQuantity}" Width="70"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                            <DataGridTextColumn Header="COST" Binding="{Binding Cost}" Width="90"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotal}" Width="100"
                                                HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                ElementStyle="{StaticResource Table.TextCell.Numeric.Bold}" />
                            <DataGridTemplateColumn Header="PHYSICAL INTAKE" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Receive / Stickers"
                                                Command="{Binding DataContext.OpenPhysicalIntakeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Button.Neutral.Micro}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource Card.Default}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Subtotal" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding SubtotalDisplay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Other Charges" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding OtherChargesDisplay}" HorizontalAlignment="Right" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,2,0,10"  CornerRadius="0"/>
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Control}" Text="TOTAL" />
                            <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding TotalDisplay}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       Foreground="{DynamicResource Brush.Badge.Brand.Text}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="0,1,0,0" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Receive Physical Intake"
                        Command="{Binding OpenPhysicalIntakeCommand}"
                        Style="{StaticResource Button.Primary}" Height="38" Padding="4,0" />
                <Button Grid.Column="2" Content="Return Purchase"
                        Command="{Binding ReturnPurchaseCommand}"
                        Style="{StaticResource Button.Warning.Compact}" Height="38" Padding="4,0" />
                <Button Grid.Column="4" Content="Void Purchase"
                        Command="{Binding VoidPurchaseCommand}"
                        IsEnabled="{Binding CanVoidPurchase}"
                        Visibility="{Binding IsBackendPurchase, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource Button.Warning.Compact}" Height="38" Padding="4,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

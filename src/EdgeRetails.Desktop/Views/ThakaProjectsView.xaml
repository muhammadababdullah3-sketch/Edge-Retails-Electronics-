<UserControl
    x:Class="EdgeRetails.Desktop.Views.ThakaProjectsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    xmlns:dialogs="clr-namespace:EdgeRetails.Desktop.Views.Dialogs"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:ThakaProjectsViewModel, IsDesignTimeCreatable=True}"
    Focusable="False">

    <UserControl.Resources>
        <!-- Filter Pill Button Base Style -->
        <Style x:Key="Button.FilterTab" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Compact}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Mode Switcher Button Style -->
        <Style x:Key="Button.ViewModeToggle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Compact}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.App.Background}">
        <!-- 1. Main View Content in ScrollViewer -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="20">
            <StackPanel MaxWidth="{StaticResource Container.MaxWidth.Standard}">
                <!-- Header Banner: Title, Subtitle, Cashier Profile Context, and "+ New Thaka" Button -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.PageTitle.Dense}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding PageSubtitle}"
                                   Style="{StaticResource Text.Body.Secondary}" />
                    </StackPanel>

                    <!-- Cashier Context & CTA -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Cashier Profile Context -->
                        <Border Padding="10,6"
                                Margin="0,0,14,0"
                                Background="{DynamicResource Brush.Surface.Raised}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="12"
                                        Background="{StaticResource Gradient.Brand.Primary}">
                                    <TextBlock Text="{Binding CashierInitials}"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.White}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="8,0,0,0"
                                           Text="{Binding CashierDisplay}"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- "+ New Thaka" Button -->
                        <Button Height="38"
                                Padding="16,0"
                                Content="+ New Thaka"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding NewThakaCommand}" />
                    </StackPanel>
                </Grid>

                <!-- 2. Three Summary KPI Cards (Figma 14:4538) -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Active Thakas ("3") -->
                    <controls:KpiCard Grid.Column="0"
                                      Title="Active Thakas"
                                      Value="{Binding ActiveThakasCount}"
                                      Tone="Thaka"
                                      IconGeometry="{StaticResource Icon.Nav.ThakaProjects}" />

                    <!-- Card 2: Material Value ("Rs. 687,400") -->
                    <controls:KpiCard Grid.Column="2"
                                      Title="Material Value"
                                      Value="{Binding TotalMaterialValueFormatted}"
                                      Tone="Success"
                                      IconGeometry="{StaticResource Icon.Nav.POS}" />

                    <!-- Card 3: Outstanding Balance ("Rs. 587,400") -->
                    <controls:KpiCard Grid.Column="4"
                                      Title="Outstanding Balance"
                                      Value="{Binding OutstandingBalanceFormatted}"
                                      Tone="Warning"
                                      IconGeometry="{StaticResource Icon.Nav.Expenses}" />
                </Grid>

                <!-- 3. Search Box & Filter Tabs Toolbar -->
                <Border Margin="0,0,0,18"
                        Padding="12"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <controls:SearchBox Grid.Column="0"
                                            Width="340"
                                            IsCompact="True"
                                            Placeholder="Search customer, project or phone..."
                                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Filter Tabs: All, Active, Settled & View Mode Toggle -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- All Tab -->
                            <Button Content="All"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="All">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.FilterTab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Active Tab -->
                            <Button Content="Active"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Active">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.FilterTab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Settled Tab -->
                            <Button Content="Settled"
                                    Command="{Binding SetFilterCommand}"
                                    CommandParameter="Settled">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.FilterTab}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterSettled}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Border Width="1"
                                    Height="20"
                                    Margin="8,0,10,0"
                                    Background="{DynamicResource Brush.Border.Default}" />

                            <!-- View Mode: Cards Toggle -->
                            <Button Content="Cards"
                                    Command="{Binding ToggleViewModeCommand}"
                                    CommandParameter="Cards"
                                    Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.ViewModeToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCardsView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- View Mode: Table Toggle -->
                            <Button Content="Table"
                                    Command="{Binding ToggleViewModeCommand}"
                                    CommandParameter="Table">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.ViewModeToggle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTableView}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Projects Display: Cards Mode -->
                <ItemsControl ItemsSource="{Binding FilteredProjects}"
                              Visibility="{Binding IsCardsView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ThakaProjectListItemViewModel}">
                            <Border Width="370"
                                    Margin="0,0,16,16"
                                    Padding="18"
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Effect="{StaticResource Shadow.Surface}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top: Project Name & Status Badge -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ProjectName}"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />

                                        <controls:StatusBadge Grid.Column="1"
                                                              Text="{Binding Status}"
                                                              Tone="{Binding StatusTone}" />
                                    </Grid>

                                    <!-- Customer Name -->
                                    <TextBlock Grid.Row="1"
                                               Margin="0,3,0,0"
                                               Text="{Binding CustomerName}"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="13.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                                    <!-- Divider -->
                                    <Border Grid.Row="2"
                                            Height="1"
                                            Margin="0,12,0,12"
                                            Background="{DynamicResource Brush.Border.Soft}" />

                                    <!-- Location, Phone & Start Date Metadata -->
                                    <StackPanel Grid.Row="3">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Phone:"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Phone}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                        </Grid>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Location:"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Location}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Started:"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StartDateFormatted}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                        </Grid>

                                        <!-- Financial Box: Material Value, Paid, Balance -->
                                        <Border Padding="12,10"
                                                Background="{DynamicResource Brush.Surface.Subtle}"
                                                CornerRadius="{StaticResource Radius.Compact}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Material Value -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Material"
                                                               FontFamily="{StaticResource Font.Primary}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding MaterialValueFormatted}"
                                                               FontFamily="{StaticResource Font.Numeric}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                                </StackPanel>

                                                <!-- Paid -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="Paid"
                                                               FontFamily="{StaticResource Font.Primary}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding PaidFormatted}"
                                                               FontFamily="{StaticResource Font.Numeric}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Function.Success}" />
                                                </StackPanel>

                                                <!-- Balance -->
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Balance"
                                                               FontFamily="{StaticResource Font.Primary}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding BalanceFormatted}"
                                                               FontFamily="{StaticResource Font.Numeric}"
                                                               FontSize="12.5"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Function.Warning}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Action Button: "Open Workspace" -->
                                    <Button Grid.Row="4"
                                            Margin="0,14,0,0"
                                            Height="35"
                                            Content="Open Workspace"
                                            Style="{StaticResource Button.Neutral}"
                                            Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 5. Projects Display: Table Mode (DataGrid with IsReadOnly="True") -->
                <DataGrid ItemsSource="{Binding FilteredProjects}"
                          IsReadOnly="True"
                          Style="{StaticResource Table.DataGrid}"
                          Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}"
                          MinHeight="260"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Project Name"
                                            Binding="{Binding ProjectName}"
                                            Width="160" />
                        <DataGridTextColumn Header="Customer"
                                            Binding="{Binding CustomerName}"
                                            Width="140" />
                        <DataGridTextColumn Header="Phone"
                                            Binding="{Binding Phone}"
                                            Width="120" />
                        <DataGridTextColumn Header="Location"
                                            Binding="{Binding Location}"
                                            Width="160" />
                        <DataGridTextColumn Header="Start Date"
                                            Binding="{Binding StartDateFormatted}"
                                            Width="110" />
                        <DataGridTextColumn Header="Material Value"
                                            Binding="{Binding MaterialValueFormatted}"
                                            HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                            ElementStyle="{StaticResource Table.TextCell.Numeric}"
                                            Width="120" />
                        <DataGridTextColumn Header="Paid"
                                            Binding="{Binding PaidFormatted}"
                                            HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                            ElementStyle="{StaticResource Table.TextCell.Numeric}"
                                            Width="100" />
                        <DataGridTextColumn Header="Balance"
                                            Binding="{Binding BalanceFormatted}"
                                            HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                            ElementStyle="{StaticResource Table.TextCell.Numeric.Bold}"
                                            Width="110" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ThakaProjectListItemViewModel}">
                                    <controls:StatusBadge Text="{Binding Status}"
                                                          Tone="{Binding StatusTone}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Action" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ThakaProjectListItemViewModel}">
                                    <Button Height="28"
                                            Padding="10,0"
                                            Content="Open Workspace"
                                            Style="{StaticResource Button.Neutral}"
                                            Command="{Binding DataContext.OpenWorkspaceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Load More"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Padding="24,8"
                        Style="{StaticResource Button.Neutral}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 6. Modal / Drawer Overlay for New Thaka (Figma 14:4836) -->
        <Grid Visibility="{Binding IsNewThakaOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Panel.ZIndex="100">
            <!-- Scrim Backdrop -->
            <Border Background="{DynamicResource Brush.Overlay.Scrim}" />

            <!-- Centered Modal Form -->
            <dialogs:NewThakaDialog DataContext="{Binding NewThaka}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

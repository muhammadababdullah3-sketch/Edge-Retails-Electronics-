<UserControl
    x:Class="EdgeRetails.Desktop.Views.ThakaWorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls" Foreground="{DynamicResource Brush.Text.Primary}">
    <Grid Background="{DynamicResource Brush.App.Background}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ScrollViewer.CleanOverlay}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="← Back"
                            Command="{Binding GoBackCommand}"
                            Style="{StaticResource Button.Neutral}"
                            Margin="0,0,12,0" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding ProjectName}"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <controls:StatusBadge Margin="10,2,0,0"
                                                  Text="{Binding StatusDisplay}"
                                                  Tone="{Binding StatusTone}"
                                                  VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,5,0,0"
                                   Text="{Binding ContactSubtitle}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="Loading workspace…" Margin="0,6,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Badge.Danger.Text}" Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Khata suspended: new material/credit is blocked; payment recovery remains available." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Badge.Warning.Text}" Visibility="{Binding IsSuspended, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="Customer suspended: new material/credit is blocked; payment recovery remains available." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Brush.Badge.Warning.Text}" Visibility="{Binding IsCustomerSuspended, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="2" MaxWidth="500" HorizontalAlignment="Right">
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource Button.Neutral}" Margin="0,0,8,0"/>
                        <Button Content="{Binding SuspensionAction}" Command="{Binding ToggleSuspensionCommand}" Style="{StaticResource Button.Neutral}" Margin="0,0,8,0"/>
                        <Button Content="+ Add Material"
                                Command="{Binding AddMaterialCommand}"
                                Style="{StaticResource Button.Info.Compact}"
                                Margin="0,0,8,0" />
                        <Button Content="Record Payment"
                                Command="{Binding RecordPaymentCommand}"
                                Style="{StaticResource Button.Payment.Compact}"
                                Margin="0,0,8,0" />
                        <Button Content="Refund Credit"
                                Command="{Binding OpenRefundCreditCommand}"
                                Style="{StaticResource Button.Warning.Compact}"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasCustomerCredit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Final Settlement"
                                Command="{Binding FinalSettlementCommand}"
                                Style="{StaticResource Button.Warning.Compact}" />
                    </WrapPanel>
                </Grid>

                <StackPanel Grid.Row="1">
                    <Border Margin="0,16,0,0"
                            Padding="12,10"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Brush.Badge.Neutral.Background}"
                            BorderBrush="{DynamicResource Brush.Badge.Neutral.Border}"
                            BorderThickness="1"
                            Visibility="{Binding IsSettledBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body.Secondary}" Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="This Thaka project is settled and finalized. Records are read-only."
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Badge.Neutral.Text}" />
                            <Button Grid.Column="1"
                                    Content="Reopen Project"
                                    Command="{Binding ReopenProjectCommand}"
                                    Style="{StaticResource Button.Neutral}"
                                    Margin="12,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- Operator Choice: Same-Project Credit Retention vs Authorized Refund (OWNER-UPDATE-20261019-001) -->
                    <Border Margin="0,16,0,0"
                            Padding="16,14"
                            CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Brush.Badge.Warning.Background}"
                            BorderBrush="{DynamicResource Brush.Badge.Warning.Border}"
                            BorderThickness="1"
                            Visibility="{Binding HasCustomerCredit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Text.Control}" Text="Customer Credit Balance: "
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                                        <TextBlock Style="{StaticResource Text.Control}" Text="{Binding CustomerCreditFormatted}"
                                                   FontFamily="{StaticResource Font.Numeric}"
                                                   Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0"
                                               Text="Payments collected exceed net material charges. Operator choice: retain credit in this project to automatically absorb future material charges, or issue an authorized cash drawer refund."
                                               FontFamily="{StaticResource Font.Primary}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="Retain Credit in Project"
                                            Command="{Binding RetainCreditCommand}"
                                            Style="{StaticResource Button.Neutral}"
                                            Margin="0,0,8,0" />
                                    <Button Content="Issue Cash Refund"
                                            Command="{Binding OpenRefundCreditCommand}"
                                            Style="{StaticResource Button.Warning.Compact}" />
                                </StackPanel>
                            </Grid>

                            <!-- Inline Authorized Refund Entry Panel -->
                            <Border Margin="0,12,0,0"
                                    Padding="14,12"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Background="{DynamicResource Brush.Surface.Raised}"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsRefundPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body.Secondary}" Text="Authorize Cash Drawer Refund"
                                               FontFamily="{StaticResource Font.Primary}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Margin="0,0,0,10" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Text.PosMeta}" Text="Refund Amount (Rs.)"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding RefundAmountInput, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                     Style="{StaticResource Input.TextBox}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Text.PosMeta}" Text="Reason / Authorization Reference"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       Margin="0,0,0,4" />
                                            <TextBox Text="{Binding RefundReasonInput, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource Input.TextBox}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <Button Content="Confirm Refund"
                                                    Command="{Binding ConfirmRefundCreditCommand}"
                                                    Style="{StaticResource Button.Payment.Compact}"
                                                    Margin="0,0,8,0" />
                                            <Button Content="Cancel"
                                                    Command="{Binding CloseRefundCreditCommand}"
                                                    Style="{StaticResource Button.Neutral}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource Text.FormLabel}" Text="Processing cash refund from drawer…"
                                               FontFamily="{StaticResource Font.Primary}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding IsRefundingCredit, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding RefundErrorMessage}"
                                               FontFamily="{StaticResource Font.Primary}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding HasRefundErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card.Raised}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Material Value"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0,6,0,0"
                                       Text="{Binding MaterialValueFormatted}"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0"
                                       Text="Total goods issued"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card.Raised}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Total Paid"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0,6,0,0"
                                       Text="{Binding TotalPaidFormatted}"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0"
                                       Text="Payments received"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card.Raised}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Outstanding Balance"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Style="{StaticResource Text.PageTitle}" Margin="0,6,0,0"
                                       Text="{Binding BalanceFormatted}"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0"
                                       Text="Payable by client"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Subtle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,18,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Issued Items"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Materials"
                            Style="{StaticResource Button.Neutral}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="1"
                            Content="Payments Received"
                            Command="{Binding SwitchTabCommand}"
                            CommandParameter="Payments"
                            Style="{StaticResource Button.Neutral}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Reverse Selected Issue"
                                Command="{Binding ReverseMaterialCommand}"
                                Style="{StaticResource Button.Warning.Compact}"
                                Visibility="{Binding IsMaterialsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Reverse Selected Payment"
                                Command="{Binding ReversePaymentCommand}"
                                Style="{StaticResource Button.Warning.Compact}"
                                Visibility="{Binding IsPaymentsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4">
                    <DataGrid ItemsSource="{Binding MaterialLedger}"
                              SelectedItem="{Binding SelectedMaterial, Mode=TwoWay}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              Style="{StaticResource Table.DataGrid}"
                              Visibility="{Binding IsMaterialsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="120" />
                            <DataGridTextColumn Header="Challan / Slip #" Binding="{Binding ChallanNumber}" Width="140" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityDisplay}" Width="100" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90" />
                            <DataGridTextColumn Header="Rate" Binding="{Binding RateFormatted}" Width="120" />
                            <DataGridTextColumn Header="Total Value" Binding="{Binding TotalValueFormatted}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid ItemsSource="{Binding PaymentLedger}"
                              SelectedItem="{Binding SelectedPayment, Mode=TwoWay}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              Style="{StaticResource Table.DataGrid}"
                              Visibility="{Binding IsPaymentsTabSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="120" />
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="120" />
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="140" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding AmountFormatted}" Width="140" />
                            <DataGridTextColumn Header="Recorded By" Binding="{Binding RecordedBy}" Width="140" />
                            <DataGridTextColumn Header="Reference / Note" Binding="{Binding Reference}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

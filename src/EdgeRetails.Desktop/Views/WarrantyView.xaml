<UserControl x:Class="EdgeRetails.Desktop.Views.WarrantyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Warranty" FontFamily="{StaticResource Font.Primary}"
                           FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                <TextBlock Text="Customer claims and shop-stock warranty operations"
                           Margin="0,4,0,0" FontFamily="{StaticResource Font.Primary}"
                           FontSize="13" Foreground="{DynamicResource Brush.Text.Muted}"/>
            </StackPanel>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"
                    Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Open" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                    <TextBlock Text="{Binding Summary.OpenCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="With Supplier" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                    <TextBlock Text="{Binding Summary.WithSupplierCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" Margin="0,0,10,0"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Ready" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                    <TextBlock Text="{Binding Summary.ReadyCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Completed / Closed" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                    <TextBlock Text="{Binding Summary.ClosedCount}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Claim/case, customer, product, supplier, TrackingCode, Serial or IMEI"/>
            <ComboBox Grid.Column="1" Margin="10,0,0,0"
                      ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"/>
            <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"
                       MaxWidth="360"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="105"/>
                    <DataGridTextColumn Header="Claim / Case" Binding="{Binding Number}" Width="125"/>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Customer / Source" Binding="{Binding CustomerOrSource}" Width="150"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="140"/>
                    <DataGridTextColumn Header="Tracking" Binding="{Binding TrackingCode}" Width="125"/>
                    <DataGridTextColumn Header="Serial / IMEI" Binding="{Binding SerialNumber}" Width="125"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="115"/>
                    <DataGridTextColumn Header="Custody" Binding="{Binding Custody}" Width="105"/>
                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Work Item" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedRow.Number}" Margin="0,5,0,0"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedRow.ProductName}" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <TextBlock Text="{Binding SelectedRow.TrackingCode}" Margin="0,2,0,0"
                                   FontFamily="Consolas" Foreground="{DynamicResource Brush.Text.Muted}"/>

                        <TextBlock Text="Operator note / reason" Margin="0,16,0,4"
                                   FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBox Text="{Binding ActionNote, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap"/>

                        <TextBlock Text="New Customer Warranty Claim" Margin="0,16,0,8"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="Search authoritative Sale / SaleItem" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBox Text="{Binding ClaimIntakeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Invoice, customer, product, TrackingCode, Serial or IMEI"
                                 Margin="0,3,0,4"/>
                        <Button Content="Search Sold Items" Command="{Binding SearchClaimIntakeCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding IntakeRows}" SelectedItem="{Binding SelectedIntakeRow}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Height="150" Margin="0,0,0,6"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="90"/>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding BaseQuantity}" Width="50"/>
                                <DataGridTextColumn Header="Warranty" Binding="{Binding WarrantyValidUntil}" Width="90"/>
                                <DataGridTextColumn Header="Eligible" Binding="{Binding Eligible}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox Text="{Binding ClaimIntakeCustomerIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Authoritative Customer ID" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ClaimIntakeQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Quantity for non-serialized products" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ClaimIntakeUnitIdsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Exact InventoryUnit IDs; comma/semicolon/newline separated for serialized products"
                                 Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ClaimIntakeFaultText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Warranty fault/reason" Margin="0,0,0,4"
                                 TextWrapping="Wrap"/>
                        <Button Content="Create Customer Warranty Claim"
                                Command="{Binding CreateClaimCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,10"/>

                        <TextBlock Text="Customer Claim Actions" Margin="0,6,0,8"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <Button Content="Begin Review" Command="{Binding BeginReviewCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Send to Supplier" Command="{Binding SendToSupplierCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Supplier Processing" Command="{Binding SupplierProcessingCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Resolve as Repaired" Command="{Binding ResolveRepairedCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Resolve as Rejected" Command="{Binding ResolveRejectedCommand}"
                                Style="{StaticResource Button.Text.Neutral}" Margin="0,0,0,6"/>
                        <Button Content="Resolve as Refunded" Command="{Binding ResolveRefundedCommand}"
                                Style="{StaticResource Button.Text.Neutral}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CustomerReplacementUnitsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Serialized replacement rows: ClaimItemUnitId|Serial|IMEI1|IMEI2; separate units with semicolons"
                                 Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <Button Content="Receive Customer Replacement" Command="{Binding CustomerReplacementCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Handover to Customer" Command="{Binding HandoverCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>
                        <Button Content="Cancel Claim" Command="{Binding CancelClaimCommand}"
                                Style="{StaticResource Button.Text.Neutral}"/>

                        <TextBlock Text="Shop Stock Warranty" Margin="0,18,0,8"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="New case: Product ID / Supplier ID / quantity" FontSize="10"
                                   Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBox Text="{Binding ShopProductIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Authoritative Product ID" Margin="0,3,0,4"/>
                        <TextBox Text="{Binding ShopSupplierIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Authoritative Supplier ID" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ShopQuantityText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Quantity; serialized stock requires exact unit IDs" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ShopSourcePurchaseItemIdText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Required for quantity/length stock: source PurchaseItem ID" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ShopOriginalUnitIdsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Comma/semicolon/newline-separated InventoryUnit IDs"
                                 Margin="0,0,0,4"/>
                        <Button Content="Send Shop Stock to Supplier"
                                Command="{Binding SendShopStockCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,6"/>

                        <TextBlock Text="Supplier Receive / Resolution" Margin="0,8,0,4"
                                   FontSize="11" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ShopReplacementUnitsText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Replacement units: Serial|IMEI1|IMEI2; separate units with semicolons"
                                 Margin="0,0,0,4" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding ShopSupplierCreditText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Positive supplier credit amount" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ShopSupplierReferenceText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Supplier reference" Margin="0,0,0,4"/>
                        <Button Content="Receive Repaired" Command="{Binding ReceiveShopRepairedCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,4"/>
                        <Button Content="Receive Rejected" Command="{Binding ReceiveShopRejectedCommand}"
                                Style="{StaticResource Button.Text.Neutral}" Margin="0,0,0,4"/>
                        <Button Content="Receive Scrapped" Command="{Binding ReceiveShopScrappedCommand}"
                                Style="{StaticResource Button.Text.Neutral}" Margin="0,0,0,4"/>
                        <Button Content="Receive Replacement" Command="{Binding ReceiveShopReplacedCommand}"
                                Style="{StaticResource Button.Primary}" Margin="0,0,0,4"/>
                        <Button Content="Record Supplier Credit" Command="{Binding ReceiveShopCreditedCommand}"
                                Style="{StaticResource Button.Primary}"/>

                        <TextBlock Text="Timeline" Margin="0,18,0,8" FontSize="12" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="8"
                                            Background="{DynamicResource Brush.Surface.Sunken}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding EventType}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}">
                                                <Run Text="{Binding Status}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding Custody}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="10"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                            <TextBlock Text="{Binding OccurredAt, StringFormat={}{0:dd MMM yyyy HH:mm}}"
                                                       FontSize="9" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,10,0,0"
                   Text="Exact serialized identity is read from InventoryUnit provenance. UI actions call canonical warranty handlers; stock and custody are not mutated locally."
                   FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>

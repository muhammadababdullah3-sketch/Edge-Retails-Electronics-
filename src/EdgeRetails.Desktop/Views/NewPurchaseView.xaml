<UserControl x:Class="EdgeRetails.Desktop.Views.NewPurchaseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    Background="{DynamicResource Brush.App.Background}">
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1320">
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="New Purchase" FontFamily="{StaticResource Font.Primary}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Receive supplier stock into inventory"
                               Margin="0,3,0,0" FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
                <Button Content="Back to Purchase History" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}" HorizontalAlignment="Right" />
            </Grid>
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Supplier" Margin="0,0,0,5" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  Height="35" VerticalContentAlignment="Center" />
                    </StackPanel>                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Invoice Number" Margin="0,0,0,5" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Text="{Binding InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Padding="10,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Date" Margin="0,0,0,5" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <DatePicker SelectedDate="{Binding PurchaseDate}" Height="35" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Note" Margin="0,0,0,5" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="35" Padding="10,6" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SearchBox Grid.Column="0" Height="36"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Search product, SKU or brand..." />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding FilteredProducts}"
                              SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name"
                              Height="35" VerticalContentAlignment="Center" />
                    <Button Grid.Column="4" Content="Add Product"
                            Command="{Binding AddSelectedProductCommand}"
                            Style="{StaticResource Button.Primary}" Padding="16,0" />
                </Grid>
            </Border>            <Border Background="{DynamicResource Brush.Surface.Default}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                    Margin="0,0,0,14">
                <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource Table.DataGrid}"
                          BorderThickness="0" MinHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="QTY" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="110" />
                        <DataGridTextColumn Header="COST" Binding="{Binding Cost, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="130" />
                        <DataGridTextColumn Header="SALE PRICE" Binding="{Binding SalePrice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="140" />
                        <DataGridTextColumn Header="TOTAL" Binding="{Binding LineTotalDisplay}" Width="150" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="ACTION" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Style="{StaticResource Button.Text.Neutral}"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Style="{StaticResource Card.Default}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Purchase increases shared sellable stock and writes a Purchase + movement."
                               VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Subtotal" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding SubtotalDisplay}" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        </Grid>                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Other Charges" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBox Text="{Binding OtherChargesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="130" Height="30" Padding="8,4" HorizontalAlignment="Right"
                                     TextAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="TOTAL" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBlock Text="{Binding TotalDisplay}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource Font.Numeric}" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelCommand}"
                                    Style="{StaticResource Button.Neutral}" Margin="0,0,8,0" />
                            <Button Content="Save Purchase" Command="{Binding SavePurchaseCommand}"
                                    Style="{StaticResource Button.Info.PrimaryAction}" Width="180" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
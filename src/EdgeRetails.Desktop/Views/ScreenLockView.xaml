<UserControl x:Class="EdgeRetails.Desktop.Views.ScreenLockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="#CC000000">
    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="320"
                Padding="28"
                Background="{DynamicResource Brush.Surface.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Default}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Screen locked"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding DisplayName}"
                           Margin="0,8,0,0"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding RoleName}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Subtle}" />
                <TextBlock Margin="0,16,0,8"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Subtle}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Enter your PIN to continue" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Text" Value="Incorrect PIN. Try again." />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding PinLength, StringFormat='PIN digits: {0}/4'}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource Brush.Text.Subtle}" />
                <UniformGrid Rows="4" Columns="3" Margin="0,0,0,12">
                    <Button Content="1" Command="{Binding AppendDigitCommand}" CommandParameter="1" Margin="3" />
                    <Button Content="2" Command="{Binding AppendDigitCommand}" CommandParameter="2" Margin="3" />
                    <Button Content="3" Command="{Binding AppendDigitCommand}" CommandParameter="3" Margin="3" />
                    <Button Content="4" Command="{Binding AppendDigitCommand}" CommandParameter="4" Margin="3" />
                    <Button Content="5" Command="{Binding AppendDigitCommand}" CommandParameter="5" Margin="3" />
                    <Button Content="6" Command="{Binding AppendDigitCommand}" CommandParameter="6" Margin="3" />
                    <Button Content="7" Command="{Binding AppendDigitCommand}" CommandParameter="7" Margin="3" />
                    <Button Content="8" Command="{Binding AppendDigitCommand}" CommandParameter="8" Margin="3" />
                    <Button Content="9" Command="{Binding AppendDigitCommand}" CommandParameter="9" Margin="3" />
                    <Button Content="C" Command="{Binding ClearCommand}" Margin="3" />
                    <Button Content="0" Command="{Binding AppendDigitCommand}" CommandParameter="0" Margin="3" />
                    <Button Content="⌫" Command="{Binding BackspaceCommand}" Margin="3" />
                </UniformGrid>
                <Button Content="Switch user"
                        Command="{Binding SwitchUserCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="EdgeRetails.Desktop.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource Brush.App.Background}">
 <UserControl.Resources>
  <Style x:Key="Settings.NavButton" TargetType="Button" BasedOn="{StaticResource Button.Neutral}">
   <Setter Property="Height" Value="36"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Padding" Value="12,0"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
   <Setter Property="Effect" Value="{x:Null}"/>
   <Style.Triggers>
    <Trigger Property="Tag" Value="True">
     <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}"/>
     <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}"/>
     <Setter Property="Foreground" Value="{StaticResource Brush.Brand.Primary}"/>
    </Trigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="Settings.Label" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
   <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>
  <Style x:Key="Settings.SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="19"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
  </Style>
 </UserControl.Resources>

 <Grid Margin="20">
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="190"/>
   <ColumnDefinition Width="18"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <StackPanel Grid.Column="0">
   <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
              Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,16"/>
   <Button Content="Shop" Tag="{Binding IsShop}" Command="{Binding SelectSectionCommand}"
           CommandParameter="Shop" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Receipt" Tag="{Binding IsReceipt}" Command="{Binding SelectSectionCommand}"
           CommandParameter="Receipt" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Users &amp; Access" Tag="{Binding IsUsersAccess}" Command="{Binding SelectSectionCommand}"
           CommandParameter="UsersAccess" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Categories &amp; Units" Tag="{Binding IsCategoriesUnits}" Command="{Binding SelectSectionCommand}"
           CommandParameter="CategoriesUnits" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Backup" Tag="{Binding IsBackup}" Command="{Binding SelectSectionCommand}"
           CommandParameter="Backup" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="License" Tag="{Binding IsLicense}" Command="{Binding SelectSectionCommand}"
           CommandParameter="License" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Appearance" Tag="{Binding IsAppearance}" Command="{Binding SelectSectionCommand}"
           CommandParameter="Appearance" Style="{StaticResource Settings.NavButton}"/>
   <Button Content="Database" Tag="{Binding IsDatabase}" Command="{Binding SelectSectionCommand}"
           CommandParameter="Database" Style="{StaticResource Settings.NavButton}"/>
  </StackPanel>

  <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="1020">

    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsShop, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <TextBlock Text="Shop Settings" Style="{StaticResource Settings.SectionTitle}"/>
      <Grid Margin="0,18,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Shop Name" Style="{StaticResource Settings.Label}"/>
        <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="Owner Name" Style="{StaticResource Settings.Label}"/>
        <TextBox Text="{Binding OwnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
       </StackPanel>
      </Grid>
      <Grid Margin="0,14,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Phone" Style="{StaticResource Settings.Label}"/>
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="Address" Style="{StaticResource Settings.Label}"/>
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="Logo" Margin="0,14,0,5" FontSize="12"/>
      <Grid>
       <TextBox Text="{Binding LogoPath}" Style="{StaticResource Input.TextBox}" Margin="0,0,130,0" IsReadOnly="True"/>
       <Button Content="Upload Logo" Command="{Binding UploadLogoCommand}" Style="{StaticResource Button.Neutral}"
               Width="120" HorizontalAlignment="Right"/>
      </Grid>
      <Button Content="Save Changes" Command="{Binding SaveShopCommand}" Style="{StaticResource Button.Primary}"
              HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,0"/>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsReceipt, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <TextBlock Text="Receipt Settings" Style="{StaticResource Settings.SectionTitle}"/>
      <Grid Margin="0,18,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="Printer" Style="{StaticResource Settings.Label}"/>
        <ComboBox ItemsSource="{Binding Printers}" SelectedItem="{Binding Printer}" Style="{StaticResource Input.ComboBox}"/>
       </StackPanel>
       <StackPanel Grid.Column="2">
        <TextBlock Text="Paper Size" Style="{StaticResource Settings.Label}"/>
        <ComboBox ItemsSource="{Binding PaperSizes}" SelectedItem="{Binding PaperSize}" Style="{StaticResource Input.ComboBox}"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="Header Text" Margin="0,14,0,5" FontSize="12"/>
      <TextBox Text="{Binding HeaderText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
      <TextBlock Text="Footer Text" Margin="0,14,0,5" FontSize="12"/>
      <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/>
      <WrapPanel Margin="0,16,0,0">
       <CheckBox Content="Show Customer" IsChecked="{Binding ShowCustomer}" Margin="0,0,24,0"/>
       <CheckBox Content="Show Cashier" IsChecked="{Binding ShowCashier}" Margin="0,0,24,0"/>
       <CheckBox Content="Auto Print" IsChecked="{Binding AutoPrint}"/>
      </WrapPanel>
      <Button Content="Save Receipt Settings" Command="{Binding SaveReceiptCommand}" Style="{StaticResource Button.Primary}"
              HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,0"/>
     </StackPanel>
    </Border>

    <StackPanel Visibility="{Binding IsUsersAccess, Converter={StaticResource BooleanToVisibilityConverter}}">
     <Border Style="{StaticResource Card.Default}">
      <StackPanel>
       <Grid Margin="0,0,0,12">
        <TextBlock Text="Users" Style="{StaticResource Settings.SectionTitle}"/>
        <Button Content="+ Add User" Command="{Binding AddUserCommand}" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Right"/>
       </Grid>
       <DataGrid ItemsSource="{Binding Users}" Style="{StaticResource Table.DataGrid}" Height="165">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
         <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
         <DataGridTemplateColumn Header="Action" Width="90">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <Button Content="Edit" Style="{StaticResource Button.Text.Primary}"
                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card.Default}" Margin="0,16,0,0">
      <StackPanel>
       <TextBlock Text="Permission Matrix" Style="{StaticResource Settings.SectionTitle}" Margin="0,0,0,12"/>
       <DataGrid ItemsSource="{Binding PermissionMatrix}" Style="{StaticResource Table.DataGrid}" Height="390">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Permission" Binding="{Binding Permission}" Width="*"/>
         <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="110"/>
         <DataGridTextColumn Header="Manager" Binding="{Binding Manager}" Width="110"/>
         <DataGridTextColumn Header="Cashier" Binding="{Binding Cashier}" Width="110"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>
    </StackPanel>

    <StackPanel Visibility="{Binding IsCategoriesUnits, Converter={StaticResource BooleanToVisibilityConverter}}">
     <Border Style="{StaticResource Card.Default}">
      <StackPanel>
       <Grid Margin="0,0,0,12">
        <TextBlock Text="Categories" Style="{StaticResource Settings.SectionTitle}"/>
        <Button Content="+ Add Category" Command="{Binding AddCategoryCommand}" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Right"/>
       </Grid>
       <DataGrid ItemsSource="{Binding Categories}" Style="{StaticResource Table.DataGrid}" Height="260">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Products" Binding="{Binding ProductCount}" Width="100"/>
         <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
         <DataGridTemplateColumn Header="Action" Width="170">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <StackPanel Orientation="Horizontal">
             <Button Content="Edit" Style="{StaticResource Button.Text.Primary}"
                     Command="{Binding DataContext.EditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}" Margin="0,0,14,0"/>
             <Button Content="{Binding ToggleActionText}" Style="{StaticResource Button.Text.Neutral}"
                     Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}"/>
            </StackPanel>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card.Default}" Margin="0,16,0,0">
      <StackPanel>
       <Grid Margin="0,0,0,12">
        <TextBlock Text="Units" Style="{StaticResource Settings.SectionTitle}"/>
        <Button Content="+ Add Unit" Command="{Binding AddUnitCommand}" Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Right"/>
       </Grid>
       <DataGrid ItemsSource="{Binding Units}" Style="{StaticResource Table.DataGrid}" Height="260">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Unit" Binding="{Binding Name}" Width="*"/>
         <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol}" Width="120"/>
         <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
         <DataGridTemplateColumn Header="Action" Width="170">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <StackPanel Orientation="Horizontal">
             <Button Content="Edit" Style="{StaticResource Button.Text.Primary}"
                     Command="{Binding DataContext.EditUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}" Margin="0,0,14,0"/>
             <Button Content="{Binding ToggleActionText}" Style="{StaticResource Button.Text.Neutral}"
                     Command="{Binding DataContext.ToggleUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     CommandParameter="{Binding}"/>
            </StackPanel>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>
    </StackPanel>
    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsBackup, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <TextBlock Text="Backup &amp; Restore" Style="{StaticResource Settings.SectionTitle}"/>
      <Grid Margin="0,18,0,16">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Border Grid.Column="0" Padding="12" Background="{DynamicResource Brush.Hover.Subtle}" CornerRadius="8">
        <StackPanel><TextBlock Text="DB Health" FontSize="11"/><TextBlock Text="Integration Pending" FontWeight="SemiBold"/></StackPanel>
       </Border>
       <Border Grid.Column="2" Padding="12" Background="{DynamicResource Brush.Hover.Subtle}" CornerRadius="8">
        <StackPanel><TextBlock Text="Last Backup" FontSize="11"/><TextBlock Text="Preview Data" FontWeight="SemiBold"/></StackPanel>
       </Border>
       <Border Grid.Column="4" Padding="12" Background="{DynamicResource Brush.Hover.Subtle}" CornerRadius="8">
        <StackPanel><TextBlock Text="Cloud Backup" FontSize="11"/><TextBlock Text="Integration Pending" FontWeight="SemiBold"/></StackPanel>
       </Border>
       <Border Grid.Column="6" Padding="12" Background="{DynamicResource Brush.Hover.Subtle}" CornerRadius="8">
        <StackPanel><TextBlock Text="Automatic Backup" FontSize="11"/><TextBlock Text="Integration Pending" FontWeight="SemiBold"/></StackPanel>
       </Border>
      </Grid>
      <Grid Margin="0,0,0,16">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <TextBlock Text="Frequency" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <TextBlock Grid.Column="1" Text="Every 6 hours · Preview"
                  FontWeight="SemiBold" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button Content="Restore" Command="{Binding RestoreCommand}"
                Style="{StaticResource Button.Neutral}" Margin="0,0,8,0"/>
        <Button Content="Backup Now" Command="{Binding BackupNowCommand}"
                Style="{StaticResource Button.Primary}"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="Recent Backup History" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <DataGrid ItemsSource="{Binding Backups}" Style="{StaticResource Table.DataGrid}" Height="180">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding TimestampDisplay}" Width="*"/>
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="120"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Backup/restore execution remains a worker/backend responsibility and is not simulated as a successful real operation."
                 Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11"
                 Foreground="{DynamicResource Brush.Text.Muted}"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <Grid>
       <TextBlock Text="License" Style="{StaticResource Settings.SectionTitle}"/>
       <Button Content="Import New License" Command="{Binding ImportLicenseCommand}" Style="{StaticResource Button.Primary}"
               HorizontalAlignment="Right"/>
      </Grid>
      <Grid Margin="0,18,0,0">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170"/><ColumnDefinition Width="*"/>
       </Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
        <RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/>
       </Grid.RowDefinitions>
       <TextBlock Text="License ID" Grid.Row="0" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicenseId}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
       <TextBlock Text="Store" Grid.Row="1" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicenseStore}" Grid.Row="1" Grid.Column="1"/>
       <TextBlock Text="Module" Grid.Row="2" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicenseModule}" Grid.Row="2" Grid.Column="1"/>
       <TextBlock Text="Expiry" Grid.Row="3" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicenseExpiry}" Grid.Row="3" Grid.Column="1"/>
       <TextBlock Text="Terminals" Grid.Row="4" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicensedTerminals}" Grid.Row="4" Grid.Column="1"/>
       <TextBlock Text="Status" Grid.Row="5" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LicenseStatus}" Grid.Row="5" Grid.Column="1" FontWeight="SemiBold"
                  Foreground="{StaticResource Brush.Function.Warning}"/>
      </Grid>
     </StackPanel>
    </Border>
    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsAppearance, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <TextBlock Text="Appearance" Style="{StaticResource Settings.SectionTitle}"/>
      <TextBlock Text="Theme" Margin="0,18,0,5" FontSize="12"/>
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}"
                Style="{StaticResource Input.ComboBox}" Width="260" HorizontalAlignment="Left"/>
      <TextBlock Text="Light, Dark and System themes use the existing application theme service."
                 Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}"/>
      <Button Content="Apply" Command="{Binding ApplyThemeCommand}" Style="{StaticResource Button.Primary}"
              HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,0"/>
     </StackPanel>
    </Border>

    <Border Style="{StaticResource Card.Default}"
            Visibility="{Binding IsDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
     <StackPanel>
      <Grid>
       <TextBlock Text="PostgreSQL Diagnostics" Style="{StaticResource Settings.SectionTitle}"/>
       <Button Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}" Style="{StaticResource Button.Neutral}"
               HorizontalAlignment="Right"/>
      </Grid>
      <Grid Margin="0,18,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions>
        <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
        <RowDefinition Height="38"/><RowDefinition Height="38"/><RowDefinition Height="38"/>
       </Grid.RowDefinitions>
       <TextBlock Text="PostgreSQL" Grid.Row="0" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding DatabaseStatus}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>
       <TextBlock Text="Connection" Grid.Row="1" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding ConnectionStatus}" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
       <TextBlock Text="Database" Grid.Row="2" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding DatabaseName}" Grid.Row="2" Grid.Column="1"/>
       <TextBlock Text="Size" Grid.Row="3" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding DatabaseSize}" Grid.Row="3" Grid.Column="1"/>
       <TextBlock Text="Worker Service" Grid.Row="4" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding WorkerStatus}" Grid.Row="4" Grid.Column="1"/>
       <TextBlock Text="Last Backup" Grid.Row="5" Foreground="{DynamicResource Brush.Text.Muted}"/>
       <TextBlock Text="{Binding LastBackupDisplay}" Grid.Row="5" Grid.Column="1"/>
      </Grid>
      <Border Margin="0,14,0,0" Padding="12" Background="{DynamicResource Brush.Hover.Subtle}" CornerRadius="8">
       <TextBlock Text="Database diagnostics are read-only. PostgreSQL host, port, passwords and connection strings are intentionally not exposed."
                  TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}"/>
      </Border>
     </StackPanel>
    </Border>

   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>

<UserControl
    x:Class="EdgeRetails.Desktop.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:DashboardViewModel, IsDesignTimeCreatable=True}"
    Focusable="False">

    <UserControl.Resources>
        <!-- Icon Geometries -->
        <PathGeometry x:Key="Icon.Local.ChevronRight" Figures="M 1 1 L 5 5 L 1 9" />
        <PathGeometry x:Key="Icon.Local.ArrowRight" Figures="M 1 5 L 8 5 M 5 2 L 8 5 L 5 8" />

        <!-- Card Header Gradients -->
        <LinearGradientBrush x:Key="Gradient.CardHeader.Thaka" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F5F3FF" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Gradient.CardHeader.LowStock" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFBEB" Offset="0" />
            <GradientStop Color="#FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <!-- Compact Thaka "+ New" Button Style -->
        <Style x:Key="Button.Compact.ThakaNew" TargetType="Button">
            <Setter Property="Height" Value="21" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="#7C3AED" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#6D28D9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#5B21B6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thaka Card Footer "View All Projects" Button Style -->
        <Style x:Key="Button.CardFooter.Link" TargetType="Button">
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7C3AED" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,0,10,10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FAF7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thaka Row Interactive Button Style -->
        <Style x:Key="Button.ThakaRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="14,10.5"
                                SnapsToDevicePixels="True"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#F0F4F8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FBF9FE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F3EDFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  Padding="17.5">
        <StackPanel>
            <!-- 1. Command Header Banner (Height ~88px, Radius 12px) -->
            <Border MinHeight="88"
                    Margin="0,0,0,14"
                    Padding="21,14"
                    CornerRadius="{StaticResource Radius.Large}"
                    BorderThickness="1"
                    BorderBrush="#E4DFFA"
                    Effect="{StaticResource Shadow.Surface}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0" />
                        <GradientStop Color="#F8F6FF" Offset="0.6" />
                        <GradientStop Color="#F2F7FF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Greeting & Subtitle -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Base}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding Greeting, Mode=OneWay}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource Text.Base}"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="13"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Text="{Binding Subtitle, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Right: Current Date & Status Chips Row -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock HorizontalAlignment="Right"
                                   FontFamily="{StaticResource Font.Primary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                   Text="{Binding CurrentDateFormatted, Mode=OneWay}" />
                        <StackPanel Margin="0,5,0,0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <!-- Database status chip -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Border Width="5.25"
                                        Height="5.25"
                                        CornerRadius="999"
                                        Background="#10B981"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5.25,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4"
                                                          ShadowDepth="0"
                                                          Color="#10B981"
                                                          Opacity="0.5" />
                                    </Border.Effect>
                                </Border>
                                <TextBlock FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#0D9488"
                                           Text="{Binding DatabaseStatusText, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Backup status chip -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="5.25"
                                        Height="5.25"
                                        CornerRadius="999"
                                        Background="#3B82F6"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5.25,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4"
                                                          ShadowDepth="0"
                                                          Color="#3B82F6"
                                                          Opacity="0.5" />
                                    </Border.Effect>
                                </Border>
                                <TextBlock FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="#2563EB"
                                           Text="{Binding BackupStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. First KPI Row (4 cards, UniformGrid / 4-column Grid, height 98px, gap 14px) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:KpiCard Grid.Column="0"
                                  Height="98"
                                  Title="Today Sales"
                                  Value="{Binding TodaySales}"
                                  Tone="Brand"
                                  IconGeometry="{StaticResource Icon.Nav.NewSale}" />

                <controls:KpiCard Grid.Column="2"
                                  Height="98"
                                  Title="Today Profit"
                                  Value="{Binding TodayProfit}"
                                  Tone="Success"
                                  IconGeometry="{StaticResource Icon.Nav.Reports}" />

                <controls:KpiCard Grid.Column="4"
                                  Height="98"
                                  Title="Expenses"
                                  Value="{Binding Expenses}"
                                  Tone="Expense"
                                  IconGeometry="{StaticResource Icon.Nav.Expenses}" />

                <controls:KpiCard Grid.Column="6"
                                  Height="98"
                                  Title="Low Stock"
                                  Value="{Binding LowStockCount}"
                                  Tone="Warning"
                                  IconGeometry="{StaticResource Icon.Nav.Inventory}"
                                  ToolTip="{Binding LowStockSubtitle}" />
            </Grid>

            <!-- 3. Second KPI Row (Thaka / Projects, 3 cards, height 98px, gap 14px) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:KpiCard Grid.Column="0"
                                  Height="98"
                                  Title="Active Thakas"
                                  Value="{Binding ActiveThakasCount}"
                                  Tone="Thaka"
                                  IconGeometry="{StaticResource Icon.Nav.ThakaProjects}"
                                  ToolTip="{Binding ActiveThakasSubtitle}" />

                <controls:KpiCard Grid.Column="2"
                                  Height="98"
                                  Title="Thaka Value"
                                  Value="{Binding ThakaValue}"
                                  Tone="Thaka"
                                  IconGeometry="{StaticResource Icon.Nav.ThakaProjects}"
                                  ToolTip="{Binding ThakaValueSubtitle}" />

                <controls:KpiCard Grid.Column="4"
                                  Height="98"
                                  Title="Outstanding Balance"
                                  Value="{Binding OutstandingBalance}"
                                  Tone="Info"
                                  IconGeometry="{StaticResource Icon.Nav.Customers}"
                                  ToolTip="{Binding OutstandingBalanceSubtitle}" />
            </Grid>

            <!-- 4. Bottom 3-Column Section (3 cards side by side, gap 14px, height ~260-280px) -->
            <Grid MinHeight="260">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Thaka / Projects -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Gradient #F5F3FF to #FFFFFF, icon well, title, + New button -->
                        <Border Grid.Row="0"
                                CornerRadius="10,10,0,0"
                                Padding="14,10.5"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#EDE9FE"
                                Background="{StaticResource Gradient.CardHeader.Thaka}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Icon Well -->
                                <Border Grid.Column="0"
                                        Width="21"
                                        Height="21"
                                        CornerRadius="6"
                                        Background="#EDE9FE"
                                        VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Nav.ThakaProjects}"
                                          Width="13"
                                          Height="13"
                                          Stretch="Uniform"
                                          Stroke="#7C3AED"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center" />
                                </Border>

                                <!-- Title -->
                                <TextBlock Grid.Column="1"
                                           Margin="7,0,0,0"
                                           Text="THAKA / PROJECTS"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#7C3AED"
                                           VerticalAlignment="Center" />

                                <!-- + New Button -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource Button.Compact.ThakaNew}"
                                        Content="+ New"
                                        Command="{Binding NewThakaCommand}" />
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding ThakaProjects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.ThakaRow}"
                                            Command="{Binding DataContext.OpenThakaItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProjectName}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0A2540" />
                                                <TextBlock Margin="0,1.5,0,0"
                                                           Text="{Binding CustomerName}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="11"
                                                           Foreground="#8898AA" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding BalanceFormatted}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#0A2540"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="10"
                                                           Foreground="#8898AA"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>

                                            <Path Grid.Column="2"
                                                  Data="{StaticResource Icon.Local.ChevronRight}"
                                                  Stroke="#8898AA"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Width="6"
                                                  Height="10"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,0,0" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Footer: "View All Projects" -->
                        <Border Grid.Row="2"
                                BorderThickness="0,1,0,0"
                                BorderBrush="#F0F4F8">
                            <Button Style="{StaticResource Button.CardFooter.Link}"
                                    Command="{Binding ViewAllProjectsCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="View All Projects"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#7C3AED" />
                                    <Path Data="{StaticResource Icon.Local.ArrowRight}"
                                          Stroke="#7C3AED"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="9"
                                          Height="10"
                                          VerticalAlignment="Center"
                                          Margin="5,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </Grid>
                </Border>

                <!-- Card 2: Recent Activity -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                CornerRadius="10,10,0,0"
                                Padding="14,12"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                Background="{DynamicResource Brush.Surface.Raised}">
                            <TextBlock Text="RECENT ACTIVITY"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#425466"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Items List -->
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding RecentActivities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="#F0F4F8"
                                            Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Dot Indicator -->
                                            <Border Grid.Column="0"
                                                    Width="7"
                                                    Height="7"
                                                    CornerRadius="999"
                                                    Background="{Binding DotBrush}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="13"
                                                       Foreground="#0A2540"
                                                       VerticalAlignment="Center" />

                                            <!-- Time -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TimeFormatted}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="11"
                                                       Foreground="#8898AA"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0" />

                                            <!-- Amount -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding AmountFormatted}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0A2540"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- Card 3: Low Stock -->
                <Border Grid.Column="4"
                        Background="{DynamicResource Brush.Surface.Raised}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                CornerRadius="10,10,0,0"
                                Padding="14,10.5"
                                BorderThickness="0,0,0,1"
                                BorderBrush="#FEF3C7"
                                Background="{StaticResource Gradient.CardHeader.LowStock}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="LOW STOCK"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#D97706"
                                           VerticalAlignment="Center" />

                                <controls:StatusBadge Grid.Column="1"
                                                      Tone="Warning"
                                                      Text="{Binding LowStockCount}"
                                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Items List -->
                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding LowStockItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="#F0F4F8"
                                            Padding="14,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Amber Dot Indicator -->
                                            <Border Grid.Column="0"
                                                    Width="7"
                                                    Height="7"
                                                    CornerRadius="999"
                                                    Background="#FCD34D"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0" />

                                            <!-- Product Name -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ProductName}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="13"
                                                       Foreground="#0A2540"
                                                       VerticalAlignment="Center" />

                                            <!-- Stock Badge -->
                                            <controls:StatusBadge Grid.Column="2"
                                                                  Tone="Warning"
                                                                  Text="{Binding StockBadgeText}"
                                                                  VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

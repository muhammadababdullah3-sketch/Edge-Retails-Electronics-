<UserControl x:Class="EdgeRetails.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
             xmlns:converters="clr-namespace:EdgeRetails.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:LoginViewModel, IsDesignTimeCreatable=True}"
             Focusable="True"
             Background="{DynamicResource Brush.App.Background}" Foreground="{DynamicResource Brush.Text.Primary}">

    <UserControl.Resources>
        <!--
            Account viewport height governor.

            Only the account list is allowed to give up height when the window is short. The card
            chrome below the list (PIN boxes, helper text, keypad, sign-in) is a fixed ~543.5px, so
            the list is clamped to that remainder, capped at 220px so a tall window cannot push the
            keypad out of view, and floored so a short window still shows a usable account card.
            This is what keeps the PIN keypad reachable without scrolling the whole login surface.
        -->
        <converters:HeightOffsetConverter x:Key="Converter.AccountViewportHeight" />

        <!-- Keypad standard button style -->
        <Style x:Key="Style.KeypadButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Soft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Main Screen Surface with Soft Ambient Radial Gradients -->
    <Grid>
        <Grid.Background>
            <DynamicResource ResourceKey="Gradient.Login.Background" />
        </Grid.Background>

        <!-- Ambient decorative blur spots (Figma 14:7 & 14:8) -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="500" Height="400"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="140,60,0,0"
                     Opacity="0.25">
                <Ellipse.Fill>
                    <DynamicResource ResourceKey="Gradient.Login.Glow.Brand" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="60" />
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Width="400" Height="350"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,120,60"
                     Opacity="0.18">
                <Ellipse.Fill>
                    <DynamicResource ResourceKey="Gradient.Login.Glow.Info" />
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <BlurEffect Radius="60" />
                </Ellipse.Effect>
            </Ellipse>
        </Grid>

        <!--
            Centered login surface.

            This container deliberately does NOT scroll the whole login. The card is sized so that
            the header, PIN boxes, keypad and sign-in button always remain on screen; only the
            account list inside the card is a bounded scroll region. The scroll viewer is retained
            purely as a last-resort safety net for windows below the supported minimum, and must
            never engage at a supported size.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Outer Border: Ambient Purple Drop Shadow -->
                <Border Width="400"
                        Margin="24"
                        CornerRadius="16"
                        Background="Transparent">
                    <Border.Effect>
                        <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="32" ShadowDepth="8" Opacity="0.13" Direction="270" />
                    </Border.Effect>

                    <!-- Inner Border: Crisp Surface & Contact Drop Shadow -->
                    <Border Background="{DynamicResource Brush.Surface.Default}"
                            BorderBrush="{DynamicResource Brush.Border.Soft}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="28">
                        <Border.Effect>
                            <DropShadowEffect Color="{StaticResource Color.Shadow.Deep}" BlurRadius="8" ShadowDepth="2" Opacity="0.08" Direction="270" />
                        </Border.Effect>

                        <StackPanel Width="342" HorizontalAlignment="Center">
                            <!-- 1. Header Section -->
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Image Source="{StaticResource Brand.Mark}" Width="40" Height="40"/><TextBlock Text="Edge Retails" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.PageTitle}" Foreground="{DynamicResource Brush.Text.Primary}"/></StackPanel>

                                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="EdgeRetails POS"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,7,0,0" />

                                <!-- Subtitle: Select your account to continue -->
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="Select your account to continue"
                                           FontFamily="{StaticResource Font.Primary}"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <!--
                                2. Account Selector — the ONLY scrollable region on the login.

                                The viewport is height-bounded to whatever vertical space is left
                                after the fixed card chrome (PIN boxes, helper text, keypad,
                                sign-in) has been accounted for, and is capped at 220px so a tall
                                window cannot grow the list to the point where the keypad leaves
                                the visible area. Only the account boxes scroll; the login shell,
                                selected account, PIN keypad, sign-in and error context stay put.

                                Hiding or suspending accounts is explicitly NOT an acceptable way
                                to satisfy this bound, so every loaded account remains in the
                                collection and reachable by scrolling.
                            -->
                            <ScrollViewer Height="{Binding ActualHeight,
                                                   RelativeSource={RelativeSource AncestorType=UserControl},
                                                   Converter={StaticResource Converter.AccountViewportHeight},
                                                   ConverterParameter='566:220'}"
                                          MinHeight="44"
                                          Margin="0,21,0,0"
                                          Width="342"
                                          HorizontalAlignment="Center"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          PanningMode="VerticalOnly"
                                          CanContentScroll="True">
                                <ItemsControl ItemsSource="{Binding Accounts}"
                                              Width="342"
                                              Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:LoginAccountItemViewModel}">
                                        <Button Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,0,7"
                                                Cursor="Hand"
                                                FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="CardBorder"
                                                            Width="342"
                                                            Padding="14,10.5"
                                                            CornerRadius="10"
                                                            BorderThickness="1"
                                                            BorderBrush="{DynamicResource Brush.Border.Default}"
                                                            Background="{DynamicResource Brush.Surface.Default}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Left Avatar Circle (31.5px) -->
                                                            <Border x:Name="AvatarBorder"
                                                                    Grid.Column="0"
                                                                    Width="31.5"
                                                                    Height="31.5"
                                                                    CornerRadius="999"
                                                                    Background="{DynamicResource Brush.Surface.Subtle}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Text.Control}" x:Name="AvatarText"
                                                                           Text="{Binding AvatarLetter}"
                                                                           FontFamily="{StaticResource Font.Primary}"
                                                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Middle Info (Name & Role) -->
                                                            <StackPanel Grid.Column="1"
                                                                        Margin="10.5,0,0,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DisplayName}"
                                                                           FontFamily="{StaticResource Font.Primary}"
                                                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                                                <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding RoleName}"
                                                                           FontFamily="{StaticResource Font.Primary}"
                                                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Right Selected Checkmark Badge (14x14) -->
                                                            <Border x:Name="CheckBadge"
                                                                    Grid.Column="2"
                                                                    Width="14"
                                                                    Height="14"
                                                                    CornerRadius="999"
                                                                    Background="{DynamicResource Brush.Brand.Primary}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="Collapsed">
                                                                <Path Data="M 3.5 7 L 6 9.5 L 10.5 4.5"
                                                                      Stroke="{StaticResource Brush.White}"
                                                                      StrokeThickness="1.5"
                                                                      StrokeStartLineCap="Round"
                                                                      StrokeEndLineCap="Round"
                                                                      StrokeLineJoin="Round"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!-- Brand avatar for primary account -->
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter TargetName="AvatarBorder" Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                                            <Setter TargetName="AvatarBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="AvatarText" Property="Foreground" Value="{StaticResource Brush.White}" />
                                                        </DataTrigger>

                                                        <!-- Selected state styling -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="CardBorder"
                                                                    Property="Background"
                                                                    Value="{DynamicResource Gradient.Kpi.Brand}" />
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                                            <Setter TargetName="CardBorder" Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="6" ShadowDepth="0" Opacity="0.18" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>

                                                        <!-- Hover when unselected -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Soft}" />
                                                        </MultiDataTrigger>

                                                        <!-- Keyboard focus when unselected -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsKeyboardFocused}" Value="True" />
                                                                <Condition Binding="{Binding IsSelected}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.Surface.Subtle}" />
                                                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                        </MultiDataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>

                            <!-- 3. PIN Entry Section -->
                            <StackPanel Margin="0,21,0,0" HorizontalAlignment="Center">
                                <!-- 4 PIN Boxes (38.5x38.5px, radius 9px, gap 10.5px) with Error Shake -->
                                <StackPanel x:Name="PinBoxesRow"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="PinBoxesTranslate" X="0" Y="0" />
                                    </StackPanel.RenderTransform>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.00" Value="0" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.05" Value="-10" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.10" Value="10" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.15" Value="-8" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.20" Value="8" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.25" Value="-5" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="5" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.35" Value="-2" />
                                                                    <LinearDoubleKeyFrame KeyTime="0:0:0.40" Value="0" />
                                                                </DoubleAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- PIN Box 1 -->
                                    <Border Width="38.5" Height="38.5" CornerRadius="9" BorderThickness="2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDigit1Filled}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                                        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit1Filled}" Value="True" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Danger}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit1Filled}" Value="False" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="8.75" Height="8.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDigit1Filled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDigit1Filled}" Value="True" />
                                                                <Condition Binding="{Binding HasError}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>

                                    <!-- PIN Box 2 -->
                                    <Border Width="38.5" Height="38.5" CornerRadius="9" BorderThickness="2" Margin="10.5,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDigit2Filled}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                                        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit2Filled}" Value="True" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Danger}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit2Filled}" Value="False" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="8.75" Height="8.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDigit2Filled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDigit2Filled}" Value="True" />
                                                                <Condition Binding="{Binding HasError}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>

                                    <!-- PIN Box 3 -->
                                    <Border Width="38.5" Height="38.5" CornerRadius="9" BorderThickness="2" Margin="10.5,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDigit3Filled}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                                        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit3Filled}" Value="True" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Danger}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit3Filled}" Value="False" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="8.75" Height="8.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDigit3Filled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDigit3Filled}" Value="True" />
                                                                <Condition Binding="{Binding HasError}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>

                                    <!-- PIN Box 4 -->
                                    <Border Width="38.5" Height="38.5" CornerRadius="9" BorderThickness="2" Margin="10.5,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDigit4Filled}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}" />
                                                        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit4Filled}" Value="True" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="{StaticResource Color.Danger}" BlurRadius="8" ShadowDepth="2" Opacity="0.30" Direction="270" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsDigit4Filled}" Value="False" />
                                                            <Condition Binding="{Binding HasError}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Badge.Danger.Border}" />
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Ellipse Width="8.75" Height="8.75" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.White}" />
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDigit4Filled}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsDigit4Filled}" Value="True" />
                                                                <Condition Binding="{Binding HasError}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Border>
                                </StackPanel>

                                <!-- Helper / Error Text -->
                                <TextBlock Text="{Binding HelperText}"
                                           FontFamily="{StaticResource Font.Primary}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Width="342"
                                           Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Danger.Text}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- 4. Keypad Grid (Width 342px, 3x4 grid, 7px gap) -->
                            <Grid Margin="0,14,0,0" Width="342">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="7" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>

                                <!-- Row 1: 1, 2, 3 -->
                                <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="1" />
                                <Button Grid.Row="0" Grid.Column="2" Content="2" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="2" />
                                <Button Grid.Row="0" Grid.Column="4" Content="3" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="3" />

                                <!-- Row 2: 4, 5, 6 -->
                                <Button Grid.Row="2" Grid.Column="0" Content="4" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="4" />
                                <Button Grid.Row="2" Grid.Column="2" Content="5" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="5" />
                                <Button Grid.Row="2" Grid.Column="4" Content="6" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="6" />

                                <!-- Row 3: 7, 8, 9 -->
                                <Button Grid.Row="4" Grid.Column="0" Content="7" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="7" />
                                <Button Grid.Row="4" Grid.Column="2" Content="8" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="8" />
                                <Button Grid.Row="4" Grid.Column="4" Content="9" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="9" />

                                <!-- Row 4: C, 0, ⌫ -->
                                <Button Grid.Row="6" Grid.Column="0" Content="C" Style="{StaticResource Style.KeypadButton}"
                                        Foreground="{DynamicResource Brush.Text.Muted}"
                                        Command="{Binding ClearCommand}" />
                                <Button Grid.Row="6" Grid.Column="2" Content="0" Style="{StaticResource Style.KeypadButton}"
                                        Command="{Binding AppendDigitCommand}" CommandParameter="0" />
                                <Button Grid.Row="6" Grid.Column="4" Content="⌫" Style="{StaticResource Style.KeypadButton}"
                                        Foreground="{DynamicResource Brush.Text.Muted}"
                                        Command="{Binding BackspaceCommand}" />
                            </Grid>

                            <!-- 5. Sign In Button (Width 342px, Height 42px, Radius 10px) -->
                            <Button Width="342"
                                    Height="42"
                                    Margin="0,14,0,0"
                                    Command="{Binding SignInCommand}"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnRoot"
                                                CornerRadius="10"
                                                Background="{StaticResource Gradient.Brand.Primary}"
                                                SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{StaticResource Color.Brand.Primary}" BlurRadius="12" ShadowDepth="3" Opacity="0.35" Direction="270" />
                                            </Border.Effect>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Default Button Label -->
                                                <TextBlock Style="{StaticResource Text.Control}" x:Name="BtnText"
                                                           Text="SIGN IN"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           Foreground="{StaticResource Brush.White}" />

                                                <!-- Signing In Animated Indicator -->
                                                <StackPanel x:Name="LoadingPanel"
                                                            Orientation="Horizontal"
                                                            Visibility="Collapsed">
                                                    <Path Data="M 0 6 A 6 6 0 1 1 12 6"
                                                          Stroke="{StaticResource Brush.White}"
                                                          StrokeThickness="2"
                                                          Width="12"
                                                          Height="12"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                                        </Path.RenderTransform>
                                                        <Path.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                                         Storyboard.TargetProperty="Angle"
                                                                                         From="0" To="360"
                                                                                         Duration="0:0:0.8" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Path.Triggers>
                                                    </Path>
                                                    <TextBlock Style="{StaticResource Text.Control}" Text="SIGNING IN..."
                                                               FontFamily="{StaticResource Font.Primary}"
                                                               Foreground="{StaticResource Brush.White}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnRoot" Property="Background" Value="{StaticResource Gradient.Brand.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="BtnRoot" Property="Background" Value="{StaticResource Gradient.Brand.Pressed}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="BtnRoot" Property="Opacity" Value="0.5" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSigningIn}" Value="True">
                                                <Setter TargetName="BtnText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="LoadingPanel" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="EdgeRetails.Desktop.Views.ReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    Background="{DynamicResource Brush.App.Background}">

    <UserControl.Resources>
        <Style x:Key="Report.TabButton" TargetType="Button" BasedOn="{StaticResource Button.Neutral}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Brand.Primary}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Report.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>

        <Style x:Key="Report.Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="20"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1360">

            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Reports"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding PeriodLabel}"
                               Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Neutral}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource Card.Default}"
                    Margin="0,0,0,16"
                    Padding="14">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Daily"
                                Tag="{Binding IsDaily}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="Daily"
                                Style="{StaticResource Report.TabButton}" />
                        <Button Content="Monthly"
                                Tag="{Binding IsMonthly}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="Monthly"
                                Style="{StaticResource Report.TabButton}" />
                        <Button Content="Yearly"
                                Tag="{Binding IsYearly}"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="Yearly"
                                Style="{StaticResource Report.TabButton}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding SelectedDate}"
                                    Width="150"
                                    Height="32"
                                    Visibility="{Binding IsDateSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ComboBox ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding SelectedMonth}"
                                  Width="130"
                                  Height="32"
                                  VerticalContentAlignment="Center"
                                  Margin="0,0,7,0"
                                  Visibility="{Binding IsMonthSelectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <ComboBox ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}"
                                  Width="90"
                                  Height="32"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Visibility="{Binding ShowSecondaryKpis, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="98" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="98" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:KpiCard Grid.Row="0"
                                  Grid.Column="0"
                                  Title="NET LOCAL SALES"
                                  Value="{Binding NetSalesDisplay}"
                                  Tone="Brand"
                                  IconGeometry="{StaticResource Icon.Nav.NewSale}" />

                <controls:KpiCard Grid.Row="0"
                                  Grid.Column="2"
                                  Title="GROSS PROFIT"
                                  Value="{Binding GrossProfitDisplay}"
                                  Tone="Success"
                                  IconGeometry="{StaticResource Icon.Nav.Reports}" />

                <controls:KpiCard Grid.Row="0"
                                  Grid.Column="4"
                                  Title="TOTAL EXPENSES"
                                  Value="{Binding ExpensesDisplay}"
                                  Tone="Expense"
                                  IconGeometry="{StaticResource Icon.Nav.Expenses}" />

                <controls:KpiCard Grid.Row="2"
                                  Grid.Column="0"
                                  Title="NET PROFIT"
                                  Value="{Binding NetProfitDisplay}"
                                  Tone="Success"
                                  IconGeometry="{StaticResource Icon.Nav.Reports}" />

                <controls:KpiCard Grid.Row="2"
                                  Grid.Column="2"
                                  Title="TOTAL PURCHASES"
                                  Value="{Binding PurchasesDisplay}"
                                  Tone="Info"
                                  IconGeometry="{StaticResource Icon.Nav.Purchases}" />

                <controls:KpiCard Grid.Row="2"
                                  Grid.Column="4"
                                  Title="THAKA MATERIAL"
                                  Value="{Binding ThakaMaterialDisplay}"
                                  Tone="Thaka"
                                  IconGeometry="{StaticResource Icon.Nav.ThakaProjects}" />
            </Grid>

            <Grid Visibility="{Binding IsYearly, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <controls:KpiCard Grid.Column="0"
                                  Height="98"
                                  Title="NET LOCAL SALES"
                                  Value="{Binding NetSalesDisplay}"
                                  Tone="Brand"
                                  IconGeometry="{StaticResource Icon.Nav.NewSale}" />

                <controls:KpiCard Grid.Column="2"
                                  Height="98"
                                  Title="NET PROFIT"
                                  Value="{Binding NetProfitDisplay}"
                                  Tone="Success"
                                  IconGeometry="{StaticResource Icon.Nav.Reports}" />

                <controls:KpiCard Grid.Column="4"
                                  Height="98"
                                  Title="EXPENSES"
                                  Value="{Binding ExpensesDisplay}"
                                  Tone="Expense"
                                  IconGeometry="{StaticResource Icon.Nav.Expenses}" />

                <controls:KpiCard Grid.Column="6"
                                  Height="98"
                                  Title="THAKA MATERIAL"
                                  Value="{Binding ThakaMaterialDisplay}"
                                  Tone="Thaka"
                                  IconGeometry="{StaticResource Icon.Nav.ThakaProjects}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding AverageMetrics}"
                          Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,10,0" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card.Default}"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource Report.Caption}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Value}"
                                           Margin="0,5,0,0"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card.Default}"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="310" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel>
                            <TextBlock Text="{Binding ChartTitle}"
                                       Style="{StaticResource Report.SectionTitle}" />
                            <TextBlock Text="{Binding ChartSubtitle}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                        </StackPanel>
                    </Grid>

                    <controls:FinancialTrendChart Grid.Row="2"
                                                  Points="{Binding Trend}"
                                                  ShowExpenses="{Binding ShowExpenseSeries}"
                                                  ProfitSeriesLabel="{Binding ProfitSeriesLabel}" />
                </Grid>
            </Border>

            <Grid Visibility="{Binding IsMonthly, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Card.Default}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Expense Breakdown"
                                   Style="{StaticResource Report.SectionTitle}" />
                        <TextBlock Text="Operating expenses by category"
                                   Margin="0,3,0,12"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />

                        <ItemsControl ItemsSource="{Binding ExpenseBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <TextBlock Text="{Binding AmountDisplay}"
                                                       FontFamily="{StaticResource Font.Numeric}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding ShareDisplay}"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </StackPanel>

                                        <ProgressBar Grid.Row="1"
                                                     Grid.ColumnSpan="2"
                                                     Minimum="0"
                                                     Maximum="1"
                                                     Value="{Binding Share}"
                                                     Height="4"
                                                     BorderThickness="0"
                                                     Foreground="{StaticResource Brush.Function.Expense}"
                                                     Background="{DynamicResource Brush.Surface.Subtle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="No expenses recorded in this month."
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card.Default}"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Thaka Activity"
                                   Style="{StaticResource Report.SectionTitle}" />
                        <TextBlock Text="Material issues remain separate from local sales"
                                   Margin="0,3,0,12"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />

                        <ItemsControl ItemsSource="{Binding ThakaActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding ProjectName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding IssueCountDisplay}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MaterialValueDisplay}"
                                                   FontFamily="{StaticResource Font.Numeric}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Thaka}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
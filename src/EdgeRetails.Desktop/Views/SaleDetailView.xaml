<UserControl
    x:Class="EdgeRetails.Desktop.Views.SaleDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:EdgeRetails.Desktop.Controls"
    xmlns:dialogs="clr-namespace:EdgeRetails.Desktop.Views.Dialogs"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:SaleDetailViewModel}"
    Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Back Arrow Icon -->
        <PathGeometry x:Key="Icon.Local.ArrowLeft" Figures="M 9 1 L 2 8 L 9 15 M 2 8 L 16 8" />

        <!-- Printer Icon -->
        <PathGeometry x:Key="Icon.Local.Printer"
                      Figures="M 4 7 L 4 2 L 14 2 L 14 7 M 4 13 L 2 13 C 1.45 13 1 12.55 1 12 L 1 8 C 1 7.45 1.45 7 2 7 L 16 7 C 16.55 7 17 7.45 17 8 L 17 12 C 17 12.55 16.55 13 16 13 L 14 13 M 4 10 L 14 10 L 14 17 L 4 17 Z" />

        <!-- Return / Undo Icon -->
        <PathGeometry x:Key="Icon.Local.Return"
                      Figures="M 2 7 L 7 2 M 2 7 L 7 12 M 3 7 L 11 7 C 14.3 7 17 9.7 17 13 C 17 16.3 14.3 19 11 19 L 8 19" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.App.Background}">
        <!-- Main Content Area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="20">
            <StackPanel MaxWidth="{StaticResource Container.MaxWidth.Detail}" HorizontalAlignment="Stretch">

                <!-- 1. Breadcrumb and Header Actions Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Back Navigation and Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding BackCommand}"
                                Style="{StaticResource Button.Neutral}"
                                Height="36"
                                Padding="10,0"
                                Margin="0,0,14,0"
                                ToolTip="Back to Sales History">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource Icon.Local.ArrowLeft}"
                                      Stroke="{DynamicResource Brush.Text.Primary}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Margin="0,0,6,0" />
                                <TextBlock Text="Back"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sales History"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock Text=" / "
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           Margin="4,0" />
                                <TextBlock Text="{Binding InvoiceDisplay, Mode=OneWay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}" />

                                <controls:StatusBadge Margin="12,0,0,0"
                                                      Text="{Binding Status}"
                                                      Tone="{Binding StatusTone}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Action Buttons (Print Receipt & Return Items) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Print Receipt Button -->
                        <Button Command="{Binding PrintReceiptCommand}"
                                Style="{StaticResource Button.Neutral}"
                                Height="36"
                                Padding="14,0"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="15"
                                      Height="15"
                                      Data="{StaticResource Icon.Local.Printer}"
                                      Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Print Receipt"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Return Items Button -->
                        <Button Command="{Binding ReturnItemsCommand}"
                                Height="36"
                                Padding="14,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Badge.Warning.Background}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Function.Warning}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Badge.Warning.Text}" />
                                    <Setter Property="Effect" Value="{StaticResource Shadow.Button.Neutral}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.4" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource Icon.Local.Return}"
                                      Stroke="{DynamicResource Brush.Badge.Warning.Text}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform"
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="Return Items"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. Invoice Metadata Card (4-column grid) -->
                <Border Margin="0,0,0,16"
                        Padding="18,14"
                        Background="{DynamicResource Brush.Surface.Default}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Invoice Number -->
                        <StackPanel Grid.Column="0" Margin="10,0">
                            <TextBlock Text="INVOICE NUMBER"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding InvoiceDisplay, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Numeric}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <!-- Sep 1 -->
                        <Border Grid.Column="1" Background="{DynamicResource Brush.Border.Default}" />

                        <!-- Col 2: Date & Time -->
                        <StackPanel Grid.Column="2" Margin="14,0">
                            <TextBlock Text="DATE &amp; TIME"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}">
                                <Run Text="{Binding DateDisplay, Mode=OneWay}" />
                                <Run Text=" · " Foreground="{DynamicResource Brush.Text.Muted}" />
                                <Run Text="{Binding TimeDisplay, Mode=OneWay}" Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Sep 2 -->
                        <Border Grid.Column="3" Background="{DynamicResource Brush.Border.Default}" />

                        <!-- Col 4: Cashier -->
                        <StackPanel Grid.Column="4" Margin="14,0">
                            <TextBlock Text="CASHIER"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding CashierName, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>

                        <!-- Sep 3 -->
                        <Border Grid.Column="5" Background="{DynamicResource Brush.Border.Default}" />

                        <!-- Col 6: Customer -->
                        <StackPanel Grid.Column="6" Margin="14,0">
                            <TextBlock Text="CUSTOMER"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding CustomerDisplay, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Sep 4 -->
                        <Border Grid.Column="7" Background="{DynamicResource Brush.Border.Default}" />

                        <!-- Col 8: Payment Method -->
                        <StackPanel Grid.Column="8" Margin="14,0">
                            <TextBlock Text="PAYMENT METHOD"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding PaymentMethod, Mode=OneWay}"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Line Items Section Card -->
                <Border Margin="0,0,0,16"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        Background="{DynamicResource Brush.Surface.Default}"
                        Effect="{StaticResource Shadow.Surface}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Section Title -->
                        <Border Grid.Row="0"
                                Padding="16,12"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="0,0,0,1"
                                Background="{DynamicResource Brush.Table.Header}">
                            <Grid>
                                <TextBlock Text="LINE ITEMS"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LineItems.Count, StringFormat={}{0} items}"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Read-only DataGrid for Line Items -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding LineItems}"
                                  Style="{StaticResource Table.DataGrid}"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  MinHeight="140">
                            <DataGrid.Columns>
                                <!-- Line # -->
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding LineNumber}"
                                                    Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Product Name / SKU -->
                                <DataGridTemplateColumn Header="PRODUCT NAME / SKU" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                                <TextBlock Margin="0,1,0,0"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.Text.Muted}">
                                                    <Run Text="{Binding Brand}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding SkuDisplay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Price -->
                                <DataGridTextColumn Header="UNIT PRICE"
                                                    Binding="{Binding UnitPriceDisplay}"
                                                    Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
                                            <Setter Property="FontSize" Value="13.5" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Quantity -->
                                <DataGridTextColumn Header="QUANTITY"
                                                    Binding="{Binding QuantityDisplay}"
                                                    Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
                                            <Setter Property="FontSize" Value="13.5" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Discount -->
                                <DataGridTextColumn Header="DISCOUNT"
                                                    Binding="{Binding DiscountDisplay}"
                                                    Width="1.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Line Total -->
                                <DataGridTextColumn Header="LINE TOTAL"
                                                    Binding="{Binding LineTotalDisplay}"
                                                    Width="1.5*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Table.TextCell}">
                                            <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 4. Financial Summary Breakdown Card (Bottom Grid) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Returns Status Banner if any returns have occurred -->
                    <Border Grid.Column="0"
                            Margin="0,0,20,0"
                            Padding="16"
                            Background="{DynamicResource Brush.Badge.Warning.Background}"
                            BorderBrush="{DynamicResource Brush.Badge.Warning.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasReturns, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="RETURNS PROCESSED"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Primary}">
                                <Run Text="A total return refund of " />
                                <Run Text="{Binding TotalReturnedDisplay, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Brush.Function.Expense}" />
                                <Run Text=" has been processed against this invoice." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Right: Financial Breakdown Card -->
                    <Border Grid.Column="1"
                            Padding="20,16"
                            Background="{DynamicResource Brush.Surface.Default}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Effect="{StaticResource Shadow.Surface}">
                        <StackPanel>
                            <TextBlock Text="FINANCIAL TOTALS"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,0,0,12" />

                            <!-- Subtotal -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Subtotal"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding SubtotalDisplay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Discount -->
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Discount"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13.5"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding DiscountDisplay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1"
                                    Background="{DynamicResource Brush.Border.Default}"
                                    Margin="0,4,0,10" />

                            <!-- Grand Total -->
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Grand Total"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GrandTotalDisplay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Brand.Primary}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Divider -->
                            <Border Height="1"
                                    Background="{DynamicResource Brush.Border.Default}"
                                    Margin="0,0,0,10" />

                            <!-- Payment Received -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Payment Received"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding PaymentReceivedDisplay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Change Returned -->
                            <Grid>
                                <TextBlock Text="Change Returned"
                                           FontFamily="{StaticResource Font.Primary}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                <TextBlock Text="{Binding ChangeReturnedDisplay}"
                                           FontFamily="{StaticResource Font.Numeric}"
                                           FontSize="13.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 5. Slide-in Sales Return Drawer Overlay (Anchored to the right ~480px) -->
        <Grid Visibility="{Binding IsReturnDrawerOpen, Converter={StaticResource BoolToVis}}"
              Focusable="False">
            <!-- Semi-transparent Scrim Overlay -->
            <Border Background="{DynamicResource Brush.Overlay.Scrim}" />

            <!-- 480px Right Slide Drawer -->
            <Border Width="480"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource Brush.Surface.Raised}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1,0,0,0"
                    Effect="{StaticResource Shadow.Card}">
                <dialogs:SalesReturnDialog DataContext="{Binding ActiveReturnViewModel}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>

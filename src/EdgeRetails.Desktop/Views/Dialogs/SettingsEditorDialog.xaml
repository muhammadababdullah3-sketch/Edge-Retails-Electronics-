<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SettingsEditorDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Width="520" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Content="✕" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Text.Neutral}"
            HorizontalAlignment="Right"/>
   </Grid>

   <StackPanel Margin="0,18,0,0"
      Visibility="{Binding IsUser, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Name" Margin="0,0,0,5" FontSize="12"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource Input.TextBox}"/>
    <Grid Margin="0,14,0,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="14"/>
      <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Role" Margin="0,0,0,5" FontSize="12"/>
      <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"
                Style="{StaticResource Input.ComboBox}"/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Status" Margin="0,0,0,5" FontSize="12"/>
      <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"
                Style="{StaticResource Input.ComboBox}"/>
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding PinLabel}"
               Margin="0,14,0,5" FontSize="12"/>
    <PasswordBox PasswordChanged="OnPinPasswordChanged"
                 Height="{StaticResource Dimension.Control.Standard}"
                 Padding="{StaticResource Padding.Input.Standard}"
                 Background="{DynamicResource Brush.Input.Background}"
                 Foreground="{DynamicResource Brush.Text.Primary}"
                 BorderBrush="{DynamicResource Brush.Border.Default}"
                 BorderThickness="1"
                 FontFamily="{StaticResource Font.Primary}"
                 FontSize="14"/>
    <TextBlock Text="PIN is transient in this frontend shell and is not persisted as plaintext."
               Margin="0,5,0,0" FontSize="11"
               Foreground="{DynamicResource Brush.Text.Muted}"/>
   </StackPanel>

   <StackPanel Margin="0,18,0,0"
      Visibility="{Binding IsCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Category Name" Margin="0,0,0,5" FontSize="12"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource Input.TextBox}"/>
   </StackPanel>

   <StackPanel Margin="0,18,0,0"
      Visibility="{Binding IsUnit, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Unit Name" Margin="0,0,0,5" FontSize="12"/>
    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource Input.TextBox}"/>
    <TextBlock Text="Symbol" Margin="0,14,0,5" FontSize="12"/>
    <TextBox Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
             Style="{StaticResource Input.TextBox}"/>
   </StackPanel>

   <StackPanel Margin="0,18,0,0"
      Visibility="{Binding IsLicenseImport, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Select your license file (.lic or .key) to import and activate."
               TextWrapping="Wrap" FontSize="12"
               Foreground="{DynamicResource Brush.Text.Secondary}"/>
    <TextBlock Text="License File" Margin="0,14,0,5" FontSize="12"/>
    <Grid>
     <TextBox Text="{Binding FilePath}"
              Style="{StaticResource Input.TextBox}" Margin="0,0,100,0"
              IsReadOnly="True"/>
     <Button Content="Browse" Command="{Binding BrowseLicenseFileCommand}"
             Style="{StaticResource Button.Neutral}" Width="92"
             HorizontalAlignment="Right"/>
    </Grid>
    <TextBlock Text=".lic or .key format" Margin="0,5,0,0" FontSize="11"
               Foreground="{DynamicResource Brush.Text.Muted}"/>
    <Border Margin="0,14,0,0" Padding="12"
            Background="{DynamicResource Brush.Selection.Subtle}"
            CornerRadius="8">
     <TextBlock Text="License verification and activation remain backend responsibilities. This dialog validates only the frontend workflow."
                TextWrapping="Wrap" FontSize="11"
                Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </Border>
   </StackPanel>

   <Grid Margin="0,20,0,0">
    <Button Content="Cancel" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Neutral}" HorizontalAlignment="Left"/>
    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}"
            Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
            Height="38" Padding="18,0"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>

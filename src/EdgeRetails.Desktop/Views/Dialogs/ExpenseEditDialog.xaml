<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.ExpenseEditDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
 <Border Width="520" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Content="✕" Command="{Binding CancelCommand}" Style="{StaticResource Button.Text.Neutral}" IsCancel="True" HorizontalAlignment="Right"/></Grid>
   <Grid Margin="0,16,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Category" Margin="0,0,0,5" FontSize="12"/><ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="35"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Subcategory *" Margin="0,0,0,5" FontSize="12"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Subcategory, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
   </Grid>
   <Grid Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Amount (Rs.) *" Margin="0,0,0,5" FontSize="12"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Date" Margin="0,0,0,5" FontSize="12"/><DatePicker IsEnabled="{Binding CanEdit}" SelectedDate="{Binding Date}" Height="35"/></StackPanel>
   </Grid>
   <Grid Margin="0,14,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Payment Method" Margin="0,0,0,5" FontSize="12"/><ComboBox IsEnabled="{Binding CanEdit}" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" Height="35"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Staff Member" Margin="0,0,0,5" FontSize="12"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding StaffMember, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
   </Grid>
   <StackPanel Margin="0,14,0,0"><TextBlock Text="Note" Margin="0,0,0,5" FontSize="12"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,7"/></StackPanel>
   <StackPanel Margin="0,10,0,0">
     <StackPanel.Style>
       <Style TargetType="StackPanel">
         <Setter Property="Visibility" Value="Collapsed" />
         <Style.Triggers>
           <DataTrigger Binding="{Binding CanVoid}" Value="True">
             <Setter Property="Visibility" Value="Visible" />
           </DataTrigger>
         </Style.Triggers>
       </Style>
     </StackPanel.Style>
     <TextBlock Text="Void Reason *" Margin="0,0,0,5" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" />
     <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
   </StackPanel>
   <TextBlock Text="{Binding SubmissionStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/><Grid Margin="0,18,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Neutral}" IsCancel="True" HorizontalAlignment="Left"/>
    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource Button.Warning.Compact}" IsDefault="True" HorizontalAlignment="Right" Height="38" Padding="18,0"/>
    <Button Content="Void Expense" Command="{Binding VoidCommand}" HorizontalAlignment="Center" Height="38" Padding="18,0">
      <Button.Style>
        <Style TargetType="Button" BasedOn="{StaticResource Button.Expense}">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CanVoid}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Button.Style>
    </Button>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>

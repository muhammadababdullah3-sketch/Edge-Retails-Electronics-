<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SettingsConfirmDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Width="560" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Content="✕" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Text.Neutral}"
            IsCancel="True"
            HorizontalAlignment="Right"/>
   </Grid>

   <Border Margin="0,18,0,0" Padding="12"
           Background="{DynamicResource Brush.Hover.Subtle}"
           BorderBrush="{DynamicResource Brush.Border.Default}"
           BorderThickness="1" CornerRadius="8">
    <StackPanel>
     <TextBlock Text="⚠ Warning" FontSize="12" FontWeight="SemiBold"
                Foreground="{StaticResource Brush.Function.Warning}"/>
     <TextBlock Text="{Binding Message}" Margin="0,6,0,0"
                TextWrapping="Wrap" FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>
   </Border>
   <StackPanel Margin="0,16,0,0"
      Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
    <TextBlock Text="Select backup point" Margin="0,0,0,5" FontSize="12"/>
    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
              Style="{StaticResource Input.ComboBox}"/>
   </StackPanel>

   <Grid Margin="0,20,0,0">
    <Button Content="Cancel" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Neutral}"
            IsCancel="True"
            HorizontalAlignment="Left"/>
    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
            Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
            IsDefault="True"
            Height="38" Padding="18,0"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>

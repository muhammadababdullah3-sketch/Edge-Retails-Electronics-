<UserControl
    x:Class="EdgeRetails.Desktop.Views.Dialogs.ThakaFinalSettlementDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="480"
            Padding="22"
            Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="Final Settlement"
                           FontFamily="{StaticResource Font.Primary}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Style="{StaticResource Button.Close}" />
            </Grid>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,5,0,16"
                       Text="{Binding ProjectName, StringFormat=Final Settlement - {0}}"
                       FontFamily="{StaticResource Font.Primary}"
                       Foreground="{DynamicResource Brush.Text.Muted}" />

            <Border Padding="14"
                    CornerRadius="{StaticResource Radius.Control}"
                    Background="{DynamicResource Brush.Badge.Warning.Background}"
                    BorderBrush="{DynamicResource Brush.Badge.Warning.Border}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.FormLabel}" Text="Total Material Issued"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding MaterialValueDisplay}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,8,0,0"
                                   Text="Total Payments Received"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding TotalPaidDisplay}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Text.FormLabel}" Text="Remaining Balance"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.PageTitle}" Text="{Binding RemainingBalanceDisplay}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,14,0,6"
                       Text="Settlement Amount (Rs.)"
                       FontFamily="{StaticResource Font.Primary}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Text="{Binding SettlementAmountText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />

            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,14,0,6"
                       Text="Payment Method"
                       FontFamily="{StaticResource Font.Primary}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <ComboBox ItemsSource="{Binding PaymentMethods}"
                      SelectedItem="{Binding PaymentMethod}"
                      Height="34"
                      VerticalContentAlignment="Center" />

            <CheckBox Margin="0,14,0,0"
                      IsChecked="{Binding IsConfirmed}"
                      Style="{StaticResource Input.CheckBox.Emphasis}"
                      FontFamily="{StaticResource Font.Primary}"
                      Content="I confirm this project account is reconciled and ready to be permanently settled." />

            <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,10,0,0"
                       Text="{Binding ValidationMessage}"
                       FontFamily="{StaticResource Font.Primary}"
                       Foreground="{DynamicResource Brush.Badge.Warning.Text}"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        Style="{StaticResource Button.Neutral}" />
                <Button Grid.Column="3"
                        Content="Confirm Final Settlement"
                        Command="{Binding ConfirmSettlementCommand}"
                        IsDefault="True"
                        Style="{StaticResource Button.Warning.Compact}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.CatalogReferenceManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="780" MaxHeight="700" Padding="22" Style="{StaticResource Card.Raised}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Content="✕"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        IsCancel="True"
                        HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource Table.DataGrid}"
                          MinHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="SYMBOL" Binding="{Binding Symbol}" Width="85" />
                        <DataGridTextColumn Header="STATUS" Binding="{Binding StatusDisplay}" Width="85" />
                        <DataGridTemplateColumn Header="ACTION" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Toggle"
                                            Style="{StaticResource Button.Text.Neutral}"
                                            Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2"
                        Padding="14"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{Binding EditorTitle}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <Button Content="New"
                                    Command="{Binding NewCommand}"
                                    Style="{StaticResource Button.Text.Primary}"
                                    HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="Name" Margin="0,0,0,5" FontSize="12" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Input.TextBox}" />

                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsUnitMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Symbol" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}" />
                            <TextBlock Text="Display decimal places" Margin="0,12,0,5" FontSize="12" />
                            <TextBox Text="{Binding DecimalPlacesText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Input.TextBox}" />
                        </StackPanel>

                        <Border Margin="0,14,0,0"
                                Padding="9"
                                BorderBrush="{DynamicResource Brush.Status.Danger}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </Border>

                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource Button.Primary}"
                                IsDefault="True"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </Grid>

            <Button Grid.Row="2"
                    Content="Close"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource Button.Neutral}"
                    IsCancel="True"
                    HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>

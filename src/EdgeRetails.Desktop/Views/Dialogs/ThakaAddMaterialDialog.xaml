<UserControl
    x:Class="EdgeRetails.Desktop.Views.Dialogs.ThakaAddMaterialDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="520"
            Padding="22"
            Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Add Material"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Text.Neutral}" />
            </Grid>

            <TextBlock Margin="0,5,0,16"
                       Text="{Binding ProjectName, StringFormat=Issue material - {0}}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Text.Muted}" />

            <TextBlock Text="Product / SKU / Barcode"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Margin="0,6,0,8"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />
            <ComboBox ItemsSource="{Binding FilteredProducts}"
                      SelectedItem="{Binding SelectedProduct}"
                      DisplayMemberPath="DisplayName"
                      Style="{StaticResource Input.ComboBox}" />

            <Border Margin="0,12,0,0"
                    Padding="12"
                    CornerRadius="{StaticResource Radius.Control}"
                    Background="{DynamicResource Brush.Surface.Subtle}"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding AvailableStockDisplay}"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="13"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding UnitPriceDisplay}"
                               FontFamily="{StaticResource Font.Numeric}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </Grid>
            </Border>

            <TextBlock Margin="0,14,0,6"
                       Text="Quantity"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />

            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding ExactUnitSelectionDisplay}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <Button Content="Select Exact Unit(s)"
                        HorizontalAlignment="Right"
                        Command="{Binding SelectExactUnitsCommand}"
                        Style="{StaticResource Button.Neutral}" />
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="14"
                    CornerRadius="{StaticResource Radius.Control}"
                    Background="{DynamicResource Brush.Surface.Subtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Current Material Value"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding CurrentMaterialValueDisplay}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ThisIssueValueDisplay, StringFormat=This Issue: {0}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding NewMaterialValueDisplay, StringFormat=New Total: {0}}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding ValidationMessage}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}" />
                <Button Grid.Column="3"
                        Content="Issue Material"
                        Command="{Binding IssueMaterialCommand}"
                        Style="{StaticResource Button.Info.Compact}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

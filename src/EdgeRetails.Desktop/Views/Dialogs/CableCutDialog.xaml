<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.CableCutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="840" MaxHeight="660" Padding="22" Style="{StaticResource Card.Raised}">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Cable Cutting &amp; Continuous Measurement" Style="{StaticResource Text.SectionTitle}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Muted}">
                            <Run Style="{StaticResource Text.Run.Body}" Text="{Binding ProductName, Mode=OneWay}"/>
                            <Run Text=" · Cut Length: "/>
                            <Run Text="{Binding RequestedCutLength, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding UnitOfMeasure, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Close}"
                            IsCancel="True" />
                </Grid>

                <!-- Split Cut Checkbox & Notices -->
                <Grid Margin="0,10,0,0">
                    <CheckBox x:Name="SplitCutCheckBox"
                              IsChecked="{Binding AllowSplitCuts, Mode=TwoWay}"
                              Content="Allow Segmented / Split Cuts across multiple pieces"
                              Style="{StaticResource Input.CheckBox.Emphasis}"
                              VerticalAlignment="Center" />
                </Grid>

                <TextBlock Style="{StaticResource Text.FormLabel}" x:Name="SplitCutNoticeAlert"
                           Text="{Binding SplitCutNotice}" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.Function.Warning}" TextWrapping="Wrap" />

                <!-- Remnant Warning Alert (< 5m remaining) -->
                <TextBlock Style="{StaticResource Text.TableHeader}" x:Name="RemnantWarningAlert"
                           Text="{Binding RemnantWarning}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />

                <TextBlock Style="{StaticResource Text.FormLabel}" x:Name="ErrorMessageAlert"
                           Text="{Binding ErrorMessage}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Bottom Actions -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Neutral}"
                        Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmCutButton"
                        Content="Confirm Cable Cut" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True" />
            </StackPanel>

            <!-- Coils Table (Prioritizes continuous eligible coils first) -->
            <DataGrid x:Name="CoilsGrid"
                      ItemsSource="{Binding Coils}"
                      SelectedItem="{Binding SelectedCoil, Mode=TwoWay}"
                      Style="{StaticResource Table.DataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True" MinHeight="280">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="COIL TRACKING CODE" Binding="{Binding TrackingCode}" Width="190" />
                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="90" />
                    <DataGridTextColumn Header="CONTINUOUS LENGTH" Binding="{Binding ContinuousLength}" Width="150"
                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                    <DataGridTextColumn Header="REMAINING" Binding="{Binding RemainingQuantity}" Width="110"
                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="70" />
                    <DataGridTextColumn Header="CONDITION" Binding="{Binding Condition}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>

<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.CustomerEditDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
 <Border Width="500" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid><TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Command="{Binding CancelCommand}" Style="{StaticResource Button.Close}" IsCancel="True" HorizontalAlignment="Right"/></Grid>
   <StackPanel Margin="0,16,0,0"><TextBlock Style="{StaticResource Text.FormLabel}" Text="Name *" Margin="0,0,0,5"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
   <StackPanel Margin="0,14,0,0"><TextBlock Style="{StaticResource Text.FormLabel}" Text="Phone *" Margin="0,0,0,5"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
   <StackPanel Margin="0,14,0,0"><TextBlock Style="{StaticResource Text.FormLabel}" Text="Address" Margin="0,0,0,5"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}"/></StackPanel>
   <StackPanel Margin="0,14,0,0"><TextBlock Text="Notes" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}"/><TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Padding="10,7"/></StackPanel>
   <TextBlock Text="{Binding SubmissionStatus}" TextWrapping="Wrap"/><Grid Margin="0,18,0,0"><Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Neutral}" IsCancel="True" HorizontalAlignment="Left"/>
    <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" IsDefault="True" HorizontalAlignment="Right"/></Grid>
  </StackPanel>
 </Border>
</UserControl>

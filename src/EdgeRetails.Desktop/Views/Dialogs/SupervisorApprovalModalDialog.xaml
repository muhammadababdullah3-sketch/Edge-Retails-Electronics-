<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SupervisorApprovalModalDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="520" Padding="24" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <!-- Header -->
            <Grid>
                <StackPanel>
                    <TextBlock Text="Supervisor Authorization Required" Style="{StaticResource Text.SectionTitle}"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Muted}">
                        <Run Text="Operation: "/>
                        <Run Style="{StaticResource Text.Run.Body}" Text="{Binding OperationType, Mode=OneWay}"/>
                        <Run Text=" · Backdated "/>
                        <Run Style="{StaticResource Text.Run.Control}" Text="{Binding BackdateDays, Mode=OneWay}"/>
                        <Run Text=" days"/>
                    </TextBlock>
                </StackPanel>
                <Button HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Close}"
                        IsCancel="True" />
            </Grid>

            <!-- Locked Accounting Period / Hard Error Banner -->
            <Border x:Name="LockedPeriodBannerBorder"
                    Margin="0,14,0,0" Padding="12"
                    Background="{DynamicResource Brush.Selection.Subtle}"
                    BorderBrush="{DynamicResource Brush.Status.Danger}"
                    BorderThickness="1" CornerRadius="6">
                <TextBlock Style="{StaticResource Text.FormLabel}" x:Name="LockedPeriodBannerText"
                           Text="{Binding LockedPeriodBanner}"
                           Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
            </Border>

            <!-- Posting Date and Shop Date Details -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Posting Date" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Text="{Binding PostingDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Authoritative Shop Date" Style="{StaticResource Text.PosMeta}" Foreground="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Text="{Binding ShopDate, StringFormat=yyyy-MM-dd}" Style="{StaticResource Text.Body}"
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- Supervisor Selection -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="Authorizing Supervisor" Style="{StaticResource Text.TableHeader}"
                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
                <ComboBox x:Name="SupervisorComboBox"
                          ItemsSource="{Binding Supervisors}"
                          SelectedItem="{Binding SelectedSupervisor, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource Input.ComboBox}" />
            </StackPanel>

            <!-- Supervisor PIN Entry (Masked via PasswordBox) -->
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Supervisor PIN (Server-Verified)" Style="{StaticResource Text.TableHeader}"
                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
                <PasswordBox x:Name="SupervisorPinBox"
                             PasswordChanged="OnSupervisorPinChanged"
                             Style="{StaticResource Input.PasswordBox}"
                             MaxLength="10" />
            </StackPanel>

            <!-- Reason -->
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Authorization Reason" Style="{StaticResource Text.TableHeader}"
                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
                <TextBox x:Name="ReasonBox"
                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Input.TextBox}" />
            </StackPanel>

            <!-- Error message -->
            <TextBlock Style="{StaticResource Text.FormLabel}" x:Name="ErrorMessageText"
                       Text="{Binding ErrorMessage}" Margin="0,10,0,0"
                       Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SubmitButton"
                        Content="Authorize &amp; Post" Command="{Binding SubmitCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

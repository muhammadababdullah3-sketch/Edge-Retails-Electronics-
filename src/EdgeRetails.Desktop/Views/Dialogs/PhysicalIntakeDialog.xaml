<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PhysicalIntakeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="880"
    MaxHeight="680" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="{Binding Title}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding ProductInfo}"
                                   Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding PurchaseInfo}"
                                   Margin="0,1,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Badge.Brand.Text}" />
                        <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding TrackingPolicyInfo}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Style="{StaticResource Text.TableHeader}" Text="{Binding ReceiptProgressInfo}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource Button.Close}"
                            IsCancel="True"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1"
                          Padding="20,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Validation / Status Messages -->
                    <Border Background="{DynamicResource Brush.Badge.Danger.Background}" BorderBrush="{DynamicResource Brush.Badge.Danger.Border}" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ValidationMessage}" Foreground="{DynamicResource Brush.Badge.Danger.Text}" TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource Brush.Badge.Warning.Background}" BorderBrush="{DynamicResource Brush.Badge.Warning.Border}" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding HasPrintStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding PrintStatusMessage}" Foreground="{DynamicResource Brush.Badge.Warning.Text}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Intake Input Section (Visible when not completed) -->
                    <StackPanel Visibility="{Binding IntakeCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Body}" Text="Intake Quantity:"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Margin="0,0,12,0" />
                            <TextBox Grid.Column="1"
                                     Style="{StaticResource Input.TextBox}"
                                     Text="{Binding EnteredQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     FontFamily="{StaticResource Font.Numeric}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding UnitDisplay}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                        </Grid>

                        <!-- Serial / IMEI Rows if Serialized -->
                        <StackPanel Visibility="{Binding IsSerializedProduct, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Serial / IMEI Identification per Unit:"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Margin="0,0,0,6" />
                            <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MaxHeight="260"
                                    Margin="0,0,0,14">
                                <DataGrid ItemsSource="{Binding SerialRows}"
                                          Style="{StaticResource Table.DataGrid}"
                                          BorderThickness="0"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" IsReadOnly="True" Width="45"
                                                            HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                            ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                                        <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                                        <DataGridTextColumn Header="IMEI 1" Binding="{Binding Imei1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                                        <DataGridTextColumn Header="IMEI 2" Binding="{Binding Imei2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>

                        <!-- Action Button to Commit Physical Intake -->
                        <Button Content="Receive Physical Intake &amp; Allocate Identities"
                                Command="{Binding ReceiveIntakeCommand}"
                                Style="{StaticResource Button.Primary}"
                                Height="40"
                                Margin="0,4,0,16" />
                    </StackPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <Button Content="Export All PDFs" Command="{Binding ExportAllPdfCommand}" Style="{StaticResource Button.Neutral}" Margin="0,0,8,8" />
                        <Button Content="Export Selected PDFs" Command="{Binding ExportSelectedPdfCommand}" Style="{StaticResource Button.Neutral}" Margin="0,0,8,8" />
                        <Button Content="Reprint Selected PDFs" Command="{Binding ReprintSelectedPdfCommand}" Style="{StaticResource Button.Neutral}" Margin="0,0,0,8" />
                    </WrapPanel>

                    <!-- Committed Units & Production Sticker Printing Section -->
                    <StackPanel Visibility="{Binding HasCommittedUnits, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.FormLabel}" Text="COMMITTED PHYSICAL IDENTITIES"
                                           Foreground="{DynamicResource Brush.Badge.Brand.Text}" />
                                <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding CommittedUnits.Count, StringFormat=' ({0} units)'}"
                                           Foreground="{DynamicResource Brush.Text.Muted}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Print All Stickers"
                                        Command="{Binding PrintAllCommand}"
                                        Style="{StaticResource Button.Primary}"
                                        Height="32"
                                        Padding="14,0"
                                        Margin="0,0,8,0" />
                                <Button Content="Print Selected"
                                        Command="{Binding PrintSelectedCommand}"
                                        Style="{StaticResource Button.Neutral}"
                                        Height="32"
                                        Padding="12,0"
                                        Margin="0,0,8,0" />
                                <Button Content="Reprint"
                                        Command="{Binding ReprintCommand}"
                                        Style="{StaticResource Button.Warning.Compact}"
                                        Height="32"
                                        Padding="10,0" />
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MaxHeight="280">
                            <DataGrid ItemsSource="{Binding CommittedUnits}"
                                      Style="{StaticResource Table.DataGrid}"
                                      BorderThickness="0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="PRINT" Binding="{Binding IsSelected, Mode=TwoWay}" Width="55" />
                                    <DataGridTextColumn Header="#" Binding="{Binding SequenceDisplay}" IsReadOnly="True" Width="75"
                                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                                    <DataGridTextColumn Header="TRACKING CODE (PHYSICAL SKU)" Binding="{Binding TrackingCode}" IsReadOnly="True" Width="2*"
                                                        ElementStyle="{StaticResource Table.TextCell.Numeric.Bold}" />
                                    <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialDisplay}" IsReadOnly="True" Width="*" />
                                    <DataGridTextColumn Header="IMEI" Binding="{Binding ImeiDisplay}" IsReadOnly="True" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Padding="18,12"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0" CornerRadius="0">
                <Grid>
                    <TextBlock Style="{StaticResource Text.PosMeta}" Text="Code 128 barcode encodes full TrackingCode. Reprint preserves tracking code and never increments sequence."
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               VerticalAlignment="Center" />
                    <Button Content="Close"
                            Command="{Binding PrintLaterCommand}"
                            Style="{StaticResource Button.Neutral}"
                            Height="34"
                            Padding="20,0"
                            HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

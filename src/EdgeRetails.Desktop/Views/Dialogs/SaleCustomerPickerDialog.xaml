<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SaleCustomerPickerDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Width="560" MaxHeight="650" Padding="22" Style="{StaticResource Card.Raised}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Grid Grid.Row="0">
    <StackPanel>
     <TextBlock Text="Change Customer"
                FontSize="20" FontWeight="Bold"
                Foreground="{DynamicResource Brush.Text.Primary}"/>
     <TextBlock Text="Choose a saved customer or continue as Walk-in Customer."
                Margin="0,5,0,0" FontSize="12"
                Foreground="{DynamicResource Brush.Text.Muted}"/>
    </StackPanel>
    <Button Content="✕" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Text.Neutral}"
            IsCancel="True"
            HorizontalAlignment="Right" VerticalAlignment="Top"/>
   </Grid>

   <TextBox Grid.Row="1"
            Margin="0,18,0,0"
            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource Input.TextBox}"
            ToolTip="Search customer by name, phone or address"/>
   <Button Grid.Row="2"
           Margin="0,12,0,0"
           Command="{Binding UseWalkInCommand}"
           Style="{StaticResource Button.Neutral}"
           HorizontalContentAlignment="Stretch">
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Walk-in Customer"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text.Primary}"/>
      <TextBlock Text="No saved customer profile"
                 Margin="0,2,0,0" FontSize="11"
                 Foreground="{DynamicResource Brush.Text.Muted}"/>
     </StackPanel>
     <TextBlock Grid.Column="1" Text="Use"
                FontWeight="SemiBold"
                Foreground="{StaticResource Brush.Brand.Primary}"
                VerticalAlignment="Center"/>
    </Grid>
   </Button>

   <ScrollViewer Grid.Row="3"
                 Margin="0,14,0,0"
                 MaxHeight="390"
                 VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding FilteredCustomers}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <Button Command="{Binding DataContext.SelectCustomerCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
               CommandParameter="{Binding}"
               Margin="0,0,0,8"
               Padding="12"
               HorizontalContentAlignment="Stretch"
               Style="{StaticResource Button.Neutral}">
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding Name}"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Text.Primary}"/>
          <TextBlock Margin="0,3,0,0"
                     FontSize="11"
                     Foreground="{DynamicResource Brush.Text.Muted}">
           <Run Text="{Binding Phone}"/>
           <Run Text="  ·  "/>
           <Run Text="{Binding Address}"/>
          </TextBlock>
         </StackPanel>
         <TextBlock Grid.Column="1" Text="Select"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Brush.Brand.Primary}"/>
        </Grid>
       </Button>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>

   <TextBlock Grid.Row="4"
              Text="No matching saved customers."
              Margin="0,10,0,0"
              HorizontalAlignment="Center"
              Foreground="{DynamicResource Brush.Text.Muted}">
    <TextBlock.Style>
     <Style TargetType="TextBlock">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
       <DataTrigger Binding="{Binding HasCustomers}" Value="False">
        <Setter Property="Visibility" Value="Visible"/>
       </DataTrigger>
      </Style.Triggers>
     </Style>
    </TextBlock.Style>
   </TextBlock>
  </Grid>
 </Border>
</UserControl>

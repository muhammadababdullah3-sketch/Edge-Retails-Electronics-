<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.TypedRestoreConfirmationDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Width="580" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
              Foreground="{DynamicResource Brush.Text.Primary}"/>
   <Border Margin="0,16,0,0" Padding="12"
           Background="{DynamicResource Brush.Hover.Subtle}"
           BorderBrush="{DynamicResource Brush.Border.Default}"
           BorderThickness="1" CornerRadius="8">
    <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" FontSize="13"
               Foreground="{DynamicResource Brush.Text.Secondary}"/>
   </Border>
   <TextBlock Text="Type this exact confirmation" Margin="0,18,0,6" FontSize="12" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding RequiredPhrase}" Margin="0,0,0,8" FontFamily="Consolas"
              TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Primary}"/>
   <TextBox Text="{Binding EnteredText, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource Input.TextBox}"/>
   <Grid Margin="0,20,0,0">
    <Button Content="Cancel" Command="{Binding CancelCommand}"
            Style="{StaticResource Button.Neutral}" IsCancel="True"
            HorizontalAlignment="Left"/>
    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
            Style="{StaticResource Button.Warning.Compact}" IsDefault="True"
            HorizontalAlignment="Right" Height="38" Padding="18,0"/>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>

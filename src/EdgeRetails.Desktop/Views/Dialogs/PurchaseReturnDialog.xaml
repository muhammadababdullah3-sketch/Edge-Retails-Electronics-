<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PurchaseReturnDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="980"
    MaxHeight="680" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource Shadow.Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="21,14"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,0,0,1" CornerRadius="0">
                <Grid>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="Purchase Return"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding HeaderDisplay}"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Style="{StaticResource Text.PosMeta}" Text="{Binding MetaDisplay}"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </StackPanel>
                    <Button Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Close}"
                            IsCancel="True"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Padding="21"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="0,0,0,16">
                        <DataGrid ItemsSource="{Binding Lines}"
                                  Style="{StaticResource Table.DataGrid}"
                                  BorderThickness="0"
                                  CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="PRODUCT" Width="2.2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ProductName}" />
                                                <TextBlock Style="{StaticResource Text.PosMeta}" Text="{Binding ProductMeta}"
                                                           Foreground="{DynamicResource Brush.Text.Muted}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PURCHASED" Binding="{Binding Purchased}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="USED" Binding="{Binding Used}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="RETURNED" Binding="{Binding Returned}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="ELIGIBLE" Binding="{Binding Eligible}" Width="85" IsReadOnly="True" />
                                <DataGridTextColumn Header="RETURN QTY"
                                                    Binding="{Binding ReturnQuantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                    Width="100" />
                                <DataGridTextColumn Header="EXACT UNITS" Binding="{Binding ExactUnitSelectionDisplay}" Width="110" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="SELECT UNIT" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Select"
                                                    Command="{Binding DataContext.SelectExactUnitsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource Button.Text.Neutral}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="VALUE" Binding="{Binding ReturnValueDisplay}" Width="120" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Reason"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBox Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     Padding="10,6" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.FormLabel}" Text="Note"
                                       Margin="0,0,0,5"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                            <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="35"
                                     Padding="10,6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="21,14"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0" CornerRadius="0">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Return Value: "
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Style="{StaticResource Text.DetailTitle}" Text="{Binding ReturnTotalDisplay}"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource Button.Neutral}"
                                IsCancel="True"
                                Margin="0,0,8,0" />
                        <Button Content="Process Return"
                                Command="{Binding ConfirmCommand}"
                                Style="{StaticResource Button.Warning.Compact}"
                                IsDefault="True"
                                Height="38"
                                Padding="18,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl
    x:Class="EdgeRetails.Desktop.Views.Dialogs.NewThakaDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:NewThakaViewModel, IsDesignTimeCreatable=True}"
    Width="480"
    MaxWidth="480"
    Focusable="False">

    <Border Padding="24"
            Background="{DynamicResource Brush.Surface.Raised}"
            BorderBrush="{DynamicResource Brush.Border.Default}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Large}"
            Effect="{StaticResource Shadow.Modal}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header with Title, Subtitle, and Close (X) button -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="New Thaka Project"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="Register a customer contract &amp; site details"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="Close"
                        AutomationProperties.Name="Close Dialog"
                        IsCancel="True"
                        Command="{Binding CloseCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder"
                                    Background="Transparent"
                                    CornerRadius="{StaticResource Radius.Compact}">
                                <Path Width="10"
                                      Height="10"
                                      Data="M 0 0 L 10 10 M 10 0 L 0 10"
                                      Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                                    <Setter TargetName="CloseBorder" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                    <Setter TargetName="CloseBorder" Property="BorderThickness" Value="1.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Form Fields Area -->
            <StackPanel Grid.Row="1">
                <!-- Customer Name (Required) -->
                <TextBlock Text="Customer Name *"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding CustomerNameError}"
                           Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11.5"
                           Visibility="{Binding HasCustomerNameError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Phone Number -->
                <TextBlock Text="Phone Number"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,12,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Project Name (Required) -->
                <TextBlock Text="Project Name *"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,12,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,4,0,0"
                           Text="{Binding ProjectNameError}"
                           Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11.5"
                           Visibility="{Binding HasProjectNameError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Site Location / Address -->
                <TextBlock Text="Site Location / Address"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,12,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Initial Notes -->
                <TextBlock Text="Initial Notes (Optional)"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           Margin="0,12,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Height="70"
                         VerticalContentAlignment="Top"
                         Padding="10.5,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Validation message banner if any -->
                <Border Margin="0,12,0,0"
                        Padding="10,6"
                        Background="{DynamicResource Brush.Badge.Danger.Background}"
                        BorderBrush="{DynamicResource Brush.Badge.Danger.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Compact}"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="{DynamicResource Brush.Badge.Danger.Text}"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12" />
                </Border>
            </StackPanel>

            <!-- 3. Footer Action Buttons -->
            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="0,16,0,0"
                    BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="92"
                            Margin="0,0,10.5,0"
                            Content="Cancel"
                            Style="{StaticResource Button.Neutral}"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />
                    <Button Width="130"
                            Content="Create Thaka"
                            Style="{StaticResource Button.Primary}"
                            IsDefault="True"
                            Command="{Binding CreateThakaCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

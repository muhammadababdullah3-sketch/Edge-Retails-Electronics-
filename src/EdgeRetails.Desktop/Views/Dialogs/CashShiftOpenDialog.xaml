<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.CashShiftOpenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="460" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <TextBlock Text="Open cash drawer" Style="{StaticResource Text.SectionTitle}" />
            <TextBlock Margin="0,8,0,16"
                       Style="{StaticResource Text.FormLabel}"
                       Text="Enter the opening float for this shift. Cash sales stay blocked until a session is open."
                       TextWrapping="Wrap" />
            <TextBlock Text="Opening cash" Style="{StaticResource Text.KpiLabel}" />
            <TextBox Margin="0,6,0,12"
                     Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="Note (optional)" Style="{StaticResource Text.KpiLabel}" />
            <TextBox Margin="0,6,0,16"
                     Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip for now"
                        Command="{Binding SkipCommand}"
                        Margin="0,0,8,0"
                        Style="{StaticResource Button.Text.Borderless}" />
                <Button Content="Open session"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

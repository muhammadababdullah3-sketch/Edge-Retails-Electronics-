<UserControl
    x:Class="EdgeRetails.Desktop.Views.Dialogs.SalesReturnDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:EdgeRetails.Desktop.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewModels:SalesReturnViewModel}"
    Width="480"
    Background="{DynamicResource Brush.Surface.Raised}"
    Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Stepper Button Style -->
        <Style x:Key="Stepper.Button" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="Button.CloseCross" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Path Data="M 1 1 L 9 9 M 9 1 L 1 9"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10"
                                  Height="10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selection.Subtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover.Subtle}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto" />
            <!-- 1: Divider -->
            <RowDefinition Height="1" />
            <!-- 2: Scrollable Form Body -->
            <RowDefinition Height="*" />
            <!-- 3: Divider -->
            <RowDefinition Height="1" />
            <!-- 4: Footer CTA Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header (Title, Subtitle, Close) -->
        <Border Grid.Row="0" Padding="20,16" Background="{DynamicResource Brush.Surface.Raised}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Return Items"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Margin="0,3,0,0"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12.5"
                               Foreground="{DynamicResource Brush.Text.Muted}">
                        <Run Text="Select items to return from " />
                        <Run Text="{Binding InvoiceDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" />
                        <Run Text=" · " />
                        <Run Text="{Binding CustomerName, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Button.CloseCross}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"
                        ToolTip="Close"
                        VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- 1. Top Divider -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Border.Default}" />

        <!-- 2. Scrollable Content Body -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      Padding="20,16">
            <StackPanel>
                <!-- Section: Returnable Items -->
                <TextBlock Text="SELECT ITEMS TO RETURN"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding ReturnItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:SalesReturnItemViewModel}">
                            <Border Margin="0,0,0,10"
                                    Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Background="{DynamicResource Brush.Surface.Default}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Title and Rate -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductName}"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource Brush.Text.Muted}">
                                                <Run Text="{Binding Brand}" />
                                                <Run Text=" · SKU: " />
                                                <Run Text="{Binding Sku}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UnitPriceDisplay}"
                                                   FontFamily="{StaticResource Font.Numeric}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   VerticalAlignment="Top" />
                                    </Grid>

                                    <!-- Row 1: Quantities and Stepper -->
                                    <Grid Grid.Row="1" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Quantity breakdown badges -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Padding="6,2"
                                                    Background="{DynamicResource Brush.Surface.Subtle}"
                                                    CornerRadius="4"
                                                    Margin="0,0,6,0">
                                                <TextBlock FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}">
                                                    <Run Text="Sold: " />
                                                    <Run Text="{Binding SoldQuantity, Mode=OneWay, StringFormat={}{0:0.##}}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </Border>

                                            <Border Padding="6,2"
                                                    Background="{DynamicResource Brush.Badge.Warning.Background}"
                                                    BorderBrush="{DynamicResource Brush.Badge.Warning.Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <TextBlock Text="{Binding MaxEligibleDisplay}"
                                                           FontFamily="{StaticResource Font.Primary}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Return Stepper: [ - ]  ReturnQty  [ + ] -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−"
                                                    Command="{Binding DecrementCommand}"
                                                    Style="{StaticResource Stepper.Button}" />

                                            <Border Width="42"
                                                    Height="28"
                                                    Margin="4,0"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                                    CornerRadius="{StaticResource Radius.Control}"
                                                    Background="{DynamicResource Brush.Surface.Raised}">
                                                <TextBox Text="{Binding ReturnQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource Brush.Text.Primary}"
                                                         FontFamily="{StaticResource Font.Numeric}"
                                                         FontSize="13.5"
                                                         FontWeight="Bold"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         FocusVisualStyle="{x:Null}" />
                                            </Border>

                                            <Button Content="+"
                                                    Command="{Binding IncrementCommand}"
                                                    Style="{StaticResource Stepper.Button}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 2: Item refund total impact banner -->
                                    <Border Grid.Row="2"
                                            Margin="0,8,0,0"
                                            Padding="8,5"
                                            Background="{DynamicResource Brush.Badge.Success.Background}"
                                            BorderBrush="{DynamicResource Brush.Badge.Success.Border}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Visibility="{Binding HasReturnQuantity, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <TextBlock Text="Item Refund Value:"
                                                       FontFamily="{StaticResource Font.Primary}"
                                                       FontSize="11.5"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource Brush.Badge.Success.Text}"
                                                       HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding ReturnLineTotalDisplay}"
                                                       FontFamily="{StaticResource Font.Numeric}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.Badge.Success.Text}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Section: Return Disposition / Reason -->
                <TextBlock Text="RETURN REASON &amp; DISPOSITION"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Margin="0,14,0,10" />

                <!-- Radio Cards for Reason -->
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 1. Customer Changed Mind / Restock -->
                    <RadioButton Grid.Row="0" Grid.Column="0"
                                 GroupName="ReturnReasonGroup"
                                 IsChecked="{Binding IsDispositionRestock, Mode=OneWay}"
                                 Command="{Binding SetDispositionCommand}"
                                 CommandParameter="{x:Static viewModels:ReturnDisposition.CustomerChangedMind}"
                                 Margin="0,0,0,8">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Padding="10,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource Brush.Surface.Default}"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="Restock (Sellable)"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Customer changed mind"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Brand.Background}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- 2. Defective -->
                    <RadioButton Grid.Row="0" Grid.Column="2"
                                 GroupName="ReturnReasonGroup"
                                 IsChecked="{Binding IsDispositionDefective, Mode=OneWay}"
                                 Command="{Binding SetDispositionCommand}"
                                 CommandParameter="{x:Static viewModels:ReturnDisposition.Defective}"
                                 Margin="0,0,0,8">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Padding="10,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource Brush.Surface.Default}"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="Defective Stock"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Non-sellable / Vendor return"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Function.Warning}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Warning.Background}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- 3. Damaged -->
                    <RadioButton Grid.Row="1" Grid.Column="0"
                                 GroupName="ReturnReasonGroup"
                                 IsChecked="{Binding IsDispositionDamaged, Mode=OneWay}"
                                 Command="{Binding SetDispositionCommand}"
                                 CommandParameter="{x:Static viewModels:ReturnDisposition.Damaged}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Padding="10,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource Brush.Surface.Default}"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="Damaged Stock"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Non-sellable / Loss write-off"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Function.Danger}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Danger.Background}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <!-- 4. Other -->
                    <RadioButton Grid.Row="1" Grid.Column="2"
                                 GroupName="ReturnReasonGroup"
                                 IsChecked="{Binding IsDispositionOther, Mode=OneWay}"
                                 Command="{Binding SetDispositionCommand}"
                                 CommandParameter="{x:Static viewModels:ReturnDisposition.Other}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="Bd"
                                        Padding="10,8"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource Brush.Border.Default}"
                                        CornerRadius="{StaticResource Radius.Control}"
                                        Background="{DynamicResource Brush.Surface.Default}"
                                        Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="Other Reason"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="Custom disposition notes"
                                                   FontFamily="{StaticResource Font.Primary}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Brand.Primary}" />
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Badge.Brand.Background}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </Grid>

                <!-- Return Notes Input (Always useful for return ledger) -->
                <TextBox Text="{Binding ReturnNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource Input.TextBox}"
                         Height="36"
                         Margin="0,4,0,14" />

                <!-- Section: Refund Method -->
                <TextBlock Text="REFUND METHOD"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="11.5"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Margin="0,4,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Cash Refund"
                            Command="{Binding SetRefundMethodCommand}"
                            CommandParameter="Cash Refund"
                            Height="32"
                            Padding="14,0"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCashRefund}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Gradient.Payment}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Store Credit"
                            Command="{Binding SetRefundMethodCommand}"
                            CommandParameter="Store Credit"
                            Height="32"
                            Padding="14,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Default}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStoreCreditRefund}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Gradient.Brand.Primary}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.White}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Transparent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Margin="0,0,0,12"
                        Padding="10,8"
                        CornerRadius="{StaticResource Radius.Control}"
                        Background="{DynamicResource Brush.Badge.Warning.Background}"
                        BorderBrush="{DynamicResource Brush.Badge.Warning.Border}"
                        BorderThickness="1"
                        Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ValidationMessage}"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Badge.Warning.Text}" />
                </Border>

                <!-- Section: Dynamic Total Return Amount Card -->
                <Border Padding="16,14"
                        Background="{DynamicResource Brush.Kpi.ExpenseBackground}"
                        BorderBrush="{DynamicResource Brush.Function.Expense}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOTAL RETURN AMOUNT"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding TotalReturnQuantityDisplay}"
                                       FontFamily="{StaticResource Font.Primary}"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalReturnAmountDisplay}"
                                   FontFamily="{StaticResource Font.Numeric}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Function.Expense}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Bottom Divider -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Border.Default}" />

        <!-- 4. Footer Actions -->
        <Border Grid.Row="4" Padding="20,16" Background="{DynamicResource Brush.Surface.Raised}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        Height="40" />

                <Button Grid.Column="2"
                        Content="Process Return"
                        Command="{Binding ProcessReturnCommand}"
                        Style="{StaticResource Button.Expense}"
                        IsDefault="True"
                        Height="40" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

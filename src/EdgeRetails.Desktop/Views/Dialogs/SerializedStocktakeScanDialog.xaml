<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SerializedStocktakeScanDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="620" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding ExpectedDisplay}" Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        IsCancel="True" />
            </Grid>
            <TextBlock Margin="0,16,0,6"
                       Text="Scan/paste one TrackingCode, Serial or IMEI per line."
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Text="{Binding ScannedIdentities, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" MinHeight="260" VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="{Binding Message}" Margin="0,10,0,0"
                       Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="Record Serialized Count" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

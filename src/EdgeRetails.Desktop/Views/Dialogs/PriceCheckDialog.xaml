<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PriceCheckDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" Foreground="{DynamicResource Brush.Text.Primary}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Border Width="520" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Price Check" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Grid.Column="1" Width="32" Height="32" Padding="0" Content="✕" HorizontalAlignment="Right" Command="{Binding CloseCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        IsCancel="True" />
            </Grid>
            <TextBox x:Name="PriceSearchInput" Margin="0,18,0,8" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" AutomationProperties.Name="Product identity" ToolTip="Enter a product name, SKU, barcode or exact identity">
                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding CheckCommand}"/></TextBox.InputBindings>
            </TextBox>
            <Button Content="Check price" Command="{Binding CheckCommand}" HorizontalAlignment="Left" IsDefault="True" Style="{StaticResource Button.Primary}"/>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Text.Muted}"/>
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ProductName}" Margin="0,18,0,2" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding Sku, StringFormat=SKU: {0}}" FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Muted}" />
            <TextBlock Text="{Binding PriceDisplay}" Margin="0,18,0,12" FontSize="30" FontWeight="Bold"
                       FontFamily="{StaticResource Font.Numeric}"
                       Foreground="{DynamicResource Brush.Brand.Primary}" />
            <Grid Margin="0,4">
                <TextBlock Text="Availability" Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Text="{Binding AvailabilityDisplay}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,4">
                <TextBlock Text="Unit" Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Text="{Binding UnitDisplay}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,4">
                <TextBlock Text="Tracking" Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Text="{Binding TrackingDisplay}" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Visibility="{Binding HasExactUnit, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Physical identity" Margin="0,10,0,2"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Text="{Binding ExactIdentityDisplay}" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="{Binding ExactUnitStatusDisplay, StringFormat=Status: {0}}" Margin="0,4,0,0"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
            </StackPanel>
            <Button Content="Close" Command="{Binding CloseCommand}" Margin="0,20,0,0"
                    IsCancel="True"
                    HorizontalAlignment="Right" Style="{StaticResource Button.Primary}" Width="110" />
        </StackPanel>
    </Border>
</UserControl>

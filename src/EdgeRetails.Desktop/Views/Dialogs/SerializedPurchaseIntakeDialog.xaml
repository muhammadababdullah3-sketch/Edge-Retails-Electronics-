<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SerializedPurchaseIntakeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="780" MaxHeight="680" Padding="22" Style="{StaticResource Card.Raised}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding RequirementDisplay}" Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Text.Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="âœ•" HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Text.Neutral}" />
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}" Margin="0,10,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}" Margin="0,0,8,0" />
                <Button Content="Use Identities" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Button.Primary}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource Table.DataGrid}"
                      AutoGenerateColumns="False" MinHeight="340">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" IsReadOnly="True" Width="50" />
                    <DataGridTextColumn Header="SERIAL NUMBER" Binding="{Binding SerialNumber, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                    <DataGridTextColumn Header="IMEI 1" Binding="{Binding Imei1, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                    <DataGridTextColumn Header="IMEI 2" Binding="{Binding Imei2, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>

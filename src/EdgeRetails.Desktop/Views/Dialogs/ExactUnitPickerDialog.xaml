<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.ExactUnitPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="860" MaxHeight="680" Padding="22" Style="{StaticResource Card.Raised}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕" Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Text.Neutral}"
                            IsCancel="True" />
                </Grid>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             ToolTip="TrackingCode, Serial, IMEI or provenance" />
                    <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Neutral}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <TextBlock Text="{Binding SelectionHint}" FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding SelectedCountDisplay}" HorizontalAlignment="Right"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}" Margin="0,8,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True" />
            </StackPanel>

            <DataGrid ItemsSource="{Binding Units}" Style="{StaticResource Table.DataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="False" MinHeight="330">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="SELECT" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                    <DataGridTextColumn Header="TRACKING CODE" Binding="{Binding TrackingCode}" Width="190" IsReadOnly="True" />
                    <DataGridTextColumn Header="SERIAL / IMEI" Binding="{Binding ManufacturerIdentity}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" IsReadOnly="True" />
                    <DataGridTextColumn Header="PROVENANCE" Binding="{Binding Provenance}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="COST" Binding="{Binding CostDisplay}" Width="100" IsReadOnly="True"
                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>

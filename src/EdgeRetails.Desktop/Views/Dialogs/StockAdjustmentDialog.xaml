<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.StockAdjustmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="500" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Stock Adjustment" Style="{StaticResource Text.SectionTitle}" Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Command="{Binding CancelCommand}" Style="{StaticResource Button.Close}" IsCancel="True" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding ProductDisplay}" Margin="0,5,0,14" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.Text.Muted}" />
            <Border Padding="14" CornerRadius="8" Background="{DynamicResource Brush.Badge.Info.Background}">
                <Grid>
                    <TextBlock Text="Current Stock" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding CurrentStockDisplay}" HorizontalAlignment="Right" Style="{StaticResource Text.SectionTitle}" />
                </Grid>
            </Border>
            <TextBlock Text="Direction" Margin="0,14,0,6" Style="{StaticResource Text.FormLabel}" />
            <CheckBox IsEnabled="{Binding CanEdit}" Content="Increase stock (uncheck to decrease)" IsChecked="{Binding IsIncrease}" />
            <TextBlock Text="Quantity" Margin="0,14,0,6" Style="{StaticResource Text.FormLabel}" />
            <TextBox IsEnabled="{Binding CanEdit}" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="Reason" Margin="0,14,0,6" Style="{StaticResource Text.FormLabel}" />
            <TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="Note" Margin="0,14,0,6" Style="{StaticResource Text.FormLabel}" />
            <TextBox IsEnabled="{Binding CanEdit}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="{Binding SubmissionStatus}" TextWrapping="Wrap" Margin="0,8,0,0"/><Grid Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Neutral}" IsCancel="True" HorizontalAlignment="Left" />
                <Button Content="Apply Adjustment" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}" IsDefault="True" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

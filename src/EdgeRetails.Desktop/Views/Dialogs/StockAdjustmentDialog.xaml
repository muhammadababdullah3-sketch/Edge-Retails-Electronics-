<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.StockAdjustmentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="500" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Stock Adjustment" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Content="✕" Command="{Binding CancelCommand}" Style="{StaticResource Button.Text.Neutral}" HorizontalAlignment="Right" />
            </Grid>
            <TextBlock Text="{Binding ProductDisplay}" Margin="0,5,0,14" FontSize="13" Foreground="{DynamicResource Brush.Text.Muted}" />
            <Border Padding="14" CornerRadius="8" Background="{DynamicResource Brush.Badge.Info.Background}">
                <Grid>
                    <TextBlock Text="Current Stock" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding CurrentStockDisplay}" HorizontalAlignment="Right" FontSize="18" FontWeight="Bold" />
                </Grid>
            </Border>
            <TextBlock Text="Direction" Margin="0,14,0,6" FontSize="12" />
            <CheckBox Content="Increase stock (uncheck to decrease)" IsChecked="{Binding IsIncrease}" />
            <TextBlock Text="Quantity" Margin="0,14,0,6" FontSize="12" />
            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="Reason" Margin="0,14,0,6" FontSize="12" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <TextBlock Text="Note" Margin="0,14,0,6" FontSize="12" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
            <Grid Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Neutral}" HorizontalAlignment="Left" />
                <Button Content="Apply Adjustment" Command="{Binding ApplyCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
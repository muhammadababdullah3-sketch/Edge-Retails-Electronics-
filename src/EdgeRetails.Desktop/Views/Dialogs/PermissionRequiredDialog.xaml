<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PermissionRequiredDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Width="460" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid>
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"
               Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Content="✕" Command="{Binding CloseCommand}"
            Style="{StaticResource Button.Text.Neutral}"
            HorizontalAlignment="Right"/>
   </Grid>
   <Border Margin="0,18,0,0" Padding="14"
           Background="{DynamicResource Brush.Selection.Subtle}"
           CornerRadius="8">
    <StackPanel>
     <TextBlock Text="Access blocked" FontSize="12" FontWeight="SemiBold"
                Foreground="{StaticResource Brush.Brand.Primary}"/>
     <TextBlock Text="{Binding Message}" Margin="0,6,0,0"
                TextWrapping="Wrap" FontSize="12"
                Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>
   </Border>
   <TextBlock Text="No manager override is available in V1."
              Margin="0,10,0,0" FontSize="11"
              Foreground="{DynamicResource Brush.Text.Muted}"/>
   <Button Content="Close" Command="{Binding CloseCommand}"
           Style="{StaticResource Button.Primary}"
           HorizontalAlignment="Right" Margin="0,20,0,0"
           Padding="18,0"/>
  </StackPanel>
 </Border>
</UserControl>

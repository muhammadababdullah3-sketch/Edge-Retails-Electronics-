<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PermissionRequiredDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
 <Border Width="460" Padding="22" Style="{StaticResource Card.Raised}">
  <StackPanel>
   <Grid>
    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}"
               Foreground="{DynamicResource Brush.Text.Primary}"/>
    <Button Command="{Binding CloseCommand}"
            Style="{StaticResource Button.Close}"
            IsCancel="True"
            HorizontalAlignment="Right"/>
   </Grid>
   <Border Margin="0,18,0,0" Padding="14"
           Background="{DynamicResource Brush.Selection.Subtle}"
           CornerRadius="8">
    <StackPanel>
     <TextBlock Text="Access blocked" Style="{StaticResource Text.TableHeader}"
                Foreground="{DynamicResource Brush.Badge.Brand.Text}"/>
     <TextBlock Style="{StaticResource Text.FormLabel}" Text="{Binding Message}" Margin="0,6,0,0"
                TextWrapping="Wrap"
                Foreground="{DynamicResource Brush.Text.Secondary}"/>
    </StackPanel>
   </Border>
   <TextBlock Style="{StaticResource Text.PosMeta}" Text="No manager override is available in V1."
              Margin="0,10,0,0"
              Foreground="{DynamicResource Brush.Text.Muted}"/>
   <Button Content="Close" Command="{Binding CloseCommand}"
           Style="{StaticResource Button.Primary}"
           IsCancel="True" IsDefault="True"
           HorizontalAlignment="Right" Margin="0,20,0,0"
           Padding="18,0"/>
  </StackPanel>
 </Border>
</UserControl>

<UserControl
    x:Class="EdgeRetails.Desktop.Views.Dialogs.ThakaRecordPaymentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="480"
            Padding="22"
            Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="Record Payment"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Text.Neutral}" />
            </Grid>

            <TextBlock Margin="0,5,0,16"
                       Text="{Binding ProjectName, StringFormat=Record Payment - {0}}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="13"
                       Foreground="{DynamicResource Brush.Text.Muted}" />

            <Border Padding="14"
                    CornerRadius="{StaticResource Radius.Control}"
                    Background="{DynamicResource Brush.Badge.Info.Background}"
                    BorderBrush="{DynamicResource Brush.Badge.Info.Border}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Outstanding Balance"
                               FontFamily="{StaticResource Font.Primary}"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding OutstandingBalanceDisplay}"
                               FontFamily="{StaticResource Font.Numeric}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,6"
                       Text="Payment Amount (Rs.)"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />

            <TextBlock Margin="0,14,0,6"
                       Text="Payment Method"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <ComboBox ItemsSource="{Binding PaymentMethods}"
                      SelectedItem="{Binding PaymentMethod}"
                      Style="{StaticResource Input.ComboBox}" />

            <TextBlock Margin="0,14,0,6"
                       Text="Payment Reference / Notes"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
            <TextBox Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource Input.TextBox}" />

            <TextBlock Margin="0,10,0,0"
                       Text="{Binding ValidationMessage}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.Badge.Warning.Text}"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}" />
                <Button Grid.Column="3"
                        Content="Record Payment"
                        Command="{Binding RecordPaymentCommand}"
                        Style="{StaticResource Button.Payment.Compact}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>


<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.StocktakeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="980" MaxHeight="720" Padding="22" Style="{StaticResource Card.Raised}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Full Shop Stocktake" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="{Binding StocktakeIdDisplay}" Margin="0,4,0,0"
                                   FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusDisplay}" Margin="0,0,12,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button Content="âœ•" Command="{Binding CloseCommand}"
                                Style="{StaticResource Button.Text.Neutral}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Message}" Margin="0,10,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Start Full Shop" Command="{Binding StartCommand}"
                            Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                    <Button Content="Review" Command="{Binding ReviewCommand}"
                            Style="{StaticResource Button.Neutral}" Margin="0,0,8,0" />
                    <Button Content="Post Reconciliation" Command="{Binding PostCommand}"
                            Style="{StaticResource Button.Primary}" Margin="0,0,8,0" />
                    <Button Content="Cancel Stocktake" Command="{Binding CancelStocktakeCommand}"
                            Style="{StaticResource Button.Neutral}" Margin="0,0,8,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource Button.Neutral}" />
                </StackPanel>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource Table.DataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="False" MinHeight="400">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="EXPECTED" Binding="{Binding ExpectedDisplay}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="COUNT" Binding="{Binding CountedQuantityText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="90" />
                    <DataGridTextColumn Header="STATUS" Binding="{Binding CountStatusDisplay}" Width="150" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="ACTION" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Record Qty"
                                            Command="{Binding DataContext.RecordQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Text.Neutral}" Margin="0,0,8,0" />
                                    <Button Content="Scan Exact Units"
                                            Command="{Binding DataContext.ScanSerializedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Button.Text.Neutral}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>

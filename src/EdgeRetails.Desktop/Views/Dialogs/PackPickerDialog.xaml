<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.PackPickerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="820" MaxHeight="640" Padding="22" Style="{StaticResource Card.Raised}">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Select Pack / Container" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Muted}">
                            <Run Text="{Binding ProductName, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text=" · Requested: "/>
                            <Run Text="{Binding RequestedQuantity, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding UnitOfMeasure, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="✕" Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Text.Neutral}"
                            IsCancel="True" />
                </Grid>

                <!-- Stale Capacity & Error Banners -->
                <TextBlock x:Name="StaleCapacityAlert"
                           Text="{Binding StaleCapacityPrompt}" Margin="0,10,0,0"
                           Foreground="{DynamicResource Brush.Function.Warning}"
                           FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorMessageAlert"
                           Text="{Binding ErrorMessage}" Margin="0,6,0,0"
                           Foreground="{DynamicResource Brush.Status.Danger}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Bottom Actions -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource Button.Neutral}"
                        Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Content="Confirm Pack" Command="{Binding ConfirmCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True" />
            </StackPanel>

            <!-- Containers Table (FIFO: Open packs first) -->
            <DataGrid x:Name="ContainersGrid"
                      ItemsSource="{Binding Containers}"
                      SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                      Style="{StaticResource Table.DataGrid}"
                      AutoGenerateColumns="False" IsReadOnly="True" MinHeight="280">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TRACKING CODE" Binding="{Binding TrackingCode}" Width="180" />
                    <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="100" />
                    <DataGridTextColumn Header="REMAINING" Binding="{Binding RemainingQuantity}" Width="110"
                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                    <DataGridTextColumn Header="INITIAL" Binding="{Binding InitialQuantity}" Width="110"
                                        HeaderStyle="{StaticResource Table.ColumnHeader.Numeric}"
                                        ElementStyle="{StaticResource Table.TextCell.Numeric}" />
                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="80" />
                    <DataGridTextColumn Header="CONDITION" Binding="{Binding Condition}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>

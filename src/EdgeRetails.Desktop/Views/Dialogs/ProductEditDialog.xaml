<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="650" Padding="22" Style="{StaticResource Card.Raised}">
        <StackPanel>
            <Grid>
                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Content="✕" Command="{Binding CancelCommand}" Style="{StaticResource Button.Text.Neutral}" HorizontalAlignment="Right" />
            </Grid>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Product Name" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="SKU" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Brand" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Category" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Model" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Unit" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Purchase Cost" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding CostText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Sale Price" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Minimum Stock" Margin="0,0,0,5" FontSize="12" /><TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" /></StackPanel>
            </Grid>
            <TextBlock Margin="0,14,0,0" Text="Current stock is intentionally not editable here. Use Stock Adjustment for audited changes." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
            <Grid Margin="0,18,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Button.Neutral}" HorizontalAlignment="Left" />
                <Button Content="Save Product" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
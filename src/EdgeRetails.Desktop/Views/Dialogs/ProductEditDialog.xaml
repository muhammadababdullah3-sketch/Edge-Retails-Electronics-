<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Foreground="{DynamicResource Brush.Text.Primary}">
    <Border Width="920" MaxHeight="780" Padding="22" Style="{StaticResource Card.Raised}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Style="{StaticResource Text.SectionTitle}" Text="{Binding Title}"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Close}"
                        IsCancel="True"
                        HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Stock cannot be directly modified here. Use Stock Adjustment for audited changes. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Product Name" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SKU (Master Product Code)" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsSkuReadOnly}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Company / Manufacturer" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <ComboBox ItemsSource="{Binding Companies}"
                                      SelectedItem="{Binding SelectedCompany}"
                                      Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Model (Display)" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model Code (Identity Token, e.g. DLX56)" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding ModelCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Brand (Optional)" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Base Unit" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <ComboBox ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding SelectedBaseUnit}"
                                      IsEnabled="{Binding IsBaseUnitEditable}"
                                      Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tracking Mode" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <ComboBox ItemsSource="{Binding TrackingModes}"
                                      SelectedItem="{Binding SelectedTrackingMode}"
                                      Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,7">
                            <CheckBox Content="Serial tracking"
                                      IsChecked="{Binding SerialTrackingEnabled}"
                                      IsEnabled="{Binding IsSerialized}"
                                      Margin="0,0,20,0" />
                            <CheckBox Content="IMEI tracking"
                                      IsChecked="{Binding ImeiTrackingEnabled}"
                                      IsEnabled="{Binding IsSerialized}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reference Purchase Cost" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding ReferencePurchaseCostText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default Sale Price" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Minimum Stock" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default Warranty (months)" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding WarrantyMonthsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Attributes Schema Version" Margin="0,0,0,5" Style="{StaticResource Text.FormLabel}" />
                            <TextBox Text="{Binding AttributesSchemaVersionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Legacy / Unmapped Category Notice -->
                    <Border Margin="0,14,0,0"
                            Padding="12,10"
                            Background="{DynamicResource Brush.Surface.Subtle}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Visibility="{Binding IsTaxonomyUnmapped, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource Text.PosMeta}" Text="{Binding TaxonomyMappingNotice}"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Border>

                    <!-- Dynamic Typed Catalog Attributes -->
                    <Border Margin="0,14,0,0"
                            Padding="14,12"
                            Background="{DynamicResource Brush.Surface.Subtle}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Visibility="{Binding HasAttributeItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.PosBadge}" Text="CATALOG ATTRIBUTES (TAXONOMY V3 TYPED VALIDATION)"
                                       FontFamily="{StaticResource Font.Primary}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding AttributeItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.TableHeader}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="*" Foreground="{DynamicResource Brush.Status.Danger}"
                                                               Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                               Margin="2,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ValueType}" Style="{StaticResource Text.MonoHint}" Foreground="{DynamicResource Brush.Text.Muted}" />
                                                <TextBlock Style="{StaticResource Text.PosMeta}" Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.Status.Danger}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>

                                            <Grid Grid.Column="1">
                                                <!-- If Boolean -->
                                                <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                          Content="Enabled"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsBoolean, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                <!-- If not Boolean -->
                                                <Grid Visibility="{Binding IsBoolean, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <!-- If Enum -->
                                                    <ComboBox ItemsSource="{Binding EnumOptions}"
                                                              SelectedItem="{Binding CurrentValue, Mode=TwoWay}"
                                                              Height="30"
                                                              Visibility="{Binding IsEnum, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <!-- If Text or Number -->
                                                    <Grid Visibility="{Binding IsEnum, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0"
                                                                 Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                                 Height="30"
                                                                 VerticalContentAlignment="Center"
                                                                 Style="{StaticResource Input.TextBox}" />
                                                        <TextBlock Style="{StaticResource Text.PosMeta}" Grid.Column="1"
                                                                   Text="{Binding UnitSymbol}"
                                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="6,0,0,0" />
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Catalog Attributes JSON (Advanced)" Margin="0,14,0,5" Style="{StaticResource Text.FormLabel}" />
                    <TextBox Text="{Binding AttributesJson, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             Height="72"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Style="{StaticResource Text.Body}" Text="Product Units"
                               Margin="0,18,0,8"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding UnitConfigurations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" />
                                    <TextBox Grid.Column="1" Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
                                    <CheckBox Grid.Column="2" Content="Purchase" IsChecked="{Binding CanPurchase}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3" Content="Sell" IsChecked="{Binding CanSell}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="4" Content="Thaka" IsChecked="{Binding CanUseInThaka}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="5" Content="Default buy" IsChecked="{Binding IsDefaultPurchaseUnit}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="6" Content="Default sale" IsChecked="{Binding IsDefaultSaleUnit}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Text.Body}" Text="Supplier Links"
                               Margin="0,18,0,8"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBox Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search suppliers" Style="{StaticResource Input.TextBox}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding SupplierLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsLinked}"
                                          Margin="0,0,18,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="More suppliers" Command="{Binding LoadMoreSuppliersCommand}"
                            Style="{StaticResource Button.Text.Neutral}" HorizontalAlignment="Left" />

                    <Border Margin="0,14,0,0"
                            Padding="10"
                            BorderBrush="{DynamicResource Brush.Status.Danger}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>

                    <TextBlock Style="{StaticResource Text.FormLabel}" Margin="0,14,0,0"
                               Text="Current stock, inventory value, lots and exact physical-unit state are not editable here."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        IsCancel="True"
                        HorizontalAlignment="Left" />
                <Button Content="Save Product"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Button.Primary}"
                        IsDefault="True"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

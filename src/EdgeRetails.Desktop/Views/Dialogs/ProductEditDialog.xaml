<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.ProductEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="920" MaxHeight="780" Padding="22" Style="{StaticResource Card.Raised}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="{Binding Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button Content="âœ•"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Text.Neutral}"
                        HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,16"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Stock cannot be directly modified here. Use Stock Adjustment for audited changes. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Product Name" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SKU" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Brand" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding Brand, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Model" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Category" Margin="0,0,0,5" FontSize="12" />
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Base Unit" Margin="0,0,0,5" FontSize="12" />
                            <ComboBox ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding SelectedBaseUnit}"
                                      IsEnabled="{Binding IsBaseUnitEditable}"
                                      Height="36" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tracking Mode" Margin="0,0,0,5" FontSize="12" />
                            <ComboBox ItemsSource="{Binding TrackingModes}"
                                      SelectedItem="{Binding SelectedTrackingMode}"
                                      Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,7">
                            <CheckBox Content="Serial tracking"
                                      IsChecked="{Binding SerialTrackingEnabled}"
                                      IsEnabled="{Binding IsSerialized}"
                                      Margin="0,0,20,0" />
                            <CheckBox Content="IMEI tracking"
                                      IsChecked="{Binding ImeiTrackingEnabled}"
                                      IsEnabled="{Binding IsSerialized}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Reference Purchase Cost" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding ReferencePurchaseCostText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Default Sale Price" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Minimum Stock" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default Warranty (months)" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding WarrantyMonthsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Attributes Schema Version" Margin="0,0,0,5" FontSize="12" />
                            <TextBox Text="{Binding AttributesSchemaVersionText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input.TextBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Catalog Attributes JSON" Margin="0,14,0,5" FontSize="12" />
                    <TextBox Text="{Binding AttributesJson, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource Input.TextBox}"
                             Height="72"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="Product Units"
                               Margin="0,18,0,8"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding UnitConfigurations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="175" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="105" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsEnabled}" />
                                    <TextBox Grid.Column="1" Text="{Binding FactorText, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" />
                                    <CheckBox Grid.Column="2" Content="Purchase" IsChecked="{Binding CanPurchase}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="3" Content="Sell" IsChecked="{Binding CanSell}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="4" Content="Thaka" IsChecked="{Binding CanUseInThaka}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="5" Content="Default buy" IsChecked="{Binding IsDefaultPurchaseUnit}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Column="6" Content="Default sale" IsChecked="{Binding IsDefaultSaleUnit}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Supplier Links"
                               Margin="0,18,0,8"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding SupplierLinks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsLinked}"
                                          Margin="0,0,18,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,14,0,0"
                            Padding="10"
                            BorderBrush="{DynamicResource Brush.Status.Danger}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>

                    <TextBlock Margin="0,14,0,0"
                               Text="Current stock, inventory value, lots and exact physical-unit state are not editable here."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource Button.Neutral}"
                        HorizontalAlignment="Left" />
                <Button Content="Save Product"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Border>
</UserControl>

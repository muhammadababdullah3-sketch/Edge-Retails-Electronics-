+
+        await using (var scope = provider.CreateAsyncScope())
+        {
+            var result = await scope.ServiceProvider.GetRequiredService<CreatePurchaseHandler>().HandleAsync(purchaseCommand, default);
+            Assert.False(result.IsSuccess);

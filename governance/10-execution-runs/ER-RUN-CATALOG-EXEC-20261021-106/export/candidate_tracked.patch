+            ["existing_primary_keys_preserved"] = true,
+            ["existing_foreign_keys_preserved"] = true,
+            ["zero_destructive_deletes"] = true,
+            ["zero_product_cloning"] = true,
+            ["append_only_pack_subledger_unaffected"] = true,

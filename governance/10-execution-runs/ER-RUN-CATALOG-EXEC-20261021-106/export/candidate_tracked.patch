++                SELECT 1 FROM inventory.movements WHERE occurred_at >= @start AND occurred_at < @end AND recognized_loss_amount > 0
++                UNION ALL
++                SELECT 1 FROM finance.expenses WHERE expense_date = @candidateDate
++                LIMIT 1;";

+
+            var mismatchRes = await handler.HandleAsync(nonMatchingSaleItemCmd, default);
+            Assert.False(mismatchRes.IsSuccess);
+            Assert.Equal("idempotency.payload_mismatch", mismatchRes.Error?.Code);
+        }
+    }

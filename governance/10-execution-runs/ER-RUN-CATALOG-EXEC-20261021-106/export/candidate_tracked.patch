+        decimal price = 300m,
+        decimal stock = 20m)
+    {
+        var unit = new Unit { Id = Guid.CreateVersion7(), Name = "Piece", Symbol = "pc" };
+        var product = new Product
+        {
+            Id = Guid.CreateVersion7(),
+            Name = "Test Product " + sku,

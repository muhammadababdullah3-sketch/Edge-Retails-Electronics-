+
+            if (request.Method == HttpMethod.Get && request.RequestUri!.AbsolutePath.StartsWith("/api/system/operations/"))
+            {
+                statusQueryCount++;
+                return JsonResponse(new
+                {
+                    OperationId = Guid.NewGuid(),
+                    WasCommitted = true,
+                    DocumentNumber = "CH-RECOVERED"

+            IsWalkIn = false,
+            IsActive = true,
+            CreatedAt = DateTimeOffset.UtcNow
+        });
+
+        // Project 1: Lifecycle sequence: issue 100 / pay 100 / return 100 / refund 100 / issue 50 => due 50
+        var project1Id = Guid.NewGuid();
+        db.ThakaProjects.Add(new ThakaProject

+        var now = DateTimeOffset.UtcNow;
+
+        // Generate 15-digit Luhn IMEI with unique random prefix to avoid collision across test runs
+        var random13 = "86" + Random.Shared.NextInt64(100000000000, 999999999999).ToString()[..12];
+        var validImei = "";
+        for (int d = 0; d <= 9; d++)
+        {
+            var test = random13 + d;

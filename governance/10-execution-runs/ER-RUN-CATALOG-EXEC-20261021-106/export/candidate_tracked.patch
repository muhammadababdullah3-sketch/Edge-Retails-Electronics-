+        }
+        catch (Exception ex)
+        {
+            var err = DesktopErrorPresentation.ForException(ex, "Credit refund failed.");
+            RefundErrorMessage = err;
+            _toastService?.Show(err, ToastTone.Danger);
+        }
+        finally
+        {
+            IsRefundingCredit = false;
+        }
+    }

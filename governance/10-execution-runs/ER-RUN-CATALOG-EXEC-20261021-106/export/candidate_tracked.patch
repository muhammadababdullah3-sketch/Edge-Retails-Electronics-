++        int pageSize,
++        CancellationToken cancellationToken)
++    {
++        pageNumber = Math.Max(1, pageNumber);
++        var take = Math.Clamp(pageSize <= 0 ? 50 : pageSize, 1, 100);
++        var skip = (pageNumber - 1) * take;
++
++        string? resolvedAlias = null;
++        string? aliasDepartment = null;
++
++        var term = query?.Trim();

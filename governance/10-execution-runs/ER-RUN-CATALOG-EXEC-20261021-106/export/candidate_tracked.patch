+        <DockPanel>
+            <!-- Header -->
+            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
+                <Grid>
+                    <StackPanel>
+                        <TextBlock Text="Cable Cutting &amp; Continuous Measurement" FontSize="20" FontWeight="Bold"
+                                   Foreground="{DynamicResource Brush.Text.Primary}" />

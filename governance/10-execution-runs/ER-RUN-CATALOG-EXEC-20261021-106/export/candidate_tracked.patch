@@ -0,0 +1,103 @@
+<UserControl x:Class="EdgeRetails.Desktop.Views.Dialogs.SupervisorApprovalModalDialog"
+             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
+             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+             Foreground="{DynamicResource Brush.Text.Primary}">
+    <Border Width="520" Padding="24" Style="{StaticResource Card.Raised}">
+        <StackPanel>
+            <!-- Header -->
+            <Grid>
+                <StackPanel>
+                    <TextBlock Text="Supervisor Authorization Required" FontSize="20" FontWeight="Bold"
+                               Foreground="{DynamicResource Brush.Text.Primary}" />
+                    <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource Brush.Text.Muted}">
+                        <Run Text="Operation: "/>
+                        <Run Text="{Binding OperationType, Mode=OneWay}" FontWeight="SemiBold"/>
+                        <Run Text=" · Backdated "/>
+                        <Run Text="{Binding BackdateDays, Mode=OneWay}" FontWeight="Bold"/>
+                        <Run Text=" days"/>
+                    </TextBlock>
+                </StackPanel>
+                <Button HorizontalAlignment="Right" Command="{Binding CancelCommand}"
+                        Style="{StaticResource Button.Close}"
+                        IsCancel="True" />
+            </Grid>
+
+            <!-- Locked Accounting Period / Hard Error Banner -->
+            <Border x:Name="LockedPeriodBannerBorder"
+                    Margin="0,14,0,0" Padding="12"
+                    Background="{DynamicResource Brush.Selection.Subtle}"
+                    BorderBrush="{DynamicResource Brush.Status.Danger}"
+                    BorderThickness="1" CornerRadius="6">
+                <TextBlock x:Name="LockedPeriodBannerText"
+                           Text="{Binding LockedPeriodBanner}"
+                           Foreground="{DynamicResource Brush.Status.Danger}"
+                           FontWeight="Bold" FontSize="12" TextWrapping="Wrap" />
+            </Border>
+
+            <!-- Posting Date and Shop Date Details -->
+            <Grid Margin="0,14,0,0">
+                <Grid.ColumnDefinitions>
+                    <ColumnDefinition Width="*" />
+                    <ColumnDefinition Width="*" />
+                </Grid.ColumnDefinitions>
+                <StackPanel Grid.Column="0">
+                    <TextBlock Text="Posting Date" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" />
+                    <TextBlock Text="{Binding PostingDate, StringFormat=yyyy-MM-dd}" FontSize="14" FontWeight="SemiBold"
+                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
+                </StackPanel>
+                <StackPanel Grid.Column="1">
+                    <TextBlock Text="Authoritative Shop Date" FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" />
+                    <TextBlock Text="{Binding ShopDate, StringFormat=yyyy-MM-dd}" FontSize="14" FontWeight="SemiBold"
+                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
+                </StackPanel>
+            </Grid>
+
+            <!-- Supervisor Selection -->
+            <StackPanel Margin="0,14,0,0">
+                <TextBlock Text="Authorizing Supervisor" FontSize="12" FontWeight="SemiBold"
+                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
+                <ComboBox x:Name="SupervisorComboBox"
+                          ItemsSource="{Binding Supervisors}"
+                          SelectedItem="{Binding SelectedSupervisor, Mode=TwoWay}"
+                          DisplayMemberPath="DisplayName"
+                          Style="{StaticResource Input.ComboBox}" />
+            </StackPanel>
+
+            <!-- Supervisor PIN Entry (Masked via PasswordBox) -->
+            <StackPanel Margin="0,12,0,0">
+                <TextBlock Text="Supervisor PIN (Server-Verified)" FontSize="12" FontWeight="SemiBold"
+                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
+                <PasswordBox x:Name="SupervisorPinBox"
+                             PasswordChanged="OnSupervisorPinChanged"
+                             Style="{StaticResource Input.PasswordBox}"
+                             MaxLength="10" />
+            </StackPanel>
+
+            <!-- Reason -->
+            <StackPanel Margin="0,12,0,0">
+                <TextBlock Text="Authorization Reason" FontSize="12" FontWeight="SemiBold"
+                           Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,6" />
+                <TextBox x:Name="ReasonBox"
+                         Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
+                         Style="{StaticResource Input.TextBox}" />
+            </StackPanel>
+
+            <!-- Error message -->
+            <TextBlock x:Name="ErrorMessageText"
+                       Text="{Binding ErrorMessage}" Margin="0,10,0,0"
+                       Foreground="{DynamicResource Brush.Status.Danger}"
+                       FontSize="12" TextWrapping="Wrap" />
+
+            <!-- Actions -->
+            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
+                <Button Content="Cancel" Command="{Binding CancelCommand}"
+                        Style="{StaticResource Button.Neutral}"
+                        IsCancel="True" Margin="0,0,8,0" />
+                <Button x:Name="SubmitButton"
+                        Content="Authorize &amp; Post" Command="{Binding SubmitCommand}"
+                        Style="{StaticResource Button.Primary}"
+                        IsDefault="True" />
+            </StackPanel>
+        </StackPanel>
+    </Border>
+</UserControl>
diff --git a/src/EdgeRetails.Desktop/Views/Dialogs/SupervisorApprovalModalDialog.xaml.cs b/src/EdgeRetails.Desktop/Views/Dialogs/SupervisorApprovalModalDialog.xaml.cs
new file mode 100644
index 0000000..75cb04c
--- /dev/null
+++ b/src/EdgeRetails.Desktop/Views/Dialogs/SupervisorApprovalModalDialog.xaml.cs
@@ -0,0 +1,62 @@
+using System.ComponentModel;
+using System.Windows;
+using System.Windows.Controls;
+using EdgeRetails.Desktop.ViewModels;
+
+namespace EdgeRetails.Desktop.Views.Dialogs;
+
+public partial class SupervisorApprovalModalDialog : UserControl
+{
+    private SupervisorApprovalModalViewModel? _viewModel;
+
+    public SupervisorApprovalModalDialog()
+    {
+        InitializeComponent();
+        DataContextChanged += OnDataContextChanged;
+        Unloaded += OnUnloaded;
+    }
+
+    private void OnDataContextChanged(object sender, DependencyPropertyChangedEventArgs e)
+    {
+        if (_viewModel is not null)
+        {
+            _viewModel.PropertyChanged -= OnViewModelPropertyChanged;
+        }
+
+        _viewModel = e.NewValue as SupervisorApprovalModalViewModel;
+        SupervisorPinBox.Clear();
+
+        if (_viewModel is not null)
+        {
+            _viewModel.PropertyChanged += OnViewModelPropertyChanged;
+        }
+    }
+
+    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
+    {
+        if (e.PropertyName == nameof(SupervisorApprovalModalViewModel.SupervisorPin) &&
+            string.IsNullOrEmpty(_viewModel?.SupervisorPin))
+        {
+            SupervisorPinBox.Clear();
+        }
+    }
+
+    private void OnSupervisorPinChanged(object sender, RoutedEventArgs e)
+    {
+        if (DataContext is SupervisorApprovalModalViewModel viewModel &&
+            sender is PasswordBox passwordBox)
+        {
+            viewModel.SupervisorPin = passwordBox.Password;
+        }
+    }
+
+    private void OnUnloaded(object sender, RoutedEventArgs e)
+    {
+        if (_viewModel is not null)
+        {
+            _viewModel.ClearSecret();
+            _viewModel.PropertyChanged -= OnViewModelPropertyChanged;
+        }
+        SupervisorPinBox.Clear();
+    }
+}

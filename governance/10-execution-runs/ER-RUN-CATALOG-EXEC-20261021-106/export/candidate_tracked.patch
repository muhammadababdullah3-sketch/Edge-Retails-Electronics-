+        continue
+
+    h = hashlib.sha256()
+    with open(full_path, "rb") as f:
+        while chunk := f.read(65536):
+            h.update(chunk)
+    actual_sha = h.hexdigest().lower()
+
+    if actual_sha != expected_sha:
+        mismatches.append(f"{rel_path}: SHA256 mismatch (expected {expected_sha}, got {actual_sha})")
+    else:

+        var result = DesktopOperationRejectionClassifier.IsAuthoritativeDeterministicBusinessRejection(ex);
+        Assert.False(result, $"Expected code '{code}' to preserve intent (not deterministic rejection).");
+    }
+
+    [Theory]

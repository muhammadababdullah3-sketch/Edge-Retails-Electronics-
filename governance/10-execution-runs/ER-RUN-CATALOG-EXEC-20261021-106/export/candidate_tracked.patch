+            SessionId: null,
+            InvoiceDiscount: 0m,
+            PaymentMethod: SalePaymentMethod.Cash,
+            AmountTendered: 100m, // Cart Total = (4m * 50) + (2m * 25) = 250m. Tendered 100m < 250m triggers sales.cash_insufficient!
+            PaymentReference: null,
+            QuotationId: null,

+                    payment?.ChangeGiven ?? 0m,
+                    WasExisting: true));
+            }
+
+            return Result<CommercialExchangeResult>.Failure(
+                "idempotency.outcome_unknown",
+                "Committed exchange outcome has no matching entities; reconciliation is required.");
+        }

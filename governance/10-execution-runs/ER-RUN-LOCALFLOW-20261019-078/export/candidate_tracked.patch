+    public bool BoolValue
+    {
+        get => _boolValue;
+        set
+        {
+            if (SetProperty(ref _boolValue, value))
+            {
+                CurrentValue = value ? "true" : "false";
+            }
+        }
+    }
+
+    public string? ValidationError
+    {
+        get => _validationError;
+        private set

+    private static async Task<decimal[]> SumIntoTrendSlicesAsync<T>(
+        IQueryable<T> query,
+        Func<T, DateTimeOffset> timestamp,
+        Func<T, decimal> amount,
+        IReadOnlyList<(DateTimeOffset Start, DateTimeOffset End, string Label)> slices,
+        CancellationToken cancellationToken)
+    {
+        var totals = new decimal[slices.Count];
+        await foreach (var entry in query.AsAsyncEnumerable().WithCancellation(cancellationToken))
+        {
+            var occurredAt = timestamp(entry);
+            var low = 0;
+            var high = slices.Count - 1;
+            var matched = false;
+            while (low <= high)
+            {
+                var middle = low + ((high - low) / 2);
+                var slice = slices[middle];
+                if (occurredAt < slice.Start)
+                {
+                    high = middle - 1;
+                }
+                else if (occurredAt >= slice.End)
+                {
+                    low = middle + 1;
+                }
+                else
+                {
+                    totals[middle] += amount(entry);
+                    matched = true;
+                    break;
+                }
+            }
+
+            if (!matched)
+            {
+                throw new InvalidOperationException(
+                    $"Trend event at {occurredAt:O} is outside the configured shop-time slices.");
+            }
+        }
+
+        return totals;
+    }

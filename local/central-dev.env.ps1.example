# Copy to local/central-dev.env.ps1 (gitignored). Fill values from live PG attestation — never commit secrets.
# See docs/central/OPERATIONS_AND_RUNBOOK.md for workflow; names only here.

# Owned PostgreSQL 18 (loopback, non-5432 port)
$env:CENTRAL_DATABASE_CONNECTION_STRING = 'Host=127.0.0.1;Port=YOUR_PORT;Database=YOUR_DB;Username=YOUR_RUNTIME_ROLE;Password=YOUR_PASSWORD'
$env:CENTRAL_PG_PORT = 'YOUR_PORT'
$env:CENTRAL_PG_DATABASE = 'YOUR_DB'
$env:CENTRAL_PG_ROLE = 'YOUR_RUNTIME_ROLE'
$env:CENTRAL_PG_MIGRATION_ROLE = 'YOUR_MIGRATION_ROLE'
$env:CENTRAL_PG_PID = 'YOUR_POSTMASTER_PID'
$env:CENTRAL_PG_BINARY = 'C:\path\to\postgresql18\bin\postgres.exe'
$env:CENTRAL_PG_OWNERSHIP_MARKER = 'C:\path\to\ownership-marker.json'
$env:CENTRAL_PG_DATA_DIR = 'C:\path\to\pgdata'

# Signer and disk roots (separate directories)
$env:CENTRAL_SIGNER_KEY_STORE_ROOT = 'C:\path\to\central-signer-keys'
$env:CENTRAL_OBJECT_STORAGE_ROOT = 'C:\path\to\central-objects'
$env:CENTRAL_PAYMENT_STORAGE_ROOT = 'C:\path\to\central-payments'

# Admin auth lifetimes (seconds) — set per approved policy, not copied from test fixtures blindly
$env:CENTRAL_ADMIN_AUTH_CHALLENGE_TTL_SECONDS = '300'
$env:CENTRAL_ADMIN_AUTH_SESSION_IDLE_TIMEOUT_SECONDS = '900'
$env:CENTRAL_ADMIN_AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS = '28800'
$env:CENTRAL_ADMIN_STEP_UP_TTL_SECONDS = '300'

# Login rate limit (required for POST login/MFA)
$env:CENTRAL_AUTH_RATE_LIMIT_MAX_ATTEMPTS = '5'
$env:CENTRAL_AUTH_RATE_LIMIT_WINDOW_SECONDS = '60'

# Labelled local-dev fixtures (adjust per runbook / policy gates you enable)
$env:CENTRAL_SENSITIVE_APPROVAL_TTL_SECONDS = '3600'
$env:CENTRAL_DUAL_APPROVAL_ACTIONS = 'NONE'
$env:CENTRAL_INSTALLATION_PROOF_WINDOW_SECONDS = '120'
$env:CENTRAL_BOOTSTRAP_CHALLENGE_TTL_SECONDS = '300'
$env:CENTRAL_INTERNAL_SIGNER_TOKEN = 'set-in-secret-store-only'

# Optional hosted workers (set full tuple or leave disabled — outbox enqueue needs enabled outbox)
# $env:CENTRAL_OUTBOX_ENABLED = 'true'
# ... remaining CENTRAL_OUTBOX_* per CentralOutboxHostedService.FromEnvironment

$env:ASPNETCORE_URLS = 'https://localhost:5001'

# Copy to local/central-dev.env (gitignored). Dotenv format; loaded automatically when ASPNETCORE_ENVIRONMENT=Development.
# Do not commit secrets. Attest PostgreSQL ownership values before each run.

CENTRAL_DATABASE_CONNECTION_STRING=Host=127.0.0.1;Port=YOUR_PORT;Database=YOUR_DB;Username=YOUR_RUNTIME_ROLE;Password=YOUR_PASSWORD
CENTRAL_PG_PORT=YOUR_PORT
CENTRAL_PG_DATABASE=YOUR_DB
CENTRAL_PG_ROLE=YOUR_RUNTIME_ROLE
CENTRAL_PG_MIGRATION_ROLE=YOUR_MIGRATION_ROLE
CENTRAL_PG_PID=YOUR_POSTMASTER_PID
CENTRAL_PG_BINARY=C:\path\to\postgresql18\bin\postgres.exe
CENTRAL_PG_OWNERSHIP_MARKER=C:\path\to\ownership-marker.json
CENTRAL_PG_DATA_DIR=C:\path\to\pgdata

CENTRAL_SIGNER_KEY_STORE_ROOT=C:\path\to\central-signer-keys
CENTRAL_OBJECT_STORAGE_ROOT=C:\path\to\central-objects
CENTRAL_PAYMENT_STORAGE_ROOT=C:\path\to\central-payments

CENTRAL_ADMIN_AUTH_CHALLENGE_TTL_SECONDS=300
CENTRAL_ADMIN_AUTH_SESSION_IDLE_TIMEOUT_SECONDS=900
CENTRAL_ADMIN_AUTH_SESSION_ABSOLUTE_LIFETIME_SECONDS=28800
CENTRAL_ADMIN_STEP_UP_TTL_SECONDS=300

CENTRAL_AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
CENTRAL_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

CENTRAL_SENSITIVE_APPROVAL_TTL_SECONDS=3600
CENTRAL_DUAL_APPROVAL_ACTIONS=NONE
CENTRAL_INSTALLATION_PROOF_WINDOW_SECONDS=120
CENTRAL_BOOTSTRAP_CHALLENGE_TTL_SECONDS=300
CENTRAL_INTERNAL_SIGNER_TOKEN=set-in-secret-store-only

ASPNETCORE_URLS=https://localhost:5001

# Local portal sign-in (disposable dev only). sync-portal-admin writes local/central-dev.portal.json.
CENTRAL_DEV_PORTAL_USERNAME=central-dev@edgeretails.local
CENTRAL_DEV_PORTAL_PASSWORD=CentralDevPortal!2026

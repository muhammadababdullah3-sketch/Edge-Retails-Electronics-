<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>EdgeRetailsSetup</OutputName>
    <Platform>x64</Platform>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiPath=$(MsiPath);AppIconPath=$(AppIconPath)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>

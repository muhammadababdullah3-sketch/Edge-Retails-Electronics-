<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Edge Retails"
           Manufacturer="Edge Retails"
           Version="$(var.ProductVersion)"
           Scope="perMachine"
           UpgradeCode="D7F563E6-18A9-4AB8-938D-C70D9A1972E9">
    <!-- Explicit upgrade behavior. Only application binaries under Program Files are MSI-owned. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Edge Retails is already installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="EdgeRetail.ico" SourceFile="$(var.AppIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="EdgeRetail.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Edge Retails" />
    </StandardDirectory>

    <!-- Database files stay out of this package. Launch choices are applied after the files are copied. -->
    <Feature Id="Main">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**" />
      <ComponentRef Id="ClientSetupScript" />
    </Feature>
  </Package>
</Wix>
